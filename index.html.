function togglePanel(id) {
  const el = document.getElementById(id);
  if (!el) {
    console.error('[togglePanel] Panel tidak ditemukan:', id);
    return;
  }
  if (el.classList.contains('vis')) {
    closeAllPanels();
  } else {
    closeAllPanels();
    el.classList.add('vis');
    state.panelOpen = id;
    if (id === 'pnl-inv') refreshInventory();
    if (id === 'pnl-upgrade') refreshUpgradePanel();
    if (id === 'pnl-skin') refreshSkinPanel();
  }
}

