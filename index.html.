  colliders.push({ x: cfg.x, z: cfg.z, radius: sz / 2 + 0.3 });
}
const COOP_FLOOR_Y = 1.21 * 1.35;
const COOP_GLB_GZIP_B64 = '';

function buildChickenCoop(cfg, label) {
  const coopGroup = new THREE.Group();
  // Pertahankan posisi kandang ayam tepat di cfg (CONFIG.chickenPenPos) sebagai poros rotasi (pivot point)
  // dan putar arah hadap depan kandang (+Z lokal) sebesar +90° (Math.PI / 2) agar menghadap lurus ke samping rumah petani (+X).
  coopGroup.position.set(cfg.x, 0, cfg.z);
  coopGroup.rotation.y = CHICKEN_COOP_ROT_Y;
  scene.add(coopGroup);

  const S = 1.35;

  // Ground dirt pad beneath the chicken coop and side shed
  const coopFloor = new THREE.Mesh(
    new THREE.PlaneGeometry(8.5, 8.2),
    new THREE.MeshStandardMaterial({ color: 0x8B6946, roughness: 0.98 })
  );
  coopFloor.rotation.x = -Math.PI / 2;
  coopFloor.position.set(-0.9, 0.012, 0.4);
  coopFloor.receiveShadow = true;
  coopFloor.frustumCulled = false;
  coopGroup.add(coopFloor);

  let coopRoofObj = null;

  function parseAndMountCoopGLB(arrayBuffer) {
    const dv = new DataView(arrayBuffer);
    const magic = dv.getUint32(0, true);
    if (magic !== 0x46546C67) throw new Error('Invalid GLB file');
    const jsonLen = dv.getUint32(12, true);
    const jsonBytes = new Uint8Array(arrayBuffer, 20, jsonLen);
    const gltf = JSON.parse(new TextDecoder().decode(jsonBytes));
    const binOffset = 20 + jsonLen + 8;

    const compTypes = {
      5120: Int8Array,
      5121: Uint8Array,
      5122: Int16Array,
      5123: Uint16Array,
      5125: Uint32Array,
      5126: Float32Array
    };
    const numComps = { SCALAR: 1, VEC2: 2, VEC3: 3, VEC4: 4 };

    function getAccessorData(accIdx) {
      const acc = gltf.accessors[accIdx];
      const bv = gltf.bufferViews[acc.bufferView];
      const TypedArr = compTypes[acc.componentType];
      const nComp = numComps[acc.type] || 1;
      const byteOffset = binOffset + (bv.byteOffset || 0) + (acc.byteOffset || 0);
      const count = acc.count * nComp;
      const stride = bv.byteStride || 0;
      if (stride && stride !== nComp * TypedArr.BYTES_PER_ELEMENT) {
        const out = new TypedArr(count);
        const elemSize = TypedArr.BYTES_PER_ELEMENT;
        const dvSlice = new DataView(arrayBuffer, binOffset + (bv.byteOffset || 0), bv.byteLength);
        for (let i = 0; i < acc.count; i++) {
          const base = i * stride + (acc.byteOffset || 0);
          for (let c = 0; c < nComp; c++) {
            if (acc.componentType === 5126) out[i * nComp + c] = dvSlice.getFloat32(base + c * elemSize, true);
            else if (acc.componentType === 5123) out[i * nComp + c] = dvSlice.getUint16(base + c * elemSize, true);
            else if (acc.componentType === 5125) out[i * nComp + c] = dvSlice.getUint32(base + c * elemSize, true);
          }
        }
        return { array: out, itemSize: nComp };
      }
      return { array: new TypedArr(arrayBuffer, byteOffset, count), itemSize: nComp };
    }

    const materials = (gltf.materials || []).map(m => {
      const pbr = m.pbrMetallicRoughness || {};
      const bf = pbr.baseColorFactor || [0.8, 0.8, 0.8, 1];
      const col = new THREE.Color(bf[0], bf[1], bf[2]).convertLinearToSRGB();
      return new THREE.MeshStandardMaterial({
        name: m.name || '',
        color: col,
        metalness: pbr.metallicFactor !== undefined ? pbr.metallicFactor : 0.0,
        roughness: pbr.roughnessFactor !== undefined ? pbr.roughnessFactor : 0.8,
        side: m.doubleSided ? THREE.DoubleSide : THREE.FrontSide
      });
    });

    function buildNode(nodeIdx) {
      const nDef = gltf.nodes[nodeIdx];
      const obj = new THREE.Group();
      obj.name = nDef.name || `node_${nodeIdx}`;
      if (nDef.translation) obj.position.fromArray(nDef.translation);
      if (nDef.rotation) obj.quaternion.fromArray(nDef.rotation);
      if (nDef.scale) obj.scale.fromArray(nDef.scale);

      if (nDef.mesh !== undefined) {
        const mDef = gltf.meshes[nDef.mesh];
        for (let pIdx = 0; pIdx < mDef.primitives.length; pIdx++) {
          const prim = mDef.primitives[pIdx];
          // Skip solid interior dark core (prim 2) and doorway dark blocker (prim 3) in dinding_mesh
          // so the elevated chicken coop room and doorway are hollow and walk-in accessible
          if (mDef.name === 'dinding_mesh' && (pIdx === 2 || pIdx === 3)) {
            continue;
          }
          const geom = new THREE.BufferGeometry();
          if (prim.attributes.POSITION !== undefined) {
            const pos = getAccessorData(prim.attributes.POSITION);
            geom.setAttribute('position', new THREE.BufferAttribute(pos.array, pos.itemSize));
          }
          if (prim.attributes.NORMAL !== undefined) {
            const norm = getAccessorData(prim.attributes.NORMAL);
            geom.setAttribute('normal', new THREE.BufferAttribute(norm.array, norm.itemSize));
          }
          if (prim.attributes.TEXCOORD_0 !== undefined) {
            const uv = getAccessorData(prim.attributes.TEXCOORD_0);
            geom.setAttribute('uv', new THREE.BufferAttribute(uv.array, uv.itemSize));
          }
          if (prim.indices !== undefined) {
            const idx = getAccessorData(prim.indices);
            geom.setIndex(new THREE.BufferAttribute(idx.array, 1));
          }
          if (!prim.attributes.NORMAL) geom.computeVertexNormals();

          const mat = materials[prim.material] || new THREE.MeshStandardMaterial({ color: 0x8D6E63 });
          const mesh = new THREE.Mesh(geom, mat);
          mesh.castShadow = true;
          mesh.receiveShadow = true;
          obj.add(mesh);
        }
      }

      if (nDef.children) {
        for (const cIdx of nDef.children) {
          obj.add(buildNode(cIdx));
        }
      }
      return obj;
    }

    const sceneDef = gltf.scenes[gltf.scene || 0];
    const coopModel = new THREE.Group();
    for (const rootIdx of sceneDef.nodes) {
      coopModel.add(buildNode(rootIdx));
    }

    // Swing both front coop doors wide open so player can walk up the ramp and inside
    coopModel.traverse(child => {
      if (child.name === 'pintu_kiri') {
        child.rotation.y = -Math.PI * 0.65;
      } else if (child.name === 'pintu_kanan') {
        child.rotation.y = Math.PI * 0.65;
      } else if (child.name === 'atap') {
        coopRoofObj = child;
        child.traverse(c => {
          if (c.isMesh && c.material) {
            c.material = c.material.clone();
          }
        });
      }
    });

    // Add elevated wooden floor slab & interior plank surface for the hollow coop room
    const baseSlabMat = materials[2] || new THREE.MeshStandardMaterial({ color: 0x7A4924, roughness: 0.85 });
    const baseSlab = new THREE.Mesh(new THREE.BoxGeometry(3.34, 0.16, 3.14), baseSlabMat);
    baseSlab.position.set(0.85, 1.12, -0.15);
    baseSlab.castShadow = true;
    baseSlab.receiveShadow = true;
    coopModel.add(baseSlab);

    const innerFloorMat = new THREE.MeshStandardMaterial({ color: 0x9E7B56, roughness: 0.9 });
    const innerFloor = new THREE.Mesh(new THREE.PlaneGeometry(3.28, 3.08), innerFloorMat);
    innerFloor.rotation.x = -Math.PI / 2;
    innerFloor.position.set(0.85, 1.21, -0.15);
    innerFloor.receiveShadow = true;
    coopModel.add(innerFloor);

    // Thin dark wall liners along the inner faces of the coop walls (leaving doorway open)
    const linerMat = new THREE.MeshStandardMaterial({ color: 0x240B04, roughness: 0.95, side: THREE.DoubleSide });
    const addLiner = (w, h, d, lx, ly, lz) => {
      const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), linerMat);
      m.position.set(lx, ly, lz);
      coopModel.add(m);
    };
    // Back wall liner (z = -1.69)
    addLiner(3.30, 2.02, 0.02, 0.85, 2.21, -1.69);
    // Left wall liner (x = -0.79)
    addLiner(0.02, 2.02, 3.10, -0.79, 2.21, -0.15);
    // Right wall liner (x = 2.49)
    addLiner(0.02, 2.02, 3.10, 2.49, 2.21, -0.15);
    // Front wall liners left, right, and above doorway (doorway x in [0.10, 0.96], y in [1.20, 2.52])
    addLiner(0.90, 2.02, 0.02, -0.35, 2.21, 1.40);
    addLiner(1.54, 2.02, 0.02, 1.73, 2.21, 1.40);
    addLiner(0.86, 0.70, 0.02, 0.53, 2.87, 1.40);

    // Front & back upper gable triangles (y = 3.22 to 4.50)
    const addGableLiner = (lz) => {
      const g = new THREE.BufferGeometry();
      const v = new Float32Array([-0.80, 3.22, lz, 2.50, 3.22, lz, 0.85, 4.50, lz]);
      g.setAttribute('position', new THREE.BufferAttribute(v, 3));
      g.computeVertexNormals();
      coopModel.add(new THREE.Mesh(g, linerMat));
    };
    addGableLiner(-1.69);
    addGableLiner(1.40);

    // Small stack of hay bales inside the coop room (back-left corner on elevated floor)
    const hayMat = materials[5] || new THREE.MeshStandardMaterial({ color: 0xD89B28, roughness: 0.9 });
    const tieMat = materials[6] || new THREE.MeshStandardMaterial({ color: 0xA86E18, roughness: 0.85 });
    const addInteriorHayBale = (hx, hy, hz, ry) => {
      const bg = new THREE.Group();
      const bale = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.34, 0.38), hayMat);
      bale.castShadow = true;
      bale.receiveShadow = true;
      bg.add(bale);
      for (const ox of [-0.14, 0.14]) {
        const tie = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.355, 0.395), tieMat);
        tie.position.x = ox;
        bg.add(tie);
      }
      bg.position.set(hx, hy, hz);
      bg.rotation.y = ry;
      coopModel.add(bg);
    };
    addInteriorHayBale(-0.35, 1.38, -1.25, 0.12);
    addInteriorHayBale(0.24, 1.38, -1.30, -0.08);
    addInteriorHayBale(-0.06, 1.72, -1.27, 0.05);

    // Scale and center the main coop room at (cfg.x, cfg.z)
    coopModel.scale.set(S, S, S);
    coopModel.position.set(-0.85 * S, 0, 0.15 * S);
    coopGroup.add(coopModel);
  }

  async function loadCoopModel() {
    try {
      if (typeof COOP_GLB_GZIP_B64 === 'string' && COOP_GLB_GZIP_B64.length > 100 && typeof DecompressionStream !== 'undefined') {
        const binStr = atob(COOP_GLB_GZIP_B64);
        const compressed = new Uint8Array(binStr.length);
        for (let i = 0; i < binStr.length; i++) compressed[i] = binStr.charCodeAt(i);
        const ds = new DecompressionStream('gzip');
        const writer = ds.writable.getWriter();
        writer.write(compressed);
        writer.close();
        const arrayBuffer = await new Response(ds.readable).arrayBuffer();
        parseAndMountCoopGLB(arrayBuffer);
        return;
      }
    } catch (e) {
      console.warn('Fallback to fetch kandang_ayam.glb:', e);
    }
    fetch('./kandang_ayam.glb')
      .then(r => r.arrayBuffer())
      .then(buf => parseAndMountCoopGLB(buf))
      .catch(err => console.error('Gagal memuat kandang_ayam.glb:', err));
  }
  loadCoopModel();

  // Smoothly elevate player when walking up the ramp / inside the coop, and fade roof when inside (mengikuti rotasi kandang)
  coopFloor.onBeforeRender = () => {
    if (typeof playerGroup === 'undefined') return;
    const px = playerGroup.position.x;
    const pz = playerGroup.position.z;
    const { lx, lz } = worldToCoopLocal(px, pz, cfg, CHICKEN_COOP_ROT_Y);
    const insideCoop = Math.abs(lx) < 2.22 && Math.abs(lz) < 2.15;
    const onRamp = Math.abs(lx - (-0.43)) < 0.85 && lz >= 2.12 && lz <= 4.40;

    if (insideCoop) {
      playerGroup.position.y = COOP_FLOOR_Y;
    } else if (onRamp) {
      const t = 1 - (lz - 2.15) / 2.25;
      playerGroup.position.y = THREE.MathUtils.clamp(t, 0, 1) * COOP_FLOOR_Y;
    }

    if (coopRoofObj) {
      const targetOpacity = insideCoop ? 0.18 : 1.0;
      coopRoofObj.traverse(c => {
        if (c.isMesh && c.material) {
          const isTrans = targetOpacity < 0.99;
          if (c.material.transparent !== isTrans || Math.abs(c.material.opacity - targetOpacity) > 0.01) {
            c.material.transparent = isTrans;
            c.material.opacity = targetOpacity;
            c.material.depthWrite = !isTrans;
            c.material.needsUpdate = true;
          }
        }
      });
    }
  };

  // Warm interior light inside the elevated chicken coop room
  const coopLight = new THREE.PointLight(0xFFE4B5, 1.0, 9);
  coopLight.position.set(0, 3.6, 0);
  coopGroup.add(coopLight);

  // "Kandang Ayam" signpost outside front-right of the coop
  const postMat = new THREE.MeshStandardMaterial({ color: 0x8B4513, roughness: 0.85 });
  const signPost = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 1.5, 6), postMat);
  signPost.position.set(2.35, 0.75, 2.65);
  signPost.castShadow = true;
  coopGroup.add(signPost);
  const sTex = textTex(label, '#5D4037', '#FFF');
  const sMat = new THREE.MeshStandardMaterial({ map: sTex, transparent: true, side: THREE.DoubleSide });
  const signMesh = new THREE.Mesh(new THREE.PlaneGeometry(1.9, 0.44), sMat);
  signMesh.position.set(2.35, 1.55, 2.65);
  coopGroup.add(signMesh);

  // Wall colliders around the perimeter of the chicken coop & side shed, rotated around cfg by CHICKEN_COOP_ROT_Y
  const wallColliders = [
    // Back wall (dz = -2.11)
    [-2.20, -2.11], [-1.45, -2.11], [-0.70, -2.11], [0.0, -2.11], [0.70, -2.11], [1.45, -2.11], [2.20, -2.11],
    // Left wall (dx = -2.24)
    [-2.24, -1.50], [-2.24, -0.75], [-2.24, 0.0], [-2.24, 0.75], [-2.24, 1.50], [-2.24, 2.11],
    // Right wall (dx = 2.24)
    [2.24, -1.50], [2.24, -0.75], [2.24, 0.0], [2.24, 0.75], [2.24, 1.50], [2.24, 2.11],
    // Front wall left of doorway & ramp (dz = 2.16)
    [-2.20, 2.16], [-1.72, 2.16], [-1.28, 2.16],
    // Front wall right of doorway & ramp (dz = 2.16)
    [0.42, 2.16], [0.95, 2.16], [1.55, 2.16], [2.15, 2.16],
    // Side lean-to shed outer boundary
    [-4.55, -1.80], [-4.55, -0.40], [-4.55, 0.90], [-3.40, -1.90]
  ];
  for (const [dx, dz] of wallColliders) {
    const rotOff = rotateCoopLocalOffset(dx, dz, CHICKEN_COOP_ROT_Y);
    colliders.push({ x: cfg.x + rotOff.x, z: cfg.z + rotOff.z, radius: 0.28 });
  }
}
