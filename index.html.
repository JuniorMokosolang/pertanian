function updateMobileJoystickFromPoint(cx, cy) {
  let dx = cx - mobileInput.joyCenterX;
  let dy = cy - mobileInput.joyCenterY;
  const rawDist = Math.hypot(dx, dy);
  const maxR = mobileInput.joyMaxRadius || 42;
  if (rawDist > maxR && rawDist > 0.0001) {
    const s = maxR / rawDist;
    dx *= s;
    dy *= s;
  }
  if (joyStickEl) {
    joyStickEl.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
  }
  const normDist = Math.min(1, rawDist / maxR);
  if (normDist < 0.10) {
    mobileInput.moveX = 0;
    mobileInput.moveY = 0;
    mobileInput.strength = 0;
  } else {
    const scaled = (normDist - 0.10) / 0.90;
    const angle = Math.atan2(dy, dx);
    mobileInput.moveX = Math.cos(angle) * scaled;
    mobileInput.moveY = Math.sin(angle) * scaled;
    mobileInput.strength = normDist;
  }
}

if (joyZoneEl && joyBaseEl) {
  joyZoneEl.addEventListener('touchstart', e => {
    e.preventDefault();
    e.stopPropagation();
    if (!isTouchDevice) {
