// Kamera 3D Sinematik Main Menu (Slow Panning / Orbiting mengelilingi Rumah Petani, Lahan Tanaman, Kandang Ayam & Kandang Sapi)
function updateCinematicMenuCamera(dt) {
  mainMenuState.orbitTime += dt;
  const t = mainMenuState.orbitTime;

  // Sesuaikan jarak mundur kamera sedikit pada layar HP Portrait / Landscape agar panorama kebun tidak terlihat terlalu dekat/ke-zoom
  const w = window.innerWidth || 1024;
  const h = window.innerHeight || 768;
  const aspect = w / Math.max(1, h);
  const isMobileScreen = w <= 950 || h <= 520;
  const mobileDistFactor = isMobileScreen ? (aspect < 1.0 ? 1.18 : 1.08) : 1.0;

  // Jalur spline melingkar halus yang menampilkan seluruh area utama peternakan
  const angle = t * 0.16 - 0.6;
  const radiusX = 16.5 * mobileDistFactor;
  const radiusZ = 14.5 * mobileDistFactor;
  const centerX = -1.5;
  const centerZ = 2.0;

  const camX = centerX + Math.cos(angle) * radiusX + Math.sin(angle * 2.0) * 2.5;
  const camZ = centerZ + Math.sin(angle) * radiusZ;
  const camY = (6.2 + Math.sin(angle * 1.5) * 1.4) * (isMobileScreen ? 1.06 : 1.0);

  // Titik fokus pandangan kamera bergerak lembut menyapu Rumah, Kebun Tanaman, Sumur, Kandang Ayam & Kandang Sapi
  const lookX = -2.2 + Math.cos(angle + 0.75) * 6.5;
  const lookZ = 0.8 + Math.sin(angle + 0.75) * 5.8;
  const lookY = 1.5 + Math.sin(angle * 0.9) * 0.35;

  mainMenuState.camPos.set(camX, camY, camZ);
  mainMenuState.lookTarget.set(lookX, lookY, lookZ);

  if (!mainMenuState.isTransitioning) {
    camera.position.copy(mainMenuState.camPos);
    camera.lookAt(mainMenuState.lookTarget);
  } else {
    mainMenuState.transitionTimer += dt;
    const rawP = Math.min(1.0, mainMenuState.transitionTimer / mainMenuState.transitionDuration);
    const easeP = rawP < 0.5 ? 4 * rawP * rawP * rawP : 1 - Math.pow(-2 * rawP + 2, 3) / 2;

    // Hitung posisi kamera gameplay di belakang karakter pemain
    const oX = Math.sin(cam.yaw) * Math.cos(cam.pitch) * cam.dist;
    const oY = Math.sin(cam.pitch) * cam.dist;
    const oZ = Math.cos(cam.yaw) * Math.cos(cam.pitch) * cam.dist;
    const pp = playerGroup.position;
    const targetGameplayCamPos = _v3a.set(pp.x + oX, Math.max(0.4, pp.y + 1.3 + oY), pp.z + oZ);
    const targetGameplayLook = _v3b.set(pp.x, pp.y + 1.2, pp.z);

    camera.position.lerpVectors(mainMenuState.startTransCamPos, targetGameplayCamPos, easeP);
    mainMenuState.lookTarget.lerpVectors(mainMenuState.startTransLookTarget, targetGameplayLook, easeP);
    camera.lookAt(mainMenuState.lookTarget);

    if (rawP >= 1.0) {
      mainMenuState.active = false;
      mainMenuState.isTransitioning = false;
      state.inLobby = false;
      if (mainMenuOverlayEl) {
        mainMenuOverlayEl.classList.add('hidden');
      }
      document.body.classList.remove('lobby-active');
      updateDayNightCycle(0, true);
      updateTouchHUDVisibility();
      refreshHUD();
      refreshHotbar();
    }
  }
}

