// Pembuat model Hasil Panen (6 tanaman dengan bentuk low-poly khas masing-masing)
function createHarvestItemModel(cropId) {
  const g = new THREE.Group();
  if (cropId === 'wortel') {
    // Wortel: umbi oranye meruncing + daun hijau di atas (Satu Tangan)
    const root = new THREE.Mesh(
      new THREE.ConeGeometry(0.048, 0.19, 6),
      new THREE.MeshStandardMaterial({ color: 0xFF7043, roughness: 0.65 })
    );
    root.rotation.x = Math.PI;
    root.position.y = -0.02;
    g.add(root);
    const leaves = new THREE.Mesh(
      new THREE.BoxGeometry(0.065, 0.06, 0.065),
      new THREE.MeshStandardMaterial({ color: 0x43A047, roughness: 0.75 })
    );
    leaves.position.y = 0.095;
    g.add(leaves);
  } else if (cropId === 'kentang') {
    // Kentang: umbi bulat-kotak kecokelatan (Satu Tangan)
    const tuber = new THREE.Mesh(
      new THREE.BoxGeometry(0.10, 0.085, 0.12),
      new THREE.MeshStandardMaterial({ color: 0xC8A97E, roughness: 0.85 })
    );
    g.add(tuber);
    const spot = new THREE.Mesh(
      new THREE.BoxGeometry(0.03, 0.02, 0.03),
      new THREE.MeshStandardMaterial({ color: 0x8D6E63, roughness: 0.9 })
    );
    spot.position.set(0.025, 0.038, 0.02);
    g.add(spot);
  } else if (cropId === 'cabai') {
    // Cabai: buah cabai merah cerah + tangkai hijau (Satu Tangan)
    const body = new THREE.Mesh(
      new THREE.BoxGeometry(0.042, 0.16, 0.042),
      new THREE.MeshStandardMaterial({ color: 0xE53935, roughness: 0.45 })
    );
    body.rotation.z = 0.15;
    g.add(body);
    const tip = new THREE.Mesh(
      new THREE.ConeGeometry(0.024, 0.06, 5),
      new THREE.MeshStandardMaterial({ color: 0xD32F2F, roughness: 0.45 })
    );
    tip.rotation.x = Math.PI;
    tip.position.set(0.015, -0.10, 0);
    g.add(tip);
    const stem = new THREE.Mesh(
      new THREE.BoxGeometry(0.022, 0.04, 0.022),
      new THREE.MeshStandardMaterial({ color: 0x2E7D32, roughness: 0.7 })
    );
    stem.position.set(-0.01, 0.095, 0);
    g.add(stem);
  } else if (cropId === 'jagung') {
    // Jagung: bonggol jagung kuning besar dibalut kelobot hijau (Dua Tangan)
    const cob = new THREE.Mesh(
      new THREE.BoxGeometry(0.24, 0.095, 0.095),
      new THREE.MeshStandardMaterial({ color: 0xFDD835, roughness: 0.55 })
    );
    g.add(cob);
    const huskBottom = new THREE.Mesh(
      new THREE.BoxGeometry(0.26, 0.05, 0.11),
      new THREE.MeshStandardMaterial({ color: 0x43A047, roughness: 0.75 })
    );
    huskBottom.position.y = -0.03;
    g.add(huskBottom);
  } else if (cropId === 'pisang') {
    // Pisang: satu sisir pisang kuning besar (Dua Tangan)
    const bunch = new THREE.Group();
    const bMat = new THREE.MeshStandardMaterial({ color: 0xFFEB3B, roughness: 0.5 });
    for (let i = -1; i <= 1; i++) {
      const f = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.065, 0.20), bMat);
      f.position.set(i * 0.06, Math.abs(i) * 0.01, 0);
      f.rotation.x = 0.15;
      bunch.add(f);
    }
    const stem = new THREE.Mesh(
      new THREE.BoxGeometry(0.16, 0.04, 0.045),
      new THREE.MeshStandardMaterial({ color: 0x6D4C41, roughness: 0.85 })
    );
    stem.position.set(0, 0.035, -0.09);
    bunch.add(stem);
    g.add(bunch);
  } else if (cropId === 'gandum') {
    // Gandum: seikat batang gandum kuning keemasan dengan tali pengikat di tengah (Dua Tangan)
    const sheaf = new THREE.Mesh(
      new THREE.BoxGeometry(0.28, 0.10, 0.11),
      new THREE.MeshStandardMaterial({ color: 0xFBC02D, roughness: 0.75 })
    );
    g.add(sheaf);
    const tie = new THREE.Mesh(
      new THREE.BoxGeometry(0.045, 0.112, 0.122),
      new THREE.MeshStandardMaterial({ color: 0x6D4C41, roughness: 0.85 })
    );
    g.add(tie);
  }
  return g;
}

