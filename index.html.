// ==================== FARMING ====================
function plantCrop(plot, cropKey) {
  if (state.inventory.bibit[cropKey] <= 0) {
    showNotif('Bibit habis!');
    return;
  }
  state.inventory.bibit[cropKey]--;
  plot.state = 'planted';
  plot.crop = cropKey;
  plot.timer = 0;
  plot.watered = false;
  plot.mature = false;
  plot.growStage = 1;
  plot.luck = 0;

  if (plot.cropMeshes) {
    for (const cm of Object.values(plot.cropMeshes)) {
      cm.visible = false;
    }
  }
  const pg = plot.cropMeshes ? plot.cropMeshes[cropKey] : null;
  if (pg) {
    pg.visible = true;
    pg.position.set(0, 0.13, 0);
    pg.scale.set(0.60, 0.60, 0.60);
    plot.plantGroup = pg;
  }

  plot.mesh.material = PLOT_SOIL_DRY_MAT;
  playHoldAction('tanam_bibit');
  refreshHUD();
  refreshHotbar();
  updateHeldItem();
  saveGame();
  showNotif(`🌱 Menanam ${CONFIG.crops[cropKey].name}! Jangan lupa disiram.`);
}

function waterPlot(plot) {
  if (state.bucket.water <= 0) {
    showNotif('💧 Air habis, isi di sumur');
    return;
  }
  state.bucket.water--;
  plot.watered = true;
  plot.luck = (state.bucketSkin === 'api' ? CONFIG.skinApi.luck : (state.bucketSkin === 'daun' ? CONFIG.skinDaun.luck : 0));

  plot.mesh.material = PLOT_SOIL_WET_MAT;

  playHoldAction('isi_ember');
  emitWaterSplash(plot.position);
  addXP(CONFIG.xpSiram);
  refreshHUD();
  refreshHotbar();
  saveGame();
  const skinBonus = plot.luck > 0 ? ` (+${Math.round(plot.luck * 100)}% Luck)` : '';
  showNotif(`💧 Tanaman disiram! (+${CONFIG.xpSiram} XP)${skinBonus}`);
}

function rollHarvestMutation(luck) {
  const normalChance = Math.max(0, CONFIG.mutChanceNormal - luck);
  const roll = Math.random();
  if (roll < normalChance) {
    return 'biasa';
  }
  const totalBaseMut = CONFIG.mutChanceRainbow + CONFIG.mutChancePetir + CONFIG.mutChanceBatu;
  const subRoll = Math.random() * totalBaseMut;
  if (subRoll < CONFIG.mutChanceRainbow) return 'rainbow';
  else if (subRoll < CONFIG.mutChanceRainbow + CONFIG.mutChancePetir) return 'petir';
  else return 'batu';
}

function harvestCrop(plot) {
  if (!plot.mature) {
    showNotif('Tanaman belum matang! Tunggu sampai siap panen.');
    return;
  }
  const cropCfg = CONFIG.crops[plot.crop];
  const mutType = rollHarvestMutation(plot.luck);
  let itemName = cropCfg.name;
  if (mutType === 'rainbow') itemName += ' Rainbow';
  else if (mutType === 'petir') itemName += ' Petir';
  else if (mutType === 'batu') itemName += ' Batu';

  state.inventory.panen[itemName] = (state.inventory.panen[itemName] || 0) + 1;
  addXP(CONFIG.xpPanen);
  playHoldAction('ayun_cangkul');

  if (mutType !== 'biasa') {
    triggerScreenShake(0.7, 0.3);
    if (mutType === 'rainbow') emitMutationRainbow(plot.position);
    else if (mutType === 'petir') emitMutationPetir(plot.position);
    else if (mutType === 'batu') emitMutationBatu(plot.position);
    showMutationBanner(cropCfg.name, mutType);
    showNotif(`✨ MUTASI! Mendapatkan ${itemName}! (+${CONFIG.xpPanen} XP)`);
  } else {
    showNotif(`🌾 Berhasil memanen ${itemName}! (+${CONFIG.xpPanen} XP)`);
  }

  if (plot.plantGroup) {
    plot.plantGroup.visible = false;
    plot.plantGroup = null;
  }
  plot.state = 'empty';
  plot.crop = null;
  plot.watered = false;
  plot.mature = false;
  plot.timer = 0;
  plot.luck = 0;
  plot.mesh.material = PLOT_SOIL_DRY_MAT;

  refreshHUD();
  refreshHotbar();
  updateHeldItem();
  refreshInventory();
  saveGame();
}

function updateFarming(dt) {
  for (const plot of state.plots) {
    if (plot.animProgress < 1.0) {
      plot.animProgress += dt * 2.5;
      if (plot.animProgress >= 1.0) {
        plot.animProgress = 1.0;
        plot.group.scale.set(1, 1, 1);
      } else {
        const s = THREE.MathUtils.lerp(0.01, 1.0, plot.animProgress);
        plot.group.scale.set(s, s, s);
      }
    }

    if (plot.state === 'planted' && plot.plantGroup) {
      plot.plantGroup.visible = true;
    }

    if (plot.state === 'planted' && plot.watered && !plot.mature) {
      plot.timer += dt;
      const totalTime = CONFIG.crops[plot.crop].growTime;
      const progress = Math.min(1, plot.timer / totalTime);

      if (plot.plantGroup) {
        if (progress < 0.45) {
          plot.growStage = 1;
          const s = 0.60 + (progress / 0.45) * 0.25;
          plot.plantGroup.scale.set(s, s, s);
        } else if (progress < 1.0) {
          plot.growStage = 2;
          const s = 0.85 + ((progress - 0.45) / 0.55) * 0.25;
          plot.plantGroup.scale.set(s, s, s);
        } else {
          plot.growStage = 3;
          plot.mature = true;
          plot.timer = totalTime;
          plot.plantGroup.scale.set(1.10, 1.10, 1.10);
          saveGame();
          showNotif(`🌟 ${CONFIG.crops[plot.crop].name} sudah matang! Siap dipanen dengan cangkul.`);
        }
      }
    } else if (plot.mature && plot.plantGroup) {
      const bob = 1.10 + Math.sin(performance.now() * 0.005) * 0.04;
      plot.plantGroup.scale.set(bob, bob, bob);
    }
  }
}

