    _surfaceRaycaster.far = 5.0;
    const hits = _surfaceRaycaster.intersectObjects(houseRefs.walkableSurfaceMeshes, true);
    for (let i = 0; i < hits.length; i++) {
      if (hits[i].point.y > surfaceY) {
