function refreshInventory() {
  const tabsEl = document.getElementById('inv-tabs');
  const contentEl = document.getElementById('inv-content');
  if (!tabsEl || !contentEl) return;

  // Hitung jumlah jenis item di tiap kategori untuk badge pada tab
  const seedOrder = ['wortel', 'gandum', 'jagung', 'kentang', 'pisang', 'cabai'];
  let totalBibitTypes = 0;
  for (const k of seedOrder) {
    if ((state.inventory.bibit[k] || 0) > 0) totalBibitTypes++;
  }
  let totalPanenTypes = 0;
  for (const [, qty] of Object.entries(state.inventory.panen)) {
    if (qty > 0) totalPanenTypes++;
  }
  const totalTernakTypes = ((state.inventory.ternak.telur || 0) > 0 ? 1 : 0) + ((state.inventory.ternak.susu || 0) > 0 ? 1 : 0);

  const tabs = [
    { id: 'bibit',  label: `🌱 Bibit Tanaman (${totalBibitTypes})` },
    { id: 'panen',  label: `🌾 Hasil Panen (${totalPanenTypes})` },
    { id: 'ternak', label: `🥚 Hasil Ternak (${totalTernakTypes})` }
  ];

  let active = state.invTab || tabsEl.dataset.active || 'bibit';
  if (!['bibit', 'panen', 'ternak'].includes(active)) active = 'bibit';
  state.invTab = active;
  tabsEl.dataset.active = active;

  tabsEl.innerHTML = '';
  for (const t of tabs) {
    const tab = document.createElement('div');
    tab.className = 'inv-tab' + (t.id === active ? ' active' : '');
    tab.textContent = t.label;
    tab.onclick = () => {
      state.invTab = t.id;
      tabsEl.dataset.active = t.id;
      refreshInventory();
    };
    tabsEl.appendChild(tab);
  }

  contentEl.innerHTML = '';
  contentEl.style.display = 'grid';
  const emptyMsg = label => `<div style="grid-column:1/-1;text-align:center;color:#6D4C41;padding:26px 12px;font-weight:600;line-height:1.5">${label}</div>`;

  if (active === 'bibit') {
    let any = false;
    for (const k of seedOrder) {
      const v = state.inventory.bibit[k] || 0;
      if (v > 0) {
        any = true;
        const isHeld = Boolean(state.activeItem && state.activeItem.type === 'seed' && state.activeItem.id === k);
        const el = document.createElement('div');
        el.className = 'inv-item' + (isHeld ? ' equipped' : '');
        el.title = 'Klik untuk memegang bibit ini dan menanam di plot kosong';
        el.innerHTML = `
          <span class="ii">${seedIcons[k]}</span>
          <span class="in">${seedNames[k]}</span>
          <span class="ic">x${v}</span>
          <button class="inv-use-btn">${isHeld ? '✅ Sedang Dipegang' : '🌱 Pegang Bibit'}</button>
        `;
        el.onclick = () => {
          equipInventoryItem({
            type: 'seed',
            id: k,
            name: seedNames[k],
            icon: seedIcons[k],
            count: v
          });
          closeAllPanels();
          showNotif(`🌱 Memegang ${seedNames[k]} (x${v})! Klik / tekan E pada plot kosong untuk menanam.`);
        };
        contentEl.appendChild(el);
      }
    }
    if (!any) {
      contentEl.innerHTML = emptyMsg('Belum ada Bibit Tanaman di inventaris.<br>Beli bibit terlebih dahulu di 🌱 Toko Bibit!');
    }
  } else if (active === 'panen') {
    let any = false;
    const mutLabels = {
      biasa:   { text: 'Biasa',   cls: 'im-biasa' },
      rainbow: { text: '🌈 Rainbow', cls: 'im-rainbow' },
      petir:   { text: '⚡ Petir',   cls: 'im-petir' },
      batu:    { text: '🪨 Batu',    cls: 'im-batu' }
    };
    for (const [k, v] of Object.entries(state.inventory.panen)) {
      if (v > 0) {
        any = true;
        const parsed = parseHarvestItem(k);
        const icon = parsed ? (cropIcons[parsed.key] || '🌾') : '🌾';
        const mutType = parsed ? parsed.type : 'biasa';
        const mInfo = mutLabels[mutType] || mutLabels.biasa;
        const isHeld = Boolean(state.activeItem && state.activeItem.type === 'crop' && state.activeItem.rawName === k);
        const el = document.createElement('div');
        el.className = 'inv-item' + (isHeld ? ' equipped' : '');
        el.title = 'Klik untuk memegang hasil panen ini di tangan';
        el.innerHTML = `
          <span class="ii">${icon}</span>
          <span class="in">${parsed ? parsed.crop.name : k}</span>
          <span class="im-badge ${mInfo.cls}">${mInfo.text}</span>
          <span class="ic">x${v}</span>
          <button class="inv-use-btn">${isHeld ? '✅ Sedang Dipegang' : '🤲 Pegang'}</button>
        `;
        el.onclick = () => {
          if (parsed) {
            equipInventoryItem({
              type: 'crop',
              id: parsed.key,
              rawName: k,
              name: k,
              icon,
              count: v,
              mutType
            });
            closeAllPanels();
            showNotif(`🤲 Memegang ${k} (x${v})`);
          }
