// 3. Parser Biner GLB Sinkron untuk Sumur 3D (tanpa blob: URL atau normalMap yang gagal dimuat, dan konversi COLOR_0 VEC4 -> VEC3 RGB)
function parseAndMountWellGLB(arrayBuffer) {
  if (!arrayBuffer || arrayBuffer.byteLength < 20) return;
  const dv = new DataView(arrayBuffer);
  const magic = dv.getUint32(0, true);
  if (magic !== 0x46546C67) return; // 'glTF'

  const jsonLen = dv.getUint32(12, true);
  const jsonBytes = new Uint8Array(arrayBuffer, 20, jsonLen);
  const gltf = JSON.parse(new TextDecoder('utf-8').decode(jsonBytes));
  const binOffset = 20 + jsonLen + 8;

  // Bangun 6 Material Sumur dengan tekstur prosedural CanvasTexture (tanpa blob: URL & tanpa normalMap)
  // Material 0: Batu_Sumur (Dinding_Sumur)
  const texBatuSumur = createCanvasTex(256, 256, (ctx, w, h) => {
    ctx.fillStyle = '#3E3B36'; // Nat semen gelap
    ctx.fillRect(0, 0, w, h);
    const rows = 8;
    const rowH = h / rows;
    for (let r = 0; r < rows; r++) {
      const cols = 4;
      const colW = w / cols;
      const offset = (r % 2) * (colW * 0.5);
      for (let c = -1; c <= cols; c++) {
        const bx = c * colW + offset;
        const by = r * rowH;
        ctx.fillStyle = ((r + c) % 2 === 0) ? '#7A766E' : '#635F58';
        ctx.fillRect(bx + 2, by + 2, colW - 4, rowH - 4);
        ctx.fillStyle = 'rgba(255,255,255,0.06)';
        ctx.fillRect(bx + 4, by + 4, colW - 8, 4);
      }
    }
  });
  texBatuSumur.wrapS = texBatuSumur.wrapT = THREE.RepeatWrapping;

  // Material 1: Kayu (Rangka_Kayu & Ember)
  const texKayuSumur = createCanvasTex(256, 256, (ctx, w, h) => {
    ctx.fillStyle = '#8B5A2B';
    ctx.fillRect(0, 0, w, h);
    const plankW = w / 4;
    for (let i = 0; i < 4; i++) {
      ctx.fillStyle = (i % 2 === 0) ? '#8B5A2B' : '#734820';
      ctx.fillRect(i * plankW, 0, plankW, h);
      ctx.fillStyle = 'rgba(40,20,5,0.35)';
      ctx.fillRect(i * plankW, 0, 2, h);
    }
    ctx.fillStyle = 'rgba(55,30,10,0.18)';
    for (let y = 0; y < h; y += 6) {
      ctx.fillRect(0, y, w, 2);
    }
  });
  texKayuSumur.wrapS = texKayuSumur.wrapT = THREE.RepeatWrapping;

  // Material 2: Atap_Sirap (Atap)
  const texAtapSirap = createCanvasTex(256, 256, (ctx, w, h) => {
    ctx.fillStyle = '#472318';
    ctx.fillRect(0, 0, w, h);
    const rows = 8;
    const rowH = h / rows;
    for (let r = 0; r < rows; r++) {
      const cols = 6;
      const colW = w / cols;
      const offset = (r % 2) * (colW * 0.5);
      for (let c = -1; c <= cols; c++) {
        const sx = c * colW + offset;
        const sy = r * rowH;
        ctx.fillStyle = ((r + c) % 2 === 0) ? '#5C3022' : '#472318';
        ctx.fillRect(sx + 1, sy + 1, colW - 2, rowH - 3);
        ctx.fillStyle = 'rgba(0,0,0,0.3)';
        ctx.fillRect(sx, sy + rowH - 3, colW, 3);
      }
    }
  });
  texAtapSirap.wrapS = texAtapSirap.wrapT = THREE.RepeatWrapping;

  // Material 3: Tali (Tali)
  const texTaliSumur = createCanvasTex(128, 128, (ctx, w, h) => {
    ctx.fillStyle = '#B08D57';
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = '#8F6F3E';
    ctx.lineWidth = 4;
    for (let y = -w; y < h + w; y += 10) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y + w * 0.5);
      ctx.stroke();
    }
  });
  texTaliSumur.wrapS = texTaliSumur.wrapT = THREE.RepeatWrapping;

  const wellMaterials = [
    // 0: Batu_Sumur
    new THREE.MeshStandardMaterial({
      name: 'Batu_Sumur',
      map: texBatuSumur,
      roughness: 0.92,
      metalness: 0.0,
      side: THREE.DoubleSide
    }),
    // 1: Kayu
    new THREE.MeshStandardMaterial({
      name: 'Kayu',
      map: texKayuSumur,
      roughness: 0.85,
      metalness: 0.0,
      side: THREE.DoubleSide
    }),
    // 2: Atap_Sirap
    new THREE.MeshStandardMaterial({
      name: 'Atap_Sirap',
      map: texAtapSirap,
      roughness: 0.88,
      metalness: 0.0,
      side: THREE.DoubleSide
    }),
    // 3: Tali
    new THREE.MeshStandardMaterial({
      name: 'Tali',
      map: texTaliSumur,
      roughness: 0.92,
      metalness: 0.0,
      side: THREE.DoubleSide
    }),
    // 4: Besi_Ember
    new THREE.MeshStandardMaterial({
      name: 'Besi_Ember',
      color: new THREE.Color(0.25, 0.26, 0.28).convertLinearToSRGB(),
      metalness: 0.85,
      roughness: 0.45,
      side: THREE.DoubleSide
    }),
    // 5: Air
    new THREE.MeshStandardMaterial({
      name: 'Air',
      color: 0x1E88E5,
      emissive: 0x0D47A1,
      emissiveIntensity: 0.15,
      roughness: 0.12,
      metalness: 0.05,
      transparent: true,
      opacity: 0.82,
      depthWrite: false,
      side: THREE.DoubleSide
    })
  ];

  const compMap = {
    5120: Int8Array,
    5121: Uint8Array,
    5122: Int16Array,
    5123: Uint16Array,
    5125: Uint32Array,
    5126: Float32Array
  };
  const numMap = { SCALAR: 1, VEC2: 2, VEC3: 3, VEC4: 4, MAT4: 16 };

  function getAccData(accIdx) {
    const acc = gltf.accessors[accIdx];
    const bv = gltf.bufferViews[acc.bufferView];
    const TypedArr = compMap[acc.componentType];
    const nComp = numMap[acc.type] || 1;
    const byteOff = binOffset + (bv.byteOffset || 0) + (acc.byteOffset || 0);
    const totalLen = acc.count * nComp;
    const elemSize = TypedArr.BYTES_PER_ELEMENT;
    const sliceBuf = arrayBuffer.slice(byteOff, byteOff + totalLen * elemSize);
    return { array: new TypedArr(sliceBuf), nComp, count: acc.count };
  }

  function buildWellNode(nodeIdx) {
    const nDef = gltf.nodes[nodeIdx];
    const group = new THREE.Group();
    group.name = nDef.name || `well_node_${nodeIdx}`;
    if (nDef.translation) group.position.fromArray(nDef.translation);
    if (nDef.rotation) group.quaternion.fromArray(nDef.rotation);
    if (nDef.scale) group.scale.fromArray(nDef.scale);

    if (nDef.mesh !== undefined && gltf.meshes[nDef.mesh]) {
      const mDef = gltf.meshes[nDef.mesh];
      for (const prim of mDef.primitives) {
        const geom = new THREE.BufferGeometry();
        const attrs = prim.attributes || {};

        if (attrs.POSITION !== undefined) {
          const pos = getAccData(attrs.POSITION);
          geom.setAttribute('position', new THREE.BufferAttribute(pos.array, 3));
        }
        if (attrs.NORMAL !== undefined) {
          const norm = getAccData(attrs.NORMAL);
          geom.setAttribute('normal', new THREE.BufferAttribute(norm.array, 3));
        }
        if (attrs.TEXCOORD_0 !== undefined) {
          const uv = getAccData(attrs.TEXCOORD_0);
          geom.setAttribute('uv', new THREE.BufferAttribute(uv.array, 2));
        }

        let hasVertexColor = false;
        if (attrs.COLOR_0 !== undefined) {
          const col = getAccData(attrs.COLOR_0);
          if (col.nComp === 4) {
            // Konversi VEC4 (RGBA) menjadi VEC3 (RGB) agar tidak memicu USE_COLOR_ALPHA / transparan
            const rgbArr = new Float32Array(col.count * 3);
            for (let i = 0; i < col.count; i++) {
              rgbArr[i * 3]     = col.array[i * 4];
              rgbArr[i * 3 + 1] = col.array[i * 4 + 1];
              rgbArr[i * 3 + 2] = col.array[i * 4 + 2];
            }
            geom.setAttribute('color', new THREE.BufferAttribute(rgbArr, 3));
          } else {
            geom.setAttribute('color', new THREE.BufferAttribute(col.array, 3));
          }
          hasVertexColor = true;
        }

        if (prim.indices !== undefined) {
          const idx = getAccData(prim.indices);
          geom.setIndex(new THREE.BufferAttribute(idx.array, 1));
        }
        if (attrs.NORMAL === undefined) {
          geom.computeVertexNormals();
        }

        let mat = wellMaterials[prim.material !== undefined ? prim.material : 0] || wellMaterials[0];
        if (hasVertexColor) {
          mat = mat.clone();
          mat.vertexColors = true;
        }

        const isWater = (nDef.name === 'Air' || mDef.name === 'Air');
        const mesh = new THREE.Mesh(geom, mat);
        mesh.name = nDef.name || mDef.name || 'WellPart';
        mesh.castShadow = !isWater;
        mesh.receiveShadow = true;
        mesh.frustumCulled = false;
        group.add(mesh);
      }
    }

    if (nDef.children) {
      for (const cIdx of nDef.children) {
        group.add(buildWellNode(cIdx));
      }
    }
    return group;
  }

  const wellModel = new THREE.Group();
  wellModel.name = 'Sumur3D';
  const sceneDef = gltf.scenes[gltf.scene || 0];
  for (const rIdx of sceneDef.nodes) {
    wellModel.add(buildWellNode(rIdx));
  }

  wellModel.position.set(CONFIG.wellPos.x, 0, CONFIG.wellPos.z);
  wellModel.scale.setScalar(0.9);
  scene.add(wellModel);
  wellModel.updateMatrixWorld(true);
  wellInteractable.group = wellModel;

  // Bounding box & posisi dunia untuk verifikasi
  const worldPos = new THREE.Vector3();
  wellModel.getWorldPosition(worldPos);
  const box = new THREE.Box3().setFromObject(wellModel);
  console.log('✅ [Sumur 3D Berhasil Dipasang]:', {
    posisiDunia: { x: worldPos.x, y: worldPos.y, z: worldPos.z },
    boundingBoxMin: { x: box.min.x, y: box.min.y, z: box.min.z },
    boundingBoxMax: { x: box.max.x, y: box.max.y, z: box.max.z },
    size: { x: box.max.x - box.min.x, y: box.max.y - box.min.y, z: box.max.z - box.min.z }
  });
}

