// Helper pembuat geometri peti kayu low-poly blocky (mudah diganti model .glb di kemudian hari)
function createOpenCrateMesh(boxType) {
  const crateGroup = new THREE.Group();
  crateGroup.name = `crate_mesh_${boxType}`;

  // Warna kayu senada dengan kandang ayam & kandang sapi (low-poly blocky)
  const woodMainMat = new THREE.MeshStandardMaterial({ color: 0x8D5B32, roughness: 0.86 });
  const woodDarkMat = new THREE.MeshStandardMaterial({ color: 0x5D3A1A, roughness: 0.90 });
  const woodTrimMat = new THREE.MeshStandardMaterial({ color: 0x7A4924, roughness: 0.85 });
  const strawBedMat = new THREE.MeshStandardMaterial({ color: 0xD89B28, roughness: 0.92 });

  // Alas kayu bawah peti
  const baseSlab = new THREE.Mesh(new THREE.BoxGeometry(0.96, 0.08, 0.74), woodDarkMat);
  baseSlab.position.set(0, 0.04, 0);
  baseSlab.castShadow = true;
  baseSlab.receiveShadow = true;
  crateGroup.add(baseSlab);

  // Bantalan jerami di dasar dalam peti terbuka
  const strawBed = new THREE.Mesh(new THREE.BoxGeometry(0.84, 0.06, 0.62), strawBedMat);
  strawBed.position.set(0, 0.10, 0);
  strawBed.receiveShadow = true;
  crateGroup.add(strawBed);

  // 4 tiang sudut peti blocky
  const postGeo = new THREE.BoxGeometry(0.09, 0.50, 0.09);
  for (const [px, pz] of [[-0.435, -0.325], [0.435, -0.325], [-0.435, 0.325], [0.435, 0.325]]) {
    const post = new THREE.Mesh(postGeo, woodDarkMat);
    post.position.set(px, 0.25, pz);
    post.castShadow = true;
    post.receiveShadow = true;
    crateGroup.add(post);
  }

  // Papan dinding belakang (2 bilah horizontal)
  for (const py of [0.18, 0.38]) {
    const backPlank = new THREE.Mesh(new THREE.BoxGeometry(0.88, 0.16, 0.05), woodMainMat);
    backPlank.position.set(0, py, -0.325);
    backPlank.castShadow = true;
    backPlank.receiveShadow = true;
    crateGroup.add(backPlank);
  }

  // Papan dinding samping kiri & kanan (2 bilah horizontal)
  for (const sx of [-0.435, 0.435]) {
    for (const py of [0.18, 0.38]) {
      const sidePlank = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.16, 0.64), woodMainMat);
      sidePlank.position.set(sx, py, 0);
      sidePlank.castShadow = true;
      sidePlank.receiveShadow = true;
      crateGroup.add(sidePlank);
    }
  }

  // Dinding depan dibuat lebih rendah (1 bilah bawah) agar sisi terbuka menghadap ke depan (+z)
  // dan isi telur/botol susu langsung terlihat jelas dari kamera third person
  const frontPlank = new THREE.Mesh(new THREE.BoxGeometry(0.88, 0.17, 0.05), woodTrimMat);
  frontPlank.position.set(0, 0.175, 0.325);
  frontPlank.castShadow = true;
  frontPlank.receiveShadow = true;
  crateGroup.add(frontPlank);

  // Emblem kecil di bibir depan peti (krem untuk telur, biru-putih untuk susu)
  const badgeColor = boxType === 'telur' ? 0xFFF3E0 : 0x1E88E5;
  const badge = new THREE.Mesh(
    new THREE.BoxGeometry(0.24, 0.09, 0.02),
    new THREE.MeshStandardMaterial({ color: badgeColor, roughness: 0.4 })
  );
  badge.position.set(0, 0.175, 0.355);
  crateGroup.add(badge);

  return { crateGroup, hitMesh: baseSlab };
}

// Helper pembuat 1 unit visual isi (telur atau botol susu) di dalam kotak
function createBoxContentUnitMesh(boxType, index) {
  if (boxType === 'telur') {
    // Telur bulat/oval krem & cokelat muda bergaya low-poly
    const isLightBrown = (index % 3 === 1);
    const eggMat = new THREE.MeshStandardMaterial({
      color: isLightBrown ? 0xE6C29F : 0xFFF3E0,
      roughness: 0.35
    });
    const egg = new THREE.Mesh(new THREE.DodecahedronGeometry(0.075, 0), eggMat);
    egg.scale.set(0.95, 1.32, 0.95);
    egg.castShadow = true;
    egg.receiveShadow = true;
    return egg;
  } else {
    // Botol/kaleng susu blok putih dengan tutup dan label biru
    const bottleGroup = new THREE.Group();
    const whiteMat = new THREE.MeshStandardMaterial({ color: 0xFFFFFF, roughness: 0.25 });
    const blueMat = new THREE.MeshStandardMaterial({ color: 0x1E88E5, roughness: 0.35 });

    const body = new THREE.Mesh(new THREE.BoxGeometry(0.11, 0.20, 0.11), whiteMat);
    body.position.y = 0.10;
    body.castShadow = true;
    body.receiveShadow = true;
    bottleGroup.add(body);

    // Label biru melingkari bagian tengah botol
    const labelBand = new THREE.Mesh(new THREE.BoxGeometry(0.116, 0.055, 0.116), blueMat);
    labelBand.position.y = 0.105;
    bottleGroup.add(labelBand);

    // Leher & tutup botol biru di atas
    const neck = new THREE.Mesh(new THREE.BoxGeometry(0.065, 0.03, 0.065), whiteMat);
    neck.position.y = 0.215;
    bottleGroup.add(neck);

    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.035, 0.075), blueMat);
    cap.position.y = 0.245;
    bottleGroup.add(cap);

    return bottleGroup;
  }
}

function drawProductBoxLabel(canvas, title, itemName, count, maxCap) {
  const ctx = canvas.getContext('2d');
  const w = canvas.width, h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  // Latar papan kayu gelap dengan bingkai kontras
  ctx.fillStyle = 'rgba(62, 39, 35, 0.92)';
  ctx.beginPath();
  ctx.roundRect(6, 6, w - 12, h - 12, 16);
  ctx.fill();
  ctx.lineWidth = 5;
  ctx.strokeStyle = count >= maxCap ? '#FF5252' : '#FFB74D';
  ctx.stroke();

  // Baris 1: Judul Kotak ("Kotak Telur" / "Kotak Susu")
  ctx.fillStyle = '#FFF8E1';
  ctx.font = 'bold 28px Segoe UI, Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(title, w / 2, 36);

  // Baris 2: Jumlah isi ("Telur 5/20" / "Susu 5/20")
  ctx.fillStyle = count >= maxCap ? '#FF8A80' : (count > 0 ? '#FFD54F' : '#BCAAA4');
  ctx.font = 'bold 24px Segoe UI, Arial, sans-serif';
  const statusSuffix = count >= maxCap ? ' (PENUH)' : '';
  ctx.fillText(`${itemName} ${count}/${maxCap}${statusSuffix}`, w / 2, 76);
}

function buildProductBox(boxType, penPos, offset, titleLabel, itemName, rotY = 0) {
  const worldX = penPos.x + offset.x;
  const worldY = offset.y || 0;
  const worldZ = penPos.z + offset.z;

  const root = new THREE.Group();
  root.position.set(worldX, worldY, worldZ);
  root.rotation.y = rotY;
  scene.add(root);

  const { crateGroup, hitMesh } = createOpenCrateMesh(boxType);
  root.add(crateGroup);

  // Buat tumpukan item di dalam peti sampai kapasitas maksimum (20 item: 2 lapis x 10 item [5x2])
  const contentsGroup = new THREE.Group();
  root.add(contentsGroup);
  const itemMeshes = [];
  for (let i = 0; i < MAX_BOX_CAPACITY; i++) {
    const layer = Math.floor(i / 10); // 0 atau 1
    const idxInLayer = i % 10;
    const col = idxInLayer % 5;       // 0..4
    const row = Math.floor(idxInLayer / 5); // 0..1

    const itemMesh = createBoxContentUnitMesh(boxType, i);
    const ix = -0.30 + col * 0.15 + (layer * 0.015);
    const iz = -0.12 + row * 0.24 - (layer * 0.01);
    const iy = boxType === 'telur'
      ? (0.18 + layer * 0.14)
      : (0.12 + layer * 0.22);

    itemMesh.position.set(ix, iy, iz);
    if (boxType === 'telur') {
      itemMesh.rotation.set((i % 2) * 0.12 - 0.06, i * 0.7, ((i + 1) % 3 - 1) * 0.1);
    } else {
      itemMesh.rotation.y = ((i % 3) - 1) * 0.08;
    }
    itemMesh.visible = false;
    contentsGroup.add(itemMesh);
    itemMeshes.push(itemMesh);
  }

  // Label melayang di atas kotak ("Kotak Telur" / "Kotak Susu" + counter "Telur 0/20")
  const lblCanvas = document.createElement('canvas');
  lblCanvas.width = 320;
  lblCanvas.height = 108;
  drawProductBoxLabel(lblCanvas, titleLabel, itemName, 0, MAX_BOX_CAPACITY);

  const lblTex = new THREE.CanvasTexture(lblCanvas);
  lblTex.colorSpace = THREE.SRGBColorSpace;
  const lblSpriteMat = new THREE.SpriteMaterial({ map: lblTex, transparent: true, depthTest: false });
  const lblSprite = new THREE.Sprite(lblSpriteMat);
  lblSprite.scale.set(1.65, 0.56, 1);
  lblSprite.position.set(0, 1.05, 0);
  lblSprite.renderOrder = 999;
  root.add(lblSprite);

  // Collider halus agar karakter tidak menembus kotak namun tidak menyangkut
  colliders.push({ x: worldX, z: worldZ, radius: 0.42 });

  const boxObj = {
    boxType,
    titleLabel,
    itemName,
    root,
    crateGroup,
    itemMeshes,
    lblCanvas,
    lblTex,
    lblSprite,
    position: new THREE.Vector3(worldX, worldY, worldZ)
  };
  productBoxes[boxType] = boxObj;

  interactables.push({
    mesh: hitMesh,
    type: 'productBox',
    boxType,
    data: boxObj,
    position: boxObj.position,
    group: crateGroup
  });

  return boxObj;
}

function updateProductBoxVisuals(boxType) {
  const box = productBoxes[boxType];
  if (!box) return;
  const count = Math.min(MAX_BOX_CAPACITY, Math.max(0, state.boxStorage?.[boxType] ?? 0));
  for (let i = 0; i < box.itemMeshes.length; i++) {
    box.itemMeshes[i].visible = (i < count);
  }
  drawProductBoxLabel(box.lblCanvas, box.titleLabel, box.itemName, count, MAX_BOX_CAPACITY);
  box.lblTex.needsUpdate = true;
}

function updateAllProductBoxes() {
  updateProductBoxVisuals('telur');
  updateProductBoxVisuals('susu');
}

