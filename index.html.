// ==================== MODEL 3D SAPI (sapi.glb) & ANIMASI SENDI ====================
const SAPI_GLB_GZIP_B64 = '';
const COW_MODEL_SCALE = 1.0;
let cowModelTemplate = null;

function extractCowRig(modelRoot) {
  const badan = modelRoot.getObjectByName('badan');
  const leher = modelRoot.getObjectByName('leher');
  const kepala = modelRoot.getObjectByName('kepala');
  const telinga_kiri = modelRoot.getObjectByName('telinga_kiri');
  const telinga_kanan = modelRoot.getObjectByName('telinga_kanan');
  const ekor = modelRoot.getObjectByName('ekor');
  const ekor_ujung = modelRoot.getObjectByName('ekor_ujung');
  const kaki_depan_kiri = modelRoot.getObjectByName('kaki_depan_kiri');
  const lutut_depan_kiri = modelRoot.getObjectByName('lutut_depan_kiri');
  const kaki_depan_kanan = modelRoot.getObjectByName('kaki_depan_kanan');
  const lutut_depan_kanan = modelRoot.getObjectByName('lutut_depan_kanan');
  const kaki_belakang_kiri = modelRoot.getObjectByName('kaki_belakang_kiri');
  const sendi_belakang_kiri = modelRoot.getObjectByName('sendi_belakang_kiri');
  const kaki_belakang_kanan = modelRoot.getObjectByName('kaki_belakang_kanan');
  const sendi_belakang_kanan = modelRoot.getObjectByName('sendi_belakang_kanan');

  return {
    badan,
    leher,
    kepala,
    telinga_kiri,
    telinga_kanan,
    ekor,
    ekor_ujung,
    kaki_depan_kiri,
    lutut_depan_kiri,
    kaki_depan_kanan,
    lutut_depan_kanan,
    kaki_belakang_kiri,
    sendi_belakang_kiri,
    kaki_belakang_kanan,
    sendi_belakang_kanan,
    baseBadanY: badan ? badan.position.y : 0.92,
    baseLeherRotX: leher ? leher.rotation.x : 0,
    baseKepalaRotX: kepala ? kepala.rotation.x : 0.16,
    baseTelingaKiriRotZ: telinga_kiri ? telinga_kiri.rotation.z : 0,
    baseTelingaKananRotZ: telinga_kanan ? telinga_kanan.rotation.z : 0
  };
}

function attachCowModelToAnimal(aData) {
  if (!aData || aData.type !== 'sapi' || !aData.mesh || !cowModelTemplate) return;
  const g = aData.mesh;

  // Hapus mesh sapi lama / placeholder di dalam grup induk sapi (kecuali sprite emoji hati)
  const toRemove = [];
  for (const child of g.children) {
    if (child !== aData.emojiSprite) {
      toRemove.push(child);
    }
  }
  for (const child of toRemove) {
    g.remove(child);
  }

  const cloneScene = cowModelTemplate.clone(true);
  cloneScene.position.set(0, 0, 0);
  cloneScene.rotation.set(0, 0, 0);
  cloneScene.scale.setScalar(COW_MODEL_SCALE);

  let primaryBodyMesh = null;
  cloneScene.traverse(child => {
    if (child.isMesh) {
      child.castShadow = true;
      child.receiveShadow = true;
      child.frustumCulled = false;
      if (child.material) {
        child.material = Array.isArray(child.material)
          ? child.material.map(m => m.clone())
          : child.material.clone();
        if (child.geometry && child.geometry.attributes && child.geometry.attributes.color) {
          if (Array.isArray(child.material)) {
            child.material.forEach(m => { m.vertexColors = true; m.needsUpdate = true; });
          } else {
            child.material.vertexColors = true;
            child.material.needsUpdate = true;
          }
        }
      }
      if (!primaryBodyMesh || child.name === 'mesh_badan') {
        primaryBodyMesh = child;
      }
    }
  });

  g.add(cloneScene);
  aData.modelRoot = cloneScene;
  aData.cowRig = extractCowRig(cloneScene);

  // Perbarui referensi mesh utama pada daftar interactables
  for (const ia of interactables) {
    if (ia.data === aData) {
      if (primaryBodyMesh) ia.mesh = primaryBodyMesh;
      ia.group = g;
      break;
    }
  }
}

function onCowGLBLoaded(gltf) {
  if (!gltf || !gltf.scene) return;
  cowModelTemplate = gltf.scene;
  cowModelTemplate.position.set(0, 0, 0);
  cowModelTemplate.rotation.set(0, 0, 0);
  cowModelTemplate.scale.set(1, 1, 1);

  // Pasang model sapi.glb ke seluruh objek sapi yang sudah ada di Kandang Sapi (termasuk hasil loadGame)
  if (Array.isArray(state.animals)) {
    for (const a of state.animals) {
      if (a && a.type === 'sapi') {
        attachCowModelToAnimal(a);
      }
    }
  }
}

function initCowGLBModel() {
  const loader = new GLTFLoader();
  const loadFromFileFallback = () => {
    loader.load(
      './sapi.glb',
      onCowGLBLoaded,
      undefined,
      err => console.error('Gagal memuat ./sapi.glb:', err)
    );
  };

  if (SAPI_GLB_GZIP_B64 && !SAPI_GLB_GZIP_B64.startsWith('__') && typeof DecompressionStream !== 'undefined') {
    try {
      const binStr = atob(SAPI_GLB_GZIP_B64);
      const gzBytes = new Uint8Array(binStr.length);
      for (let i = 0; i < binStr.length; i++) gzBytes[i] = binStr.charCodeAt(i);
      new Response(new Blob([gzBytes]).stream().pipeThrough(new DecompressionStream('gzip')))
        .arrayBuffer()
        .then(buf => {
          loader.parse(buf, '', onCowGLBLoaded, err => {
            console.warn('Gagal parse SAPI_GLB_GZIP_B64, mencoba ./sapi.glb:', err);
            loadFromFileFallback();
          });
        })
        .catch(err => {
          console.warn('Gagal dekompresi SAPI_GLB_GZIP_B64, mencoba ./sapi.glb:', err);
          loadFromFileFallback();
        });
      return;
    } catch (e) {
      console.warn('Fallback ke ./sapi.glb:', e);
    }
  }
  loadFromFileFallback();
}

function updateCowProceduralAnimation(a, dt, isWalking) {
  const rig = a.cowRig;
  if (!rig) return;

  a.animPhase = (a.animPhase || Math.random() * 10) + dt;
  const t = a.animPhase;
  const blend = Math.min(1, dt * 10);

  if (isWalking) {
    a.walkTime = (a.walkTime || 0) + dt * 6.8;
    const wt = a.walkTime;
    const swing = Math.sin(wt) * 0.35;

    // Ayunan pangkal kaki bersilangan diagonal pada sumbu X (rotation.x)
    if (rig.kaki_depan_kiri) rig.kaki_depan_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_depan_kiri.rotation.x, swing, blend);
    if (rig.kaki_belakang_kanan) rig.kaki_belakang_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_belakang_kanan.rotation.x, swing, blend);
    if (rig.kaki_depan_kanan) rig.kaki_depan_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_depan_kanan.rotation.x, -swing, blend);
    if (rig.kaki_belakang_kiri) rig.kaki_belakang_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_belakang_kiri.rotation.x, -swing, blend);

    // Tekukan sendi bawah (lutut depan & sendi belakang) mengikuti langkah kaki
    const kneeLiftA = Math.max(0, -Math.cos(wt)) * 0.28;
    const kneeLiftB = Math.max(0, Math.cos(wt)) * 0.28;
    if (rig.lutut_depan_kiri) rig.lutut_depan_kiri.rotation.x = THREE.MathUtils.lerp(rig.lutut_depan_kiri.rotation.x, kneeLiftA, blend);
    if (rig.sendi_belakang_kanan) rig.sendi_belakang_kanan.rotation.x = THREE.MathUtils.lerp(rig.sendi_belakang_kanan.rotation.x, -kneeLiftA * 0.85, blend);
    if (rig.lutut_depan_kanan) rig.lutut_depan_kanan.rotation.x = THREE.MathUtils.lerp(rig.lutut_depan_kanan.rotation.x, kneeLiftB, blend);
    if (rig.sendi_belakang_kiri) rig.sendi_belakang_kiri.rotation.x = THREE.MathUtils.lerp(rig.sendi_belakang_kiri.rotation.x, -kneeLiftB * 0.85, blend);

    // Bobbing lembut pada badan dan anggukan halus pada leher & kepala saat berjalan
    if (rig.badan) {
      const targetY = rig.baseBadanY + Math.abs(Math.sin(wt)) * 0.022;
      rig.badan.position.y = THREE.MathUtils.lerp(rig.badan.position.y, targetY, blend);
    }
    if (rig.leher) {
      rig.leher.rotation.x = THREE.MathUtils.lerp(rig.leher.rotation.x, rig.baseLeherRotX + Math.sin(wt * 2) * 0.04, blend);
    }
    if (rig.kepala) {
      rig.kepala.rotation.x = THREE.MathUtils.lerp(rig.kepala.rotation.x, rig.baseKepalaRotX + Math.cos(wt * 2) * 0.035, blend);
      rig.kepala.rotation.y = THREE.MathUtils.lerp(rig.kepala.rotation.y, Math.sin(wt) * 0.03, blend);
    }
    if (rig.telinga_kiri) {
      rig.telinga_kiri.rotation.z = THREE.MathUtils.lerp(rig.telinga_kiri.rotation.z, rig.baseTelingaKiriRotZ + Math.sin(wt * 2) * 0.06, blend);
    }
    if (rig.telinga_kanan) {
      rig.telinga_kanan.rotation.z = THREE.MathUtils.lerp(rig.telinga_kanan.rotation.z, rig.baseTelingaKananRotZ - Math.sin(wt * 2) * 0.06, blend);
    }
  } else {
    // Saat Sapi Berdiri Diam (Idle): kembalikan rotasi keempat kaki & sendi lutut secara halus (lerp) ke 0
    const idleLerp = Math.min(1, dt * 7.5);
    if (rig.kaki_depan_kiri) rig.kaki_depan_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_depan_kiri.rotation.x, 0, idleLerp);
    if (rig.kaki_depan_kanan) rig.kaki_depan_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_depan_kanan.rotation.x, 0, idleLerp);
    if (rig.kaki_belakang_kiri) rig.kaki_belakang_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_belakang_kiri.rotation.x, 0, idleLerp);
    if (rig.kaki_belakang_kanan) rig.kaki_belakang_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_belakang_kanan.rotation.x, 0, idleLerp);
    if (rig.lutut_depan_kiri) rig.lutut_depan_kiri.rotation.x = THREE.MathUtils.lerp(rig.lutut_depan_kiri.rotation.x, 0, idleLerp);
    if (rig.lutut_depan_kanan) rig.lutut_depan_kanan.rotation.x = THREE.MathUtils.lerp(rig.lutut_depan_kanan.rotation.x, 0, idleLerp);
    if (rig.sendi_belakang_kiri) rig.sendi_belakang_kiri.rotation.x = THREE.MathUtils.lerp(rig.sendi_belakang_kiri.rotation.x, 0, idleLerp);
    if (rig.sendi_belakang_kanan) rig.sendi_belakang_kanan.rotation.x = THREE.MathUtils.lerp(rig.sendi_belakang_kanan.rotation.x, 0, idleLerp);

    // Gerakan bernapas/mengangguk halus pada badan, leher, kepala, serta gerakan telinga
    if (rig.badan) {
      rig.badan.position.y = THREE.MathUtils.lerp(rig.badan.position.y, rig.baseBadanY + Math.sin(t * 1.8) * 0.006, idleLerp);
    }
    if (rig.leher) {
      rig.leher.rotation.x = THREE.MathUtils.lerp(rig.leher.rotation.x, rig.baseLeherRotX + Math.sin(t * 1.5) * 0.025, idleLerp);
    }
    if (rig.kepala) {
      rig.kepala.rotation.x = THREE.MathUtils.lerp(rig.kepala.rotation.x, rig.baseKepalaRotX + Math.sin(t * 1.5 - 0.4) * 0.04, idleLerp);
      rig.kepala.rotation.y = THREE.MathUtils.lerp(rig.kepala.rotation.y, Math.sin(t * 0.7) * 0.04, idleLerp);
    }
    const earTwitch = Math.sin(t * 2.6) * 0.07;
    if (rig.telinga_kiri) {
      rig.telinga_kiri.rotation.z = THREE.MathUtils.lerp(rig.telinga_kiri.rotation.z, rig.baseTelingaKiriRotZ + earTwitch, idleLerp);
    }
    if (rig.telinga_kanan) {
      rig.telinga_kanan.rotation.z = THREE.MathUtils.lerp(rig.telinga_kanan.rotation.z, rig.baseTelingaKananRotZ - earTwitch, idleLerp);
    }
  }

  // Animasi Ekor Bergerak (selalu aktif baik saat berjalan maupun saat diam)
  const tailFreq = isWalking ? 4.2 : 2.3;
  const tailAmpZ = isWalking ? 0.22 : 0.14;
  if (rig.ekor) {
    rig.ekor.rotation.z = Math.sin(t * tailFreq) * tailAmpZ;
    rig.ekor.rotation.x = 0.06 + Math.cos(t * (tailFreq * 0.5)) * 0.05;
  }
  if (rig.ekor_ujung) {
    rig.ekor_ujung.rotation.z = Math.sin(t * tailFreq - 0.65) * (tailAmpZ * 1.35);
    rig.ekor_ujung.rotation.x = Math.sin(t * (tailFreq * 0.5)) * 0.06;
  }
}

