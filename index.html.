// Terapkan kualitas grafik secara otomatis & instan (real-time)
function applyGraphicsQuality(level, silent = false) {
  const normLevel = (level === 'low' || level === 'medium' || level === 'high') ? level : 'high';
  graphicsConfig.quality = normLevel;

  try {
    localStorage.setItem(GRAPHICS_STORAGE_KEY, normLevel);
  } catch (e) {
    // ignore storage errors
  }

  const maxAniso = renderer.capabilities.getMaxAnisotropy ? renderer.capabilities.getMaxAnisotropy() : 8;

  if (normLevel === 'low') {
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1.0, 1.0) * 0.7);
    renderer.shadowMap.enabled = false;
    renderer.shadowMap.needsUpdate = true;
    renderer.toneMapping = THREE.NoToneMapping;
    renderer.toneMappingExposure = 0.96;

    dirLight.castShadow = false;
    camera.far = 95;
    camera.updateProjectionMatrix();
    if (scene.fog && scene.fog.isFogExp2) {
      scene.fog.density = 0.0185;
    }

    graphicsConfig.particleDensity = 0.0;
    graphicsConfig.anisotropy = 1;
    if (typeof GRASS_CONFIG !== 'undefined') {
      GRASS_CONFIG.quality = 'low';
    }
    for (const p of particlePool) {
      if (p.active) {
        p.active = false;
        p.mesh.visible = false;
      }
    }
  } else if (normLevel === 'medium') {
    renderer.setPixelRatio(1.0);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    renderer.shadowMap.needsUpdate = true;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;

    dirLight.castShadow = true;
    if (dirLight.shadow.mapSize.x !== 1024) {
      dirLight.shadow.mapSize.set(1024, 1024);
      if (dirLight.shadow.map) {
        dirLight.shadow.map.dispose();
        dirLight.shadow.map = null;
      }
    }

    camera.far = 145;
    camera.updateProjectionMatrix();
    if (scene.fog && scene.fog.isFogExp2) {
      scene.fog.density = 0.0135;
    }

    graphicsConfig.particleDensity = 0.6;
    graphicsConfig.anisotropy = Math.min(4, maxAniso);
    if (typeof GRASS_CONFIG !== 'undefined') {
      GRASS_CONFIG.quality = 'sedang';
    }
  } else {
    renderer.setPixelRatio(window.devicePixelRatio || 1.0);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.shadowMap.needsUpdate = true;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;

    dirLight.castShadow = true;
    if (dirLight.shadow.mapSize.x !== 2048) {
      dirLight.shadow.mapSize.set(2048, 2048);
      if (dirLight.shadow.map) {
        dirLight.shadow.map.dispose();
        dirLight.shadow.map = null;
      }
    }

    camera.far = 200;
    camera.updateProjectionMatrix();
    if (scene.fog && scene.fog.isFogExp2) {
      scene.fog.density = 0.011;
    }

    graphicsConfig.particleDensity = 1.0;
    graphicsConfig.anisotropy = maxAniso;
    if (typeof GRASS_CONFIG !== 'undefined') {
      GRASS_CONFIG.quality = 'tinggi';
    }
  }

  renderer.setSize(window.innerWidth, window.innerHeight);

  scene.traverse(obj => {
    if (!obj.isMesh) return;
    if (obj.userData._origCastShadow === undefined) {
      obj.userData._origCastShadow = Boolean(obj.castShadow);
      obj.userData._origReceiveShadow = Boolean(obj.receiveShadow);
    }
    if (normLevel === 'low') {
      obj.castShadow = false;
      obj.receiveShadow = false;
    } else {
      obj.castShadow = obj.userData._origCastShadow;
      obj.receiveShadow = obj.userData._origReceiveShadow;
    }

    const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
    mats.forEach(mat => {
      if (!mat) return;
      if (mat.map) {
        mat.map.anisotropy = graphicsConfig.anisotropy;
        mat.map.needsUpdate = true;
      }
      mat.needsUpdate = true;
    });
  });

  ['low', 'medium', 'high'].forEach(q => {
    const btn = document.getElementById(`gfx-btn-${q}`);
    if (btn) btn.classList.toggle('active', q === normLevel);
  });

  if (!silent) {
    const labelMap = {
      low: '⚡ Grafik: Low',
      medium: '🌤️ Grafik: Medium',
      high: '✨ Grafik: High'
    };
    showNotif(labelMap[normLevel]);
  }
}
window.applyGraphicsQuality = applyGraphicsQuality;

function updateMainMenuResponsiveLayout() {
