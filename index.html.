  barnModel.add(roomFloor);

  const shedFloor = new THREE.Mesh(
    new THREE.PlaneGeometry(1.92, 4.32),
    new THREE.MeshStandardMaterial({ color: 0x9E8B60, roughness: 1.0 })
  );
  shedFloor.rotation.x = -Math.PI / 2;
  shedFloor.position.set(-2.08, 0.012, 0);
  shedFloor.receiveShadow = true;
  barnModel.add(shedFloor);

  const threshold = new THREE.Mesh(
    new THREE.BoxGeometry(1.84, 0.03, 0.34),
    new THREE.MeshStandardMaterial({ color: 0x6D4C41, roughness: 0.9 })
  );
  threshold.position.set(0.85, 0.016, 2.22);
  threshold.receiveShadow = true;
  barnModel.add(threshold);

  // Thin dark wall liners so exterior plank gaps stay dark while keeping the room interior 100% hollow
  const linerMat = new THREE.MeshStandardMaterial({ color: 0x240B04, roughness: 0.9, side: THREE.DoubleSide });
  const addLinerBox = (w, h, d, x, y, z) => {
    const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), linerMat);
    m.position.set(x, y, z);
    m.receiveShadow = true;
    barnModel.add(m);
  };
  // Back wall, Left wall, Right wall, Front wall (around open doorway x in [-0.04, 1.74], y in [0, 2.22]), Shed back wall
  addLinerBox(3.90, 3.04, 0.02, 0.85, 1.52, -2.14);
  addLinerBox(0.02, 3.04, 4.28, -1.10, 1.52, 0);
  addLinerBox(0.02, 3.04, 4.28, 2.79, 1.52, 0);
  addLinerBox(1.06, 3.04, 0.02, -0.57, 1.52, 2.14);
  addLinerBox(1.06, 3.04, 0.02, 2.27, 1.52, 2.14);
  addLinerBox(1.78, 0.82, 0.02, 0.85, 2.63, 2.14);
  addLinerBox(1.82, 2.04, 0.02, -2.02, 1.02, -2.11);

  // Gable triangle liners (back & front)
  for (const gz of [-2.14, 2.14]) {
    const gGeo = new THREE.BufferGeometry();
    gGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array([
      -1.10, 3.04, gz,  2.80, 3.04, gz,  0.85, 5.05, gz
    ]), 3));
    gGeo.computeVertexNormals();
    barnModel.add(new THREE.Mesh(gGeo, linerMat));
  }

  // Warm interior light so the hollow room, hay stack, and cows inside are clearly visible
  const interiorLight = new THREE.PointLight(0xFFE4B5, 1.1, 10);
  interiorLight.position.set(0.85, 3.1, 0);
  barnModel.add(interiorLight);

  // Small stack of hay bales inside the empty room (back-left corner)
  const hayMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color().setRGB(0.8751, 0.5234, 0.0356, THREE.LinearSRGBColorSpace),
    roughness: 0.88
  });
  const ropeMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color().setRGB(0.4762, 0.2195, 0.0119, THREE.LinearSRGBColorSpace),
    roughness: 0.85
  });
  function addInteriorHayBale(bx, by, bz, ry) {
    const bg = new THREE.Group();
    const bale = new THREE.Mesh(new THREE.BoxGeometry(0.76, 0.46, 0.54), hayMat);
    bale.castShadow = true; bale.receiveShadow = true;
    bg.add(bale);
    for (const rx of [-0.20, 0.20]) {
      const strap = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.48, 0.56), ropeMat);
      strap.position.x = rx;
      bg.add(strap);
    }
    bg.position.set(bx, by, bz);
    bg.rotation.y = ry;
    barnModel.add(bg);
  }
  addInteriorHayBale(-0.56, 0.23, -1.66, 0.08);
  addInteriorHayBale(-0.58, 0.23, -1.04, -0.10);
  addInteriorHayBale(-0.57, 0.69, -1.42, 0.16);

  // "Kandang Sapi" sign above the front barn doorway
  const sTex = textTex(label, '#5D4037', '#FFF');
  const sMat = new THREE.MeshStandardMaterial({ map: sTex, transparent: true });
  const sign = new THREE.Mesh(new THREE.PlaneGeometry(1.9, 0.44), sMat);
  sign.position.set(0.85, 2.72, 2.41);
  barnModel.add(sign);

  // Decode and build exact 3D meshes from kandang_sapi.glb
  function populateFromGLBBuffer(buf) {
    const view = new DataView(buf);
    const jsonLen = view.getUint32(12, true);
    const gltf = JSON.parse(new TextDecoder().decode(new Uint8Array(buf, 20, jsonLen)));
    const binStart = 20 + jsonLen + 8;

    const mats = gltf.materials.map(m => {
      const c = m.pbrMetallicRoughness.baseColorFactor;
      const col = new THREE.Color().setRGB(c[0], c[1], c[2], THREE.LinearSRGBColorSpace);
      return new THREE.MeshStandardMaterial({
        name: m.name,
        color: col,
        roughness: m.pbrMetallicRoughness.roughnessFactor ?? 0.8,
        metalness: m.pbrMetallicRoughness.metallicFactor ?? 0.0,
        side: THREE.DoubleSide
      });
    });

    function getAccArray(accIdx) {
      const acc = gltf.accessors[accIdx];
      const bv = gltf.bufferViews[acc.bufferView];
      const byteOffset = binStart + (bv.byteOffset || 0) + (acc.byteOffset || 0);
      const len = acc.count * (acc.type === 'VEC3' ? 3 : 1);
      return acc.componentType === 5126
        ? new Float32Array(buf, byteOffset, len)
        : new Uint16Array(buf, byteOffset, len);
    }

    const roofMats = [];
    const rootNode = gltf.nodes[7];
    for (const childIdx of rootNode.children) {
      const nd = gltf.nodes[childIdx];
      const meshDef = gltf.meshes[nd.mesh];
      const ndGroup = new THREE.Group();
      ndGroup.name = nd.name;
      if (nd.translation) ndGroup.position.fromArray(nd.translation);

      meshDef.primitives.forEach((prim, pIdx) => {
        // Skip prim 0 of dinding_mesh (Kayu_Gelap_Celah solid inner core) so the barn interior is a hollow room
        if (nd.name === 'dinding' && pIdx === 0) return;

        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(getAccArray(prim.attributes.POSITION), 3));
        if (prim.attributes.NORMAL !== undefined) {
          geo.setAttribute('normal', new THREE.BufferAttribute(getAccArray(prim.attributes.NORMAL), 3));
        }
        if (prim.indices !== undefined) {
          geo.setIndex(new THREE.BufferAttribute(getAccArray(prim.indices), 1));
        }
        let mat = mats[prim.material];
        if (nd.name === 'atap') {
          mat = mat.clone();
          roofMats.push(mat);
        }
        const m = new THREE.Mesh(geo, mat);
        m.castShadow = true;
        m.receiveShadow = true;
        ndGroup.add(m);
      });

      // Swing both barn doors wide open outward so the player can walk in and out freely
      if (nd.name === 'pintu_kiri') {
        ndGroup.rotation.y = -Math.PI * 0.65;
      } else if (nd.name === 'pintu_kanan') {
        ndGroup.rotation.y = Math.PI * 0.65;
      }

      barnModel.add(ndGroup);
    }

    roomFloor.onBeforeRender = () => {
      if (!roofMats.length) return;
      const locP = worldToCoopLocal(playerGroup.position.x, playerGroup.position.z, cfg, COW_BARN_ROT_Y);
      const inside = Math.abs(locP.lx) < 2.25 && Math.abs(locP.lz) < 2.55;
      const targetOp = inside ? 0.18 : 1.0;
      for (const rm of roofMats) {
        if (Math.abs(rm.opacity - targetOp) > 0.01) {
          rm.transparent = targetOp < 0.99;
          rm.opacity += (targetOp - rm.opacity) * 0.25;
          rm.needsUpdate = true;
        }
      }
    };
  }

  if (BARN_GLB_GZIP_B64 && !BARN_GLB_GZIP_B64.startsWith('__')) {
    const binStr = atob(BARN_GLB_GZIP_B64);
    const gzBytes = new Uint8Array(binStr.length);
    for (let i = 0; i < binStr.length; i++) gzBytes[i] = binStr.charCodeAt(i);
    new Response(new Blob([gzBytes]).stream().pipeThrough(new DecompressionStream('gzip')))
      .arrayBuffer()
      .then(populateFromGLBBuffer)
      .catch(err => console.error('Gagal memuat kandang_sapi.glb:', err));
  } else {
    fetch('./kandang_sapi.glb')
      .then(r => r.arrayBuffer())
      .then(populateFromGLBBuffer)
      .catch(err => console.error('Gagal memuat kandang_sapi.glb:', err));
  }

  // Wall colliders around the barn perimeter rotated by COW_BARN_ROT_Y around (cfg.x, cfg.z), leaving the front doorway open
  const pushBarnCollider = (lx, lz, radius) => {
    const rot = rotateCoopLocalOffset(lx, lz, COW_BARN_ROT_Y);
    colliders.push({ x: cfg.x + rot.x, z: cfg.z + rot.z, radius });
  };
  const rWall = 0.22;
  // Back wall (including side shed back wall)
  for (let dx = -3.90 * S; dx <= 1.95 * S + 0.01; dx += 0.42) {
    pushBarnCollider(dx, -2.18 * S, rWall);
  }
  // Right wall
  for (let dz = -2.18 * S; dz <= 2.18 * S + 0.01; dz += 0.42) {
    pushBarnCollider(1.95 * S, dz, rWall);
  }
  // Left room wall
  for (let dz = -2.18 * S; dz <= 2.18 * S + 0.01; dz += 0.42) {
    pushBarnCollider(-1.96 * S, dz, rWall);
  }
  // Side lean-to shed outer boundary (trough, crate, exterior hay)
  for (let dz = -2.18 * S; dz <= 2.10 * S + 0.01; dz += 0.50) {
    pushBarnCollider(-3.85 * S, dz, 0.25);
  }
  for (let dx = -3.85 * S; dx <= -2.05 * S; dx += 0.50) {
    pushBarnCollider(dx, 2.05 * S, 0.25);
  }
  // Front wall left of open doorway
  for (let dx = -1.96 * S; dx <= -0.94 * S; dx += 0.36) {
    pushBarnCollider(dx, 2.18 * S, 0.18);
  }
  // Front wall right of open doorway
  for (let dx = 0.94 * S; dx <= 1.96 * S + 0.01; dx += 0.36) {
    pushBarnCollider(dx, 2.18 * S, 0.18);
  }
  // Interior hay stack collider (back-left corner inside room)
  pushBarnCollider(-1.42 * S, -1.40 * S, 0.45);
}
