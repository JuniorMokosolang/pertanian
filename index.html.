    return;
  }
  if (state.coins < up.price) {
    showNotif(`❌ Koin tidak cukup! Butuh ${up.price} coin.`);
    return;
  }
  state.coins -= up.price;
  state.plotUpgradeLevel++;

  if (tierIndex === 0) {
    const p1 = unlockPrebuiltPlot(4);
    const p2 = unlockPrebuiltPlot(5);
    if (p1) emitMutationBatu(p1.position);
    if (p2) emitMutationBatu(p2.position);
  } else if (tierIndex === 1) {
    const p1 = unlockPrebuiltPlot(6);
    const p2 = unlockPrebuiltPlot(7);
    if (p1) emitMutationBatu(p1.position);
    if (p2) emitMutationBatu(p2.position);
  } else if (tierIndex === 2) {
    const p1 = unlockPrebuiltPlot(8);
    const p2 = unlockPrebuiltPlot(9);
    if (p1) emitMutationBatu(p1.position);
    if (p2) emitMutationBatu(p2.position);
  }

  showNotif(`🎉 Upgrade Plot Tahap ${tierIndex + 1} Berhasil! (+${up.plots} plot baru)`);
  refreshHUD();
  refreshUpgradePanel();
  saveGame();
}

