function addXP(amount) {
  if (state.level >= CONFIG.maxLevel) {
    state.xp = CONFIG.xpPerLevel;
    refreshHUD();
    return;
  }
  state.xp += amount;
  while (state.xp >= CONFIG.xpPerLevel && state.level < CONFIG.maxLevel) {
    state.xp -= CONFIG.xpPerLevel;
    state.level++;
    showNotif(`🎉 SELAMAT! Kamu naik ke Level ${state.level}!`);
  }
  if (state.level >= CONFIG.maxLevel) {
    state.xp = CONFIG.xpPerLevel;
  }
  refreshHUD();
  saveGame();
}

