    isTouchDevice = true;
    updateTouchHUDVisibility();
  }
  e.preventDefault();
  if (state.panelOpen || teleportState.active || state.isSleeping) {
    resetTouchCamera();
    return;
  }
  touchCamInertia.velYaw = 0;
  touchCamInertia.velPitch = 0;
  const now = performance.now();
  for (let i = 0; i < e.changedTouches.length; i++) {
    const t = e.changedTouches[i];
    if (t.identifier === mobileInput.joyTouchId || t.identifier === mobileInput.sprintTouchId) continue;
    camTouches.set(t.identifier, {
      x: t.clientX,
      y: t.clientY,
      startX: t.clientX,
      startY: t.clientY,
      startTime: now,
      lastMoveTime: now,
      moved: false
    });
  }
  if (camTouches.size >= 2) {
    const pts = Array.from(camTouches.values());
    pinchStartDist = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
    pinchStartCamDist = cam.tDist;
    pts.forEach(p => { p.moved = true; });
  }
}, { passive: false });

renderer.domElement.addEventListener('touchmove', e => {
  e.preventDefault();
  if (state.panelOpen || teleportState.active || state.isSleeping) return;
  const now = performance.now();
  if (camTouches.size === 1) {
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      const entry = camTouches.get(t.identifier);
      if (!entry) continue;
      const dx = t.clientX - entry.x;
      const dy = t.clientY - entry.y;
      const dtMove = Math.max(0.004, Math.min(0.05, (now - (entry.lastMoveTime || now)) / 1000));
      entry.x = t.clientX;
      entry.y = t.clientY;
      entry.lastMoveTime = now;
      if (Math.hypot(t.clientX - entry.startX, t.clientY - entry.startY) >= TAP_DRAG_THRESHOLD) {
        entry.moved = true;
      }
      const rotSpeed = CONFIG.touchCameraRotateSpeed || 0.0072;
      const dYaw = -dx * rotSpeed;
      const dPitch = dy * (rotSpeed * 0.92);
      cam.tYaw += dYaw;
      cam.tPitch = THREE.MathUtils.clamp(cam.tPitch + dPitch, CONFIG.cameraPitchMin, CONFIG.cameraPitchMax);
      touchCamInertia.velYaw = touchCamInertia.velYaw * 0.35 + (dYaw / dtMove) * 0.65;
      touchCamInertia.velPitch = touchCamInertia.velPitch * 0.35 + (dPitch / dtMove) * 0.65;
      touchCamInertia.lastMoveTime = now;
    }
  } else if (camTouches.size >= 2) {
    touchCamInertia.velYaw = 0;
    touchCamInertia.velPitch = 0;
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      const entry = camTouches.get(t.identifier);
      if (entry) {
        entry.x = t.clientX;
        entry.y = t.clientY;
        entry.lastMoveTime = now;
        entry.moved = true;
      }
    }
    const pts = Array.from(camTouches.values());
    const curDist = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
    if (pinchStartDist > 10 && curDist > 10) {
      const maxD = state.isInsideHouse ? 4.8 : CONFIG.cameraMaxDist;
      const ratio = pinchStartDist / curDist;
      cam.tDist = THREE.MathUtils.clamp(pinchStartCamDist * ratio, CONFIG.cameraMinDist, maxD);
    }
  }
}, { passive: false });

function onCanvasTouchEnd(e, isCancel) {
  e.preventDefault();
  lastTouchEndTime = Date.now();
  const now = performance.now();
  for (let i = 0; i < e.changedTouches.length; i++) {
    const t = e.changedTouches[i];
    const entry = camTouches.get(t.identifier);
    camTouches.delete(t.identifier);
    if (!isCancel && entry && !entry.moved && camTouches.size === 0) {
      const elapsed = now - entry.startTime;
      const tapDrift = Math.hypot(t.clientX - entry.startX, t.clientY - entry.startY);
      if (elapsed < 380 && tapDrift < TAP_DRAG_THRESHOLD && !state.panelOpen && !teleportState.active && !state.isSleeping) {
        touchCamInertia.velYaw = 0;
        touchCamInertia.velPitch = 0;
        doRaycastInteract(t.clientX, t.clientY, true);
      }
    }
  }
  if (camTouches.size === 0) {
    if (isCancel || (now - touchCamInertia.lastMoveTime > 90)) {
      touchCamInertia.velYaw = 0;
      touchCamInertia.velPitch = 0;
    } else {
      touchCamInertia.velYaw = THREE.MathUtils.clamp(touchCamInertia.velYaw, -8.5, 8.5);
      touchCamInertia.velPitch = THREE.MathUtils.clamp(touchCamInertia.velPitch, -5.5, 5.5);
    }
  } else if (camTouches.size === 1) {
    const rem = Array.from(camTouches.values())[0];
    if (rem) {
      rem.moved = true;
      rem.lastMoveTime = now;
    }
    touchCamInertia.velYaw = 0;
    touchCamInertia.velPitch = 0;
  }
  if (camTouches.size < 2) {
    pinchStartDist = 0;
  }
}

renderer.domElement.addEventListener('touchend', e => onCanvasTouchEnd(e, false), { passive: false });
renderer.domElement.addEventListener('touchcancel', e => onCanvasTouchEnd(e, true), { passive: false });

// ==================== COLLISION ====================
function resolveSingleBoxCollider(rx, rz, radius, box) {
  const cx = Math.max(box.minX, Math.min(rx, box.maxX));
  const cz = Math.max(box.minZ, Math.min(rz, box.maxZ));
  const dx = rx - cx;
  const dz = rz - cz;
  const distSq = dx * dx + dz * dz;
  if (distSq < radius * radius) {
    if (distSq > 0.00001) {
      const dist = Math.sqrt(distSq);
      const push = radius - dist;
      rx += (dx / dist) * push;
      rz += (dz / dist) * push;
    } else {
      const dLeft  = Math.abs(rx - box.minX);
      const dRight = Math.abs(box.maxX - rx);
      const dBack  = Math.abs(rz - box.minZ);
      const dFront = Math.abs(box.maxZ - rz);
      const minSide = Math.min(dLeft, dRight, dBack, dFront);
      if (minSide === dLeft) rx = box.minX - radius;
      else if (minSide === dRight) rx = box.maxX + radius;
      else if (minSide === dBack) rz = box.minZ - radius;
      else rz = box.maxZ + radius;
    }
  }
  return { x: rx, z: rz };
}

function resolveCollisions(x, z) {
  let rx = x, rz = z;
  const r = CONFIG.playerRadius;

  if (state.isInsideHouse) {
    // Collision di dalam Interior Rumah:
    // 1. Resolusi terhadap collider kotak perabot besar (TempatTidur, Dapur, MejaMakan, HasilPanen)
    for (let iter = 0; iter < 3; iter++) {
      for (const box of interiorBoxColliders) {
        const res = resolveSingleBoxCollider(rx, rz, r, box);
        rx = res.x;
        rz = res.z;
      }
      // 2. Batasi di dalam dinding ruangan agar player tidak bisa tembus dinding atau jatuh keluar lantai
      rx = THREE.MathUtils.clamp(rx, interiorRoomBounds.minX + r, interiorRoomBounds.maxX - r);
      rz = THREE.MathUtils.clamp(rz, interiorRoomBounds.minZ + r, interiorRoomBounds.maxZ - r);
    }
    return { x: rx, z: rz };
  }

  // Collision di Dunia Luar:
  for (let iter = 0; iter < 3; iter++) {
    for (const box of outdoorBoxColliders) {
      const res = resolveSingleBoxCollider(rx, rz, r, box);
      rx = res.x;
      rz = res.z;
    }
    for (const c of colliders) {
      const dx = rx - c.x, dz = rz - c.z;
      const dist = Math.sqrt(dx * dx + dz * dz);
      const minD = r + c.radius;
      if (dist < minD && dist > 0.001) {
        const f = minD / dist;
        rx = c.x + dx * f; rz = c.z + dz * f;
      }
    }
  }
  const half = CONFIG.mapSize / 2 - 1;
  return { x: THREE.MathUtils.clamp(rx, -half, half), z: THREE.MathUtils.clamp(rz, -half, half) };
}

// ==================== EFFECTS (PARTICLE POOL) ====================
const POOL_SIZE = 160;
const particlePool = [];
const pGeoBox = new THREE.BoxGeometry(0.08, 0.08, 0.08);

for (let i = 0; i < POOL_SIZE; i++) {
  const pMat = new THREE.MeshBasicMaterial({ color: 0xFFFFFF });
  const pMesh = new THREE.Mesh(pGeoBox, pMat);
  pMesh.visible = false;
  scene.add(pMesh);
  particlePool.push({
    mesh: pMesh,
    active: false,
    vel: new THREE.Vector3(),
    life: 0,
    maxLife: 1,
    gravity: -9.8
  });
}

function spawnParticle(x, y, z, vx, vy, vz, colorHex, maxLife = 0.8, grav = -9.8, sc = 1) {
  if (window.graphicsConfig && typeof window.graphicsConfig.particleDensity === 'number') {
    if (window.graphicsConfig.particleDensity <= 0.05) return null;
    if (window.graphicsConfig.particleDensity < 0.99 && Math.random() > window.graphicsConfig.particleDensity) return null;
  }
  for (const p of particlePool) {
    if (!p.active) {
      p.active = true;
      p.mesh.visible = true;
      p.mesh.position.set(x, y, z);
      p.mesh.scale.set(sc, sc, sc);
      p.mesh.material.color.setHex(colorHex);
      p.vel.set(vx, vy, vz);
      p.life = 0;
      p.maxLife = maxLife;
      p.gravity = grav;
      return p;
    }
  }
  return null;
}

function emitWaterSplash(pos) {
  for (let i = 0; i < 20; i++) {
    const ang = Math.random() * Math.PI * 2;
    const spd = 0.8 + Math.random() * 1.5;
    spawnParticle(
      pos.x + (Math.random() - 0.5) * 0.4,
      pos.y + 0.15,
      pos.z + (Math.random() - 0.5) * 0.4,
      Math.cos(ang) * spd,
      2.5 + Math.random() * 2.0,
      Math.sin(ang) * spd,
      0x40C4FF,
      0.6 + Math.random() * 0.4,
      -12,
      1.1
    );
  }
}

function emitMutationRainbow(pos) {
  const colors = [0xFF1744, 0xFF9100, 0xFFEA00, 0x00E676, 0x00E5FF, 0xD500F9];
  for (let i = 0; i < 50; i++) {
    const ang = Math.random() * Math.PI * 2;
    const spd = 1.2 + Math.random() * 2.5;
    const c = colors[i % colors.length];
    spawnParticle(
      pos.x, pos.y + 0.4, pos.z,
      Math.cos(ang) * spd,
      3.0 + Math.random() * 3.5,
      Math.sin(ang) * spd,
      c,
      1.0 + Math.random() * 0.6,
      -8,
      1.4
    );
  }
}

function emitMutationPetir(pos) {
