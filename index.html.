// 3a. Konfigurasi 4 jalur jalan setapak ("jalan_setapak.glb", lebar asli 2.08 unit -> setengah lebar = 1.04 unit):
// - Jalur induk membentang utuh, sedangkan jalur cabang berhenti tepat menyentuh tepi luar jalur induk (dikurangi 1.04 unit)
//   agar ujung dua jalur tidak saling menumpuk di tengah persimpangan.
// - Skala vertikal dipipihkan (scaleY = 0.40) dan posisi vertikal direndahkan (yPos = 0.004) agar rata menyatu dengan rumput.
const PATH_HALF_W = 1.04;
const pathRoutesConfig = [
  // 1. Jalur Induk Horizontal Utara: dari depan tangga Kandang Ayam (-7.6, -2.0) membentang utuh ke depan tangga teras Rumah (1.04, -2.0)
  { id: 'induk_ayam_rumah', priority: 1, x1: -7.6, z1: -2.0, x2: 1.04, z2: -2.0, lebarJalur: 2.08, scaleY: 0.40, yPos: 0.004 },
  // 2. Jalur Induk Horizontal Selatan: membentang utuh di depan 4 Toko (-15.0, 15.0 s/d 15.0, 15.0)
  { id: 'induk_empat_toko', priority: 1, x1: -15.0, z1: 15.0, x2: 15.0, z2: 15.0, lebarJalur: 2.08, scaleY: 0.40, yPos: 0.004 },
  // 3. Jalur Penghubung Vertikal (Rumah ke Toko): berhenti tepat di tepi luar Jalur Induk Rumah (z = -2.0 + 1.04 = -0.96)
  //    dan tepi luar Jalur Induk Toko (z = 15.0 - 1.04 = 13.96)
  { id: 'cabang_rumah_toko', priority: 2, x1: 0.0, z1: -2.0 + PATH_HALF_W, x2: 0.0, z2: 15.0 - PATH_HALF_W, lebarJalur: 2.08, scaleY: 0.40, yPos: 0.0038 },
  // 4. Jalur Cabang Kandang Sapi: dari depan pintu masuk Kandang Sapi (-10.3, 7.2) berhenti tepat di tepi barat Jalur Penghubung (x = 0.0 - 1.04 = -1.04)
  { id: 'cabang_kandang_sapi', priority: 3, x1: -10.3, z1: 7.2, x2: 0.0 - PATH_HALF_W, z2: 7.2, lebarJalur: 2.08, scaleY: 0.40, yPos: 0.0036 }
];

function addPath(x, z, w, d, yOffset = 0.004) {
  const alongX = w > d;
  if (!alongX) {
    pathRoutesConfig.push({ id: 'extra_z', priority: 3, x1: x, z1: z - d / 2, x2: x, z2: z + d / 2, lebarJalur: w, scaleY: 0.40, yPos: yOffset });
  } else {
    pathRoutesConfig.push({ id: 'extra_x', priority: 3, x1: x - w / 2, z1: z, x2: x + w / 2, z2: z, lebarJalur: d, scaleY: 0.40, yPos: yOffset });
  }
}

(function loadJalanSetapakGLB() {
  const NATIVE_W = 2.08;
  const NATIVE_L = 11.84;

  // 1. Traverse seluruh child di dalam "jalan_setapak.glb" & pastikan material "Mat_JalanSetapak_VertexColor" tampil jelas
  function sanitizeJalanSetapakModel(rootObj) {
    rootObj.visible = true;
    rootObj.traverse((child) => {
      child.visible = true;
      child.frustumCulled = false;
      if (child.isMesh) {
        child.castShadow = true;
        child.receiveShadow = true;
        // Konversi atribut COLOR_0 VEC4 menjadi VEC3 RGB agar kompatibel penuh dengan MeshStandardMaterial r160
        if (child.geometry && child.geometry.attributes && child.geometry.attributes.color) {
          const colAttr = child.geometry.attributes.color;
          if (colAttr.itemSize === 4) {
            const count = colAttr.count;
            const rgb = new Float32Array(count * 3);
            for (let i = 0; i < count; i++) {
              rgb[i * 3]     = colAttr.getX(i);
              rgb[i * 3 + 1] = colAttr.getY(i);
              rgb[i * 3 + 2] = colAttr.getZ(i);
            }
            child.geometry.setAttribute('color', new THREE.BufferAttribute(rgb, 3));
          }
        }
        const hasVertexColor = !!(child.geometry && child.geometry.attributes && child.geometry.attributes.color);
        if (child.material) {
          const mats = Array.isArray(child.material) ? child.material : [child.material];
          mats.forEach((mat) => {
            if (!mat) return;
            mat.name = 'Mat_JalanSetapak_VertexColor';
            mat.visible = true;
            mat.transparent = false;
            mat.opacity = 1.0;
            mat.colorWrite = true;
            mat.depthWrite = true;
            mat.depthTest = true;
            mat.vertexColors = hasVertexColor;
            mat.side = THREE.DoubleSide;
            if (typeof mat.roughness === 'number') MAT_JALAN_SETAPAK_SYNC.roughness = mat.roughness;
            if (typeof mat.metalness === 'number') MAT_JALAN_SETAPAK_SYNC.metalness = mat.metalness;
            mat.needsUpdate = true;
          });
        }
        if (hasVertexColor) {
          MAT_JALAN_SETAPAK_SYNC.name = 'Mat_JalanSetapak_VertexColor';
          MAT_JALAN_SETAPAK_SYNC.visible = true;
          MAT_JALAN_SETAPAK_SYNC.transparent = false;
          MAT_JALAN_SETAPAK_SYNC.opacity = 1.0;
          MAT_JALAN_SETAPAK_SYNC.colorWrite = true;
          MAT_JALAN_SETAPAK_SYNC.depthWrite = true;
          MAT_JALAN_SETAPAK_SYNC.depthTest = true;
          MAT_JALAN_SETAPAK_SYNC.vertexColors = true;
          MAT_JALAN_SETAPAK_SYNC.side = THREE.DoubleSide;
          MAT_JALAN_SETAPAK_SYNC.needsUpdate = true;
          child.material = MAT_JALAN_SETAPAK_SYNC;
        }
      }
    });
  }

  // 2 & 3a. Penempatan segmen "jalan_setapak.glb" dengan scale.y pipih (0.40) & position.y rendah (0.0036 - 0.004)
  function placePathRouteSegments(templateRoot, routeCfg, placedSegmentsOut) {
    const { id, priority, x1, z1, x2, z2, lebarJalur = NATIVE_W, scaleY = 0.40, yPos = 0.004 } = routeCfg;
    const dx = x2 - x1;
    const dz = z2 - z1;
    const isHorizontal = Math.abs(dx) > Math.abs(dz);
    const totalLen = isHorizontal ? Math.abs(dx) : Math.abs(dz);
    const numTiles = Math.max(1, Math.round(totalLen / NATIVE_L));
    const tileLen = totalLen / numTiles;

    if (!isHorizontal) {
      // Jalur searah sumbu Z (rotation.y = 0)
      const minZ = Math.min(z1, z2);
      const midX = (x1 + x2) * 0.5;
      for (let i = 0; i < numTiles; i++) {
        const segClone = templateRoot.clone(true);
        sanitizeJalanSetapakModel(segClone);
        const tileCenterZ = minZ + (i + 0.5) * tileLen;
        segClone.position.set(midX, yPos, tileCenterZ);
        segClone.rotation.set(0, 0, 0);
        segClone.scale.set(lebarJalur / NATIVE_W, scaleY, tileLen / NATIVE_L);
        segClone.userData = { routeId: id, priority: priority, segUID: id + '_tile_' + i };
        segClone.updateMatrixWorld(true);
        pathGroup.add(segClone);
        placedSegmentsOut.push(segClone);
      }
    } else {
      // Jalur melintang searah sumbu X (rotation.y = Math.PI / 2)
      const minX = Math.min(x1, x2);
      const midZ = (z1 + z2) * 0.5;
      for (let i = 0; i < numTiles; i++) {
        const segClone = templateRoot.clone(true);
        sanitizeJalanSetapakModel(segClone);
        const tileCenterX = minX + (i + 0.5) * tileLen;
        segClone.position.set(tileCenterX, yPos, midZ);
        segClone.rotation.set(0, Math.PI / 2, 0);
        segClone.scale.set(lebarJalur / NATIVE_W, scaleY, tileLen / NATIVE_L);
        segClone.userData = { routeId: id, priority: priority, segUID: id + '_tile_' + i };
        segClone.updateMatrixWorld(true);
        pathGroup.add(segClone);
        placedSegmentsOut.push(segClone);
      }
    }
  }

  // 3b. Filter otomatis node "batu_pijak_*" dan "kerikil_*" yang terlalu dekat (< 0.65 unit) di area persimpangan / sambungan
  function filterOverlappingPathStones(placedSegments) {
    pathGroup.updateMatrixWorld(true);

    // Urutkan segmen berdasarkan prioritas (Jalur Induk dievaluasi lebih dulu agar batunya dipertahankan,
    // sedangkan batu pada segmen cabang yang terlalu dekat / bertabrakan disembunyikan)
    const sortedSegs = placedSegments.slice().sort((a, b) => (a.userData.priority || 99) - (b.userData.priority || 99));
    const acceptedStones = [];
    const acceptedPebbles = [];
    const tmpWorldPos = new THREE.Vector3();
    const MIN_STONE_DIST = 0.65;

    for (let s = 0; s < sortedSegs.length; s++) {
      const seg = sortedSegs[s];
      const segUID = seg.userData.segUID;

      seg.traverse((node) => {
        if (!node.name) return;

        if (node.name.startsWith('batu_pijak_')) {
          node.updateWorldMatrix(true, false);
          node.getWorldPosition(tmpWorldPos);

          let isColliding = false;
          for (let j = 0; j < acceptedStones.length; j++) {
            const other = acceptedStones[j];
            if (other.segUID === segUID) continue; // Hanya filter antar segmen yang berbeda di persimpangan/sambungan
            const distXZ = Math.hypot(tmpWorldPos.x - other.x, tmpWorldPos.z - other.z);
            if (distXZ < MIN_STONE_DIST) {
              isColliding = true;
              break;
            }
          }

          if (isColliding) {
            node.visible = false;
          } else {
            node.visible = true;
            acceptedStones.push({ x: tmpWorldPos.x, z: tmpWorldPos.z, segUID: segUID });
          }
        } else if (node.name.startsWith('kerikil_')) {
          node.updateWorldMatrix(true, false);
          node.getWorldPosition(tmpWorldPos);
          if (node.geometry) {
            if (!node.geometry.boundingBox) node.geometry.computeBoundingBox();
            if (node.geometry.boundingBox) {
              node.geometry.boundingBox.getCenter(tmpWorldPos);
              node.localToWorld(tmpWorldPos);
            }
          }

          let pebbleCollide = false;
          for (let j = 0; j < acceptedPebbles.length; j++) {
            const otherP = acceptedPebbles[j];
            if (otherP.segUID === segUID) continue;
            const distXZ = Math.hypot(tmpWorldPos.x - otherP.x, tmpWorldPos.z - otherP.z);
            if (distXZ < 0.65) {
              pebbleCollide = true;
              break;
            }
          }

          if (pebbleCollide) {
            node.visible = false;
          } else {
            node.visible = true;
            acceptedPebbles.push({ x: tmpWorldPos.x, z: tmpWorldPos.z, segUID: segUID });
          }
        }
      });
    }
  }

  function buildAllJalanSetapak(templateRoot) {
    // Hapus seluruh mesh jalan setapak lama menggunakan parent.remove()
    while (oldPathMeshes.length > 0) {
      const oldMesh = oldPathMeshes.pop();
      if (oldMesh && oldMesh.parent) {
        oldMesh.parent.remove(oldMesh);
      }
    }
    while (pathGroup.children.length > 0) {
      const oldChild = pathGroup.children[0];
      if (oldChild.parent) oldChild.parent.remove(oldChild);
    }
    pathGroup.visible = true;
    sanitizeJalanSetapakModel(templateRoot);

    const placedSegments = [];
    for (let i = 0; i < pathRoutesConfig.length; i++) {
      placePathRouteSegments(templateRoot, pathRoutesConfig[i], placedSegments);
    }

    // Rapikan batu pijak & kerikil di seluruh persimpangan setelah semua segmen terpasang
    filterOverlappingPathStones(placedSegments);
  }

  // Template sinkron sesuai hirarki node asli "jalan_setapak.glb":
  // root node "jalan_setapak" -> "dasar_tanah", "kerikil" -> "kerikil_01" s/d "kerikil_04",
  // serta 40 node batu terpisah "batu_pijak_01" s/d "batu_pijak_40" pada koordinat asli GLB
  function createSyncJalanSetapakTemplate() {
    const root = new THREE.Group();
    root.name = 'jalan_setapak';

    function paintGeometryVertexColors(geo, baseR, baseG, baseB, varAmt) {
      const nonIndexed = geo.index ? geo.toNonIndexed() : geo;
      const pos = nonIndexed.attributes.position;
      const count = pos.count;
      const colors = new Float32Array(count * 3);
      for (let i = 0; i < count; i++) {
        const vx = pos.getX(i), vy = pos.getY(i), vz = pos.getZ(i);
        const n = Math.sin(vx * 12.7 + vz * 7.3 + vy * 19.1) * varAmt;
        const topBoost = vy > 0.04 ? 0.05 : -0.03;
        colors[i * 3]     = Math.min(1, Math.max(0, baseR + n + topBoost));
        colors[i * 3 + 1] = Math.min(1, Math.max(0, baseG + n * 0.9 + topBoost));
        colors[i * 3 + 2] = Math.min(1, Math.max(0, baseB + n * 0.8 + topBoost));
      }
      nonIndexed.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      nonIndexed.computeVertexNormals();
      return nonIndexed;
    }

    // 1. "dasar_tanah" (-1.04..+1.04 x 0.0..0.0199 x -5.92..+5.92)
    const tanahGeo = paintGeometryVertexColors(new THREE.BoxGeometry(2.08, 0.0199, 11.84, 8, 1, 24), 0.54, 0.41, 0.28, 0.04);
    tanahGeo.translate(0, 0.010, 0);
    const dasarTanah = new THREE.Mesh(tanahGeo, MAT_JALAN_SETAPAK_SYNC);
    dasarTanah.name = 'dasar_tanah';
    root.add(dasarTanah);

    // 2. 40 batu pijak terpisah "batu_pijak_01" s/d "batu_pijak_40" sesuai posisi node di dalam "jalan_setapak.glb"
    const stoneCoords = [
