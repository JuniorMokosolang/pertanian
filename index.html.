});
MAT_JALAN_SETAPAK_SYNC.visible = true;
MAT_JALAN_SETAPAK_SYNC.transparent = false;
MAT_JALAN_SETAPAK_SYNC.opacity = 1.0;
MAT_JALAN_SETAPAK_SYNC.alphaTest = 0;
MAT_JALAN_SETAPAK_SYNC.colorWrite = true;
MAT_JALAN_SETAPAK_SYNC.depthWrite = true;
MAT_JALAN_SETAPAK_SYNC.depthTest = true;

// 1. Hapus model jalan setapak sebelumnya dari scene menggunakan parent.remove() & buat pathGroup di scene utama
const oldPathMeshes = [];
if (typeof jalanSetapakRootGroup !== 'undefined' && jalanSetapakRootGroup && jalanSetapakRootGroup.parent) {
  jalanSetapakRootGroup.parent.remove(jalanSetapakRootGroup);
}
const pathGroup = new THREE.Group();
pathGroup.name = 'pathGroup';
pathGroup.visible = true;
