// ==================== INTERACTION ====================
const raycaster = new THREE.Raycaster();
const mouse2D = new THREE.Vector2();
let hoveredObj = null;
let hoveredMatRef = null;
let hoveredOrigEmissive = 0;

function findInteractable(mesh) {
  for (const ia of interactables) {
    if (ia.mesh === mesh) return ia;
    if (ia.group) {
      let found = false;
      ia.group.traverse(c => { if (c === mesh) found = true; });
      if (found) return ia;
    }
  }
  return null;
}

function doRaycastInteract(cx, cy, fromMobileTap = false) {
  if (teleportState.active || state.isSleeping) return;
  mouse2D.x = (cx / window.innerWidth) * 2 - 1;
  mouse2D.y = -(cy / window.innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouse2D, camera);
  const hits = raycaster.intersectObjects(scene.children, true);
  for (const hit of hits) {
    let isPlayer = false;
    playerGroup.traverse(c => { if (c === hit.object) isPlayer = true; });
    if (isPlayer) continue;

    const ia = findInteractable(hit.object);
    if (ia) {
      if (ia.type === 'bed') {
        if (!state.isInsideHouse) continue;
        const baseBedDist = CONFIG.bedInteractDistance || 2.5;
        const maxBedDist = fromMobileTap ? baseBedDist + 0.8 : baseBedDist;
        const dBed = getDistToInteriorBed(playerGroup.position);
        if (dBed > maxBedDist) {
          if (fromMobileTap && dBed <= 18) {
            const tp = (ia.position || hit.point).clone();
            mobileAutoTarget = { ia, targetPos: tp, maxDist: maxBedDist, isBed: true, stuckTime: 0, lastDist: dBed };
          } else {
            showNotif('🛏️ Dekati kasur terlebih dahulu untuk tidur!');
          }
        } else {
          mobileAutoTarget = null;
          handleInteract(ia, { fromMobileTap });
        }
        return;
      }
      const d = distXZ(playerGroup.position, ia.position);
      const baseMaxDist = ia.type === 'houseDoorOut' ? ZONA_PINTU_LUAR.radius
                        : ia.type === 'houseDoorIn'  ? ZONA_PINTU_DALAM.radius
                        : CONFIG.interactDistance;
      const maxDist = fromMobileTap ? baseMaxDist + 1.0 : baseMaxDist;
      if (d > maxDist) {
        if (fromMobileTap && d <= 22) {
          const tp = (ia.position || hit.point).clone();
          mobileAutoTarget = { ia, targetPos: tp, maxDist, isBed: false, stuckTime: 0, lastDist: d };
        } else {
          showNotif('❌ Terlalu jauh!');
        }
      } else {
        mobileAutoTarget = null;
        handleInteract(ia, { fromMobileTap });
      }
      return;
    }
  }
}

function interactNearest() {
  if (teleportState.active || state.isSleeping) return;

  // Cek apakah player berada di Zona Pintu Luar (untuk masuk) atau di dalam rumah (Pintu Dalam / Kasur TempatTidur)
  const p = playerGroup.position;
  if (!state.isInsideHouse) {
    const distOut = Math.hypot(p.x - ZONA_PINTU_LUAR.x, p.z - ZONA_PINTU_LUAR.z);
    if (distOut <= ZONA_PINTU_LUAR.radius) {
      TeleportDenganTransisi('masuk');
      return;
    }
  } else {
    const distIn = Math.hypot(p.x - ZONA_PINTU_DALAM.x, p.z - ZONA_PINTU_DALAM.z);
    if (distIn <= ZONA_PINTU_DALAM.radius) {
      TeleportDenganTransisi('keluar');
      return;
    }
    const distBed = getDistToInteriorBed(p);
    if (distBed <= (CONFIG.bedInteractDistance || 2.5)) {
      startSleepSequence();
      return;
    }
  }

  let nearest = null, nearDist = CONFIG.interactDistance + 1;
  for (const ia of interactables) {
    if (ia.type === 'bed') continue;
    const d = distXZ(playerGroup.position, ia.position);
    if (d < nearDist) { nearDist = d; nearest = ia; }
  }
  if (nearest) {
    if (nearDist > CONFIG.interactDistance) showNotif('❌ Terlalu jauh!');
    else handleInteract(nearest);
  }
}

function handleInteract(ia, opts = {}) {
  if (teleportState.active || state.isSleeping) return;
  const fromMobileTap = Boolean(opts && opts.fromMobileTap);
  const heldItems = getHotbarItems();
  const held = (state.hotbarSelected >= 0 && state.hotbarSelected < heldItems.length)
    ? heldItems[state.hotbarSelected]
    : state.activeItem;

  switch (ia.type) {
    case 'houseDoorOut':
      TeleportDenganTransisi('masuk');
      break;

    case 'houseDoorIn':
      TeleportDenganTransisi('keluar');
      break;

    case 'bed':
      startSleepSequence();
      break;

    case 'well':
      fillWater();
      break;

    case 'shop':
      if (ia.shopType === 'bibit') openShopBibit();
      else if (ia.shopType === 'jualTan') openShopJualTanaman();
      else if (ia.shopType === 'hewan') openShopHewan();
      else if (ia.shopType === 'jualTer') openShopJualTernak();
      break;

    case 'plot': {
      const plot = ia.data;
      if (plot.state === 'empty') {
        if (held && held.type === 'seed') {
          plantCrop(plot, held.id);
        } else if (fromMobileTap) {
          const autoSeedKey = Object.keys(CONFIG.crops).find(k => (state.inventory.bibit[k] || 0) > 0);
          if (autoSeedKey) {
            plantCrop(plot, autoSeedKey);
          } else {
            showNotif('🌱 Bibit habis! Beli bibit dulu di Toko Bibit.');
          }
        } else {
          showNotif('🌱 Pilih Bibit dari 🎒 Inventaris (Tombol I) untuk menanam di plot ini!');
        }
      } else if (plot.state === 'planted') {
        if (!plot.watered) {
          if ((held && held.id === 'ember') || fromMobileTap) {
            waterPlot(plot);
          } else {
            showNotif('💧 Tanaman butuh disiram! Gunakan Ember (Tombol 1) untuk menyiram.');
          }
        } else {
          if (plot.mature) {
            if ((held && held.id === 'cangkul') || fromMobileTap) {
              harvestCrop(plot);
            } else {
              showNotif('⛏️ Gunakan Cangkul (Tombol 2) untuk memanen tanaman matang!');
            }
          } else {
            const remSec = Math.max(1, Math.ceil((CONFIG.crops[plot.crop]?.growTime || 0) - plot.timer));
            showNotif(`⏳ Tanaman sedang tumbuh... (${CONFIG.crops[plot.crop].name} - ${remSec}s lagi)`);
          }
        }
      }
      break;
    }

    case 'animal':
      feedAnimal(ia.data);
      break;

    case 'productBox':
      collectFromBox(ia.boxType);
      break;

    default:
      showNotif('Tidak bisa berinteraksi');
  }
}

function updateHover() {
  mouse2D.x = (mouseX / window.innerWidth) * 2 - 1;
  mouse2D.y = -(mouseY / window.innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouse2D, camera);

  if (hoveredMatRef) {
    hoveredMatRef.emissive.setHex(hoveredOrigEmissive);
    hoveredObj = null; hoveredMatRef = null;
  }

  const hintEl = document.getElementById('interact-hint');
  hintEl.style.display = 'none';

  const hits = raycaster.intersectObjects(scene.children, true);
  for (const hit of hits) {
    let isPlayer = false;
    playerGroup.traverse(c => { if (c === hit.object) isPlayer = true; });
    if (isPlayer) continue;

    const ia = findInteractable(hit.object);
    if (ia) {
      const mat = hit.object.material;
      if (mat && mat.emissive) {
        hoveredOrigEmissive = mat.emissive.getHex();
        mat.emissive.setHex(0x444444);
        hoveredObj = hit.object;
        hoveredMatRef = mat;
      }
      hintEl.style.display = 'block';
      const d = distXZ(playerGroup.position, ia.position);
      if (ia.type === 'houseDoorOut') {
        hintEl.textContent = d <= ZONA_PINTU_LUAR.radius
          ? 'Tekan E untuk masuk'
          : '❌ Terlalu jauh dari pintu masuk';
      } else if (ia.type === 'houseDoorIn') {
        hintEl.textContent = d <= ZONA_PINTU_DALAM.radius
          ? 'Tekan E untuk keluar'
          : '❌ Terlalu jauh dari pintu keluar';
      } else if (ia.type === 'bed') {
        const dBed = getDistToInteriorBed(playerGroup.position);
        hintEl.textContent = dBed <= (CONFIG.bedInteractDistance || 2.5)
          ? '🛏️ Tidur [Klik / E] (Skip +5 Menit)'
          : '❌ Dekati kasur untuk tidur';
      } else if (ia.type === 'productBox') {
        const bCount = state.boxStorage?.[ia.boxType] || 0;
        const bItem = ia.boxType === 'telur' ? 'Telur' : 'Susu';
        hintEl.textContent = d <= CONFIG.interactDistance
          ? `Tekan E / Klik untuk ambil (${bItem} ${bCount}/${MAX_BOX_CAPACITY})`
          : '❌ Terlalu jauh';
      } else if (ia.type === 'plot' && ia.data) {
        const pl = ia.data;
        if (d > CONFIG.interactDistance) {
          hintEl.textContent = '❌ Terlalu jauh';
        } else if (pl.state === 'empty') {
          hintEl.textContent = '🌱 Plot Kosong — Klik atau tekan E untuk menanam';
        } else if (!pl.watered) {
          hintEl.textContent = `💧 ${CONFIG.crops[pl.crop]?.name || 'Tanaman'} belum disiram — Gunakan Ember`;
        } else if (pl.mature) {
          hintEl.textContent = `🌟 ${CONFIG.crops[pl.crop]?.name || 'Tanaman'} Siap Panen! (100%) — Gunakan Cangkul`;
        } else {
          const totalT = CONFIG.crops[pl.crop]?.growTime || 1;
          const remT = Math.max(1, Math.ceil(totalT - pl.timer));
          const pct = Math.min(99, Math.floor((pl.timer / totalT) * 100));
          hintEl.textContent = `⏳ ${CONFIG.crops[pl.crop]?.name || 'Tanaman'} tumbuh ${pct}% (${remT}s lagi)`;
        }
      } else if (ia.type === 'animal' && ia.data) {
        const an = ia.data;
        const anName = an.type === 'ayam' ? 'Ayam' : 'Sapi';
        if (d > CONFIG.interactDistance) {
          hintEl.textContent = '❌ Terlalu jauh';
        } else if (an.producing) {
          const remT = Math.max(1, Math.ceil(an.productTimer));
          hintEl.textContent = `⏳ ${anName} sedang produksi (${remT}s lagi)`;
        } else {
          hintEl.textContent = `🌾 Klik atau tekan E untuk beri makan ${anName}`;
        }
      } else {
        hintEl.textContent = d <= CONFIG.interactDistance
          ? 'Klik atau tekan E untuk berinteraksi'
          : '❌ Terlalu jauh';
      }
      break;
    }
  }
}

// ==================== GAME LOOP ====================
let lastTime = performance.now();
const _fwd = new THREE.Vector3();
const _right = new THREE.Vector3();
const _moveDir = new THREE.Vector3();
const _upVec = new THREE.Vector3(0, 1, 0);
let currentGroundY = 0;
let targetGroundY = 0;
let walkBobOffset = 0;

function updatePlayer(dt) {
  _moveDir.set(0, 0, 0);
  camera.getWorldDirection(_fwd);
  _fwd.y = 0; _fwd.normalize();
  _right.crossVectors(_fwd, _upVec).normalize();

  const hasKeyMove = Boolean(
    keys['KeyW'] || keys['ArrowUp'] || keys['KeyS'] || keys['ArrowDown'] ||
    keys['KeyA'] || keys['ArrowLeft'] || keys['KeyD'] || keys['ArrowRight']
  );
  const hasJoyMove = (mobileInput.strength > 0.01) && (Math.abs(mobileInput.moveX) > 0.001 || Math.abs(mobileInput.moveY) > 0.001);

  if (hasKeyMove || hasJoyMove) {
    mobileAutoTarget = null;
  }

  if (keys['KeyW'] || keys['ArrowUp']) _moveDir.add(_fwd);
  if (keys['KeyS'] || keys['ArrowDown']) _moveDir.sub(_fwd);
  if (keys['KeyA'] || keys['ArrowLeft']) _moveDir.sub(_right);
  if (keys['KeyD'] || keys['ArrowRight']) _moveDir.add(_right);

  if (hasJoyMove) {
    _moveDir.addScaledVector(_fwd, -mobileInput.moveY);
    _moveDir.addScaledVector(_right, mobileInput.moveX);
  } else if (!hasKeyMove && mobileAutoTarget) {
    const tgtPos = (mobileAutoTarget.ia && mobileAutoTarget.ia.data && mobileAutoTarget.ia.data.group)
      ? mobileAutoTarget.ia.data.group.position
      : mobileAutoTarget.targetPos;
    const curDist = mobileAutoTarget.isBed
      ? getDistToInteriorBed(playerGroup.position)
      : distXZ(playerGroup.position, tgtPos);
    if (curDist <= mobileAutoTarget.maxDist) {
      const pendingIa = mobileAutoTarget.ia;
      mobileAutoTarget = null;
      handleInteract(pendingIa, { fromMobileTap: true });
    } else {
      _moveDir.set(tgtPos.x - playerGroup.position.x, 0, tgtPos.z - playerGroup.position.z);
      if (Math.abs(mobileAutoTarget.lastDist - curDist) < 0.015) {
        mobileAutoTarget.stuckTime += dt;
        if (mobileAutoTarget.stuckTime > 1.1) {
          mobileAutoTarget = null;
          _moveDir.set(0, 0, 0);
          showNotif('🚧 Jalan terhalang, dekati objek secara manual.');
        }
      } else {
        mobileAutoTarget.stuckTime = 0;
        mobileAutoTarget.lastDist = curDist;
      }
    }
  }

  const prevX = playerGroup.position.x;
  const prevZ = playerGroup.position.z;

  if (_moveDir.lengthSq() > 0.001) {
    _moveDir.normalize();
    const running = Boolean(
      keys['ShiftLeft'] || keys['ShiftRight'] ||
      mobileInput.sprint ||
      (!hasKeyMove && !hasJoyMove && mobileAutoTarget && mobileAutoTarget.lastDist > 5)
    );
    const spd = running ? CONFIG.playerRunSpeed : CONFIG.playerSpeed;
    const nx = prevX + _moveDir.x * spd * dt;
    const nz = prevZ + _moveDir.z * spd * dt;
    const res = resolveCollisions(nx, nz);
    playerGroup.position.x = res.x;
    playerGroup.position.z = res.z;

    const actualDist = Math.hypot(res.x - prevX, res.z - prevZ);
    currentMoveSpeed = dt > 0.0001 ? (actualDist / dt) : spd;
    isRunningState = running;

    const tAngle = Math.atan2(_moveDir.x, _moveDir.z);
    _turnEuler.set(0, tAngle, 0, 'XYZ');
    _turnTargetQuat.setFromEuler(_turnEuler);
    const turnAlpha = 1 - Math.exp(-dt * PLAYER_TURN_SLERP_SPEED);
    playerBodyGroup.quaternion.slerp(_turnTargetQuat, turnAlpha);

    walkPhase += spd * dt * 5;
    isMoving = true;
  } else {
    currentMoveSpeed = 0;
    isRunningState = false;
    isMoving = false;
  }

  // Deteksi ketinggian pijakan dinamis (anak tangga kecil & lantai kayu teras di depan pintu rumah)
  targetGroundY = state.isInsideHouse
    ? (INTERIOR_ORIGIN.y || 0)
    : getSurfaceHeight(playerGroup.position.x, playerGroup.position.z);
  currentGroundY += (targetGroundY - currentGroundY) * 0.3;
  if (Math.abs(targetGroundY - currentGroundY) < 0.0005) {
    currentGroundY = targetGroundY;
  }
  walkBobOffset = isMoving ? Math.abs(Math.sin(walkPhase)) * 0.014 : 0;
  playerGroup.position.y = currentGroundY + walkBobOffset;

  perbaruiAnimasiKarakter(dt, currentMoveSpeed, isRunningState);
}

