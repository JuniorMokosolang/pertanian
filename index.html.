function createCropMesh(cropType) {
  const g = new THREE.Group();
  const leafMat = CROP_MATS.leaf;
  const glowMat = CROP_MATS.glow;

  if (cropType === 'wortel') {
    const root = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.4, 6), CROP_MATS.wortel);
    root.rotation.x = Math.PI; root.position.y = 0.20; g.add(root);
    for (let i = 0; i < 5; i++) {
      const leaf = new THREE.Mesh(new THREE.ConeGeometry(0.04, 0.35, 4), leafMat);
      const ang = (i / 5) * Math.PI * 2;
      leaf.position.set(Math.cos(ang) * 0.06, 0.42, Math.sin(ang) * 0.06);
      leaf.rotation.z = 0.35; leaf.rotation.y = ang; g.add(leaf);
    }
  } else if (cropType === 'gandum') {
    for (let i = 0; i < 6; i++) {
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.6, 4), leafMat);
      const ang = (i / 6) * Math.PI * 2;
      stem.position.set(Math.cos(ang) * 0.08, 0.3, Math.sin(ang) * 0.08);
      stem.rotation.z = ((i % 3) - 1) * 0.06; g.add(stem);
      const head = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.25, 5), CROP_MATS.gandum);
      head.position.set(stem.position.x, 0.65, stem.position.z); g.add(head);
    }
  } else if (cropType === 'jagung') {
    const cornStalk = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.05, 0.9, 6), leafMat);
    cornStalk.position.y = 0.45; g.add(cornStalk);
    for (let i = 0; i < 2; i++) {
      const cob = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.035, 0.22, 6), CROP_MATS.jagung);
      cob.position.set(i === 0 ? 0.09 : -0.09, 0.4 + i * 0.2, 0);
      cob.rotation.z = i === 0 ? -0.4 : 0.4; g.add(cob);
    }
    for (let i = 0; i < 4; i++) {
      const leaf = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.02, 0.08), leafMat);
      leaf.position.set(0, 0.3 + i * 0.15, 0); leaf.rotation.y = (i * Math.PI) / 2; leaf.rotation.z = 0.2; g.add(leaf);
    }
  } else if (cropType === 'kentang') {
    for (let i = 0; i < 5; i++) {
      const b = new THREE.Mesh(new THREE.SphereGeometry(0.18, 6, 5), leafMat);
      const ang = (i / 5) * Math.PI * 2;
      b.position.set(Math.cos(ang) * 0.12, 0.25, Math.sin(ang) * 0.12); g.add(b);
    }
    const pot1 = new THREE.Mesh(new THREE.SphereGeometry(0.09, 5, 5), CROP_MATS.kentang);
    pot1.position.set(0.12, 0.10, 0.08); g.add(pot1);
    const pot2 = new THREE.Mesh(new THREE.SphereGeometry(0.08, 5, 5), CROP_MATS.kentang);
    pot2.position.set(-0.1, 0.10, -0.06); g.add(pot2);
  } else if (cropType === 'pisang') {
    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.09, 0.7, 6), CROP_MATS.pisangTrunk);
    trunk.position.y = 0.35; g.add(trunk);
    for (let i = 0; i < 4; i++) {
      const leaf = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.02, 0.14), glowMat);
      const ang = (i / 4) * Math.PI * 2;
      leaf.position.set(Math.cos(ang) * 0.2, 0.7, Math.sin(ang) * 0.2);
      leaf.rotation.y = ang; leaf.rotation.z = 0.3; g.add(leaf);
    }
    for (let i = 0; i < 5; i++) {
      const b = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.015, 0.18, 4), CROP_MATS.pisangFruit);
      b.position.set(0.06, 0.5 - i * 0.03, (i - 2) * 0.03);
      b.rotation.z = -0.5; g.add(b);
    }
  } else if (cropType === 'cabai') {
    const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.04, 0.55, 5), leafMat);
    stem.position.y = 0.28; g.add(stem);
    const bushOffsets = [[-0.08, 0.05], [0.08, -0.05], [-0.05, -0.08], [0.06, 0.07]];
    for (let i = 0; i < 4; i++) {
      const b = new THREE.Mesh(new THREE.SphereGeometry(0.12, 5, 4), leafMat);
      b.position.set(bushOffsets[i][0], 0.4 + i * 0.06, bushOffsets[i][1]); g.add(b);
    }
    for (let i = 0; i < 3; i++) {
      const ch = new THREE.Mesh(new THREE.ConeGeometry(0.035, 0.18, 4), CROP_MATS.cabai);
      ch.position.set(i === 0 ? 0.12 : i === 1 ? -0.12 : 0, 0.35, i === 2 ? 0.12 : -0.05);
      ch.rotation.x = Math.PI - 0.2; g.add(ch);
    }
  }

  // Tunas / kecambah hijau terang di bagian dasar agar bibit selalu tampak jelas di atas tanah
  const sproutStem = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.025, 0.22, 5), CROP_MATS.sproutStem);
  sproutStem.position.y = 0.11; g.add(sproutStem);
  for (let s = 0; s < 3; s++) {
    const sLeaf = new THREE.Mesh(new THREE.ConeGeometry(0.04, 0.18, 4), CROP_MATS.sproutLeaf);
    const sAng = (s / 3) * Math.PI * 2;
    sLeaf.position.set(Math.cos(sAng) * 0.05, 0.20, Math.sin(sAng) * 0.05);
    sLeaf.rotation.z = 0.45; sLeaf.rotation.y = sAng; g.add(sLeaf);
  }

  g.traverse(child => {
    if (child.isMesh) {
      child.castShadow = true;
      child.receiveShadow = true;
      child.frustumCulled = false;
    }
  });

  g.scale.set(0.60, 0.60, 0.60);
  return g;
}

const allPlots = [];

function createSinglePlot(x, z, idx, unlocked = true) {
  const plotGroup = new THREE.Group();
  plotGroup.name = `Plot_${idx + 1}`;

  // 1 Permukaan tanah polos cokelat tanah rata (tanpa alur/garis gelap)
  const pm = new THREE.Mesh(new THREE.BoxGeometry(1.38, 0.12, 1.38), PLOT_SOIL_DRY_MAT);
  pm.position.set(0, 0.06, 0);
  pm.castShadow = true;
  pm.receiveShadow = true;
  pm.frustumCulled = false;
  plotGroup.add(pm);

  // Bingkai kayu rapi di sekeliling permukaan tanah
  [[-0.72, 0, 0.08, 0.18, 1.54], [0.72, 0, 0.08, 0.18, 1.54],
   [0, -0.72, 1.54, 0.18, 0.08], [0, 0.72, 1.54, 0.18, 0.08]].forEach(([dx, dz, w, h, d]) => {
    const b = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), PLOT_BORDER_MAT);
    b.position.set(dx, 0.09, dz);
    b.castShadow = true;
    b.receiveShadow = true;
    b.frustumCulled = false;
    plotGroup.add(b);
  });

  // Pre-build ke-6 model bibit/tanaman di dalam setiap plot saat startup
  const cropMeshes = {};
  for (const cropKey of ['wortel', 'gandum', 'jagung', 'kentang', 'pisang', 'cabai']) {
    const cm = createCropMesh(cropKey);
    cm.position.set(0, 0.13, 0);
    cm.scale.set(0.60, 0.60, 0.60);
    cm.visible = false;
    plotGroup.add(cm);
    cropMeshes[cropKey] = cm;
  }

  plotGroup.position.set(x, 0, z);
  plotGroup.scale.set(1, 1, 1);
  plotGroup.visible = Boolean(unlocked);
  scene.add(plotGroup);

  const plotData = {
    group: plotGroup,
    mesh: pm,
    soilMat: PLOT_SOIL_DRY_MAT,
    cropMeshes,
    unlocked: Boolean(unlocked),
    position: new THREE.Vector3(x, 0.12, z),
    state: 'empty',
    crop: null,
    timer: 0,
    growStage: 0,
    index: idx,
    plantGroup: null,
    watered: false,
    luck: 0,
    mature: false,
    animProgress: 1.0
  };
  allPlots[idx] = plotData;
  if (unlocked) {
    state.plots.push(plotData);
    interactables.push({ mesh: pm, type: 'plot', data: plotData, position: plotData.position, group: plotGroup });
  }
  return plotData;
}

function unlockPrebuiltPlot(idx) {
  const plotData = allPlots[idx];
  if (!plotData) return null;
  plotData.unlocked = true;
  plotData.group.visible = true;
  plotData.group.scale.set(1, 1, 1);
  plotData.animProgress = 1.0;
  if (!state.plots.includes(plotData)) {
    state.plots.push(plotData);
  }
  if (!interactables.some(ia => ia.type === 'plot' && ia.data === plotData)) {
    interactables.push({
      mesh: plotData.mesh,
      type: 'plot',
      data: plotData,
      position: plotData.position,
      group: plotData.group
    });
  }
  return plotData;
}

function buildInitialPlots() {
  state.plots.length = 0;
  allPlots.length = 0;
  for (let i = 0; i < PLOT_POSITIONS.length; i++) {
    createSinglePlot(PLOT_POSITIONS[i].x, PLOT_POSITIONS[i].z, i, i < 4);
  }
}
