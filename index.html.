        el.innerHTML = `
          <span class="ii">${item.icon}</span>
          <span class="in">${item.name}</span>
          <span class="im-badge im-biasa">${item.sub}</span>
          <span class="ic">x${item.count}</span>
          <button class="inv-use-btn">${isHeld ? '✅ Sedang Dipegang' : '🤲 Pegang'}</button>
        `;
        el.onclick = () => {
          equipInventoryItem({
            type: 'livestock',
            id: item.id,
            name: item.name,
            icon: item.icon,
            count: item.count
          });
          closeAllPanels();
          showNotif(`🤲 Memegang ${item.name} (x${item.count})`);
        };
        contentEl.appendChild(el);
      }
    }
    if (!any) {
      contentEl.innerHTML = emptyMsg('Belum ada Hasil Ternak (Telur / Susu) di inventaris.<br>Beri makan Ayam (Jagung) atau Sapi (Gandum), lalu ambil hasilnya di kotak kandang!');
    }
