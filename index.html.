function rotateCoopLocalOffset(lx, lz, rotY = CHICKEN_COOP_ROT_Y) {
  const c = Math.cos(rotY);
  const s = Math.sin(rotY);
  return {
    x: lx * c + lz * s,
    z: -lx * s + lz * c
  };
}
function worldToCoopLocal(wx, wz, cfg = CONFIG.chickenPenPos, rotY = CHICKEN_COOP_ROT_Y) {
  const dx = wx - cfg.x;
  const dz = wz - cfg.z;
  const c = Math.cos(rotY);
  const s = Math.sin(rotY);
  return {
    lx: dx * c - dz * s,
    lz: dx * s + dz * c
  };
}

