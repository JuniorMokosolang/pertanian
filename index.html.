// 2. Fungsi Pembagi Kepadatan untuk Tingkat Menengah (Separuh Helai Bersih)
// Setiap helai rumput di petak_rumput_hidup.glb tersusun tepat dari 21 indeks (7 segitiga)
function createMidGrassGeometry(srcGeo) {
  const midGeo = srcGeo.clone();
  const srcIndices = srcGeo.index.array;
  const bladeCount = Math.floor(srcIndices.length / 21); // 4.144 helai
  const midBladeCount = Math.floor(bladeCount / 2);      // 2.072 helai
  const newIndices = new (srcIndices.constructor)(midBladeCount * 21);
  let dstIdx = 0;
  for (let b = 0; b < bladeCount; b += 2) {
    if (dstIdx + 21 > newIndices.length) break;
    const srcOffset = b * 21;
    for (let k = 0; k < 21; k++) {
      newIndices[dstIdx++] = srcIndices[srcOffset + k];
    }
  }
  midGeo.setIndex(new THREE.BufferAttribute(newIndices, 1));
  return midGeo;
}

// 3. Shader Generator untuk Rumput Hidup (Angin + Zona Bebas + Fade Jarak)
function applyGrassShader(material, isMid) {
  material.side = THREE.DoubleSide;
  material.vertexColors = true;
  material.roughness = 0.65;
  material.metalness = 0.0;
  if (material.color) material.color.setHex(0xFFFFFF);

  const uniforms = {
    uTime: { value: 0.0 },
    uWindSpeed: { value: GRASS_CONFIG.windSpeed },
    uWindStrength: { value: isMid ? GRASS_CONFIG.windStrength * 0.4 : GRASS_CONFIG.windStrength },
    uWindDir: { value: GRASS_CONFIG.windDir },
    uCameraPos: { value: new THREE.Vector3() },
    uFadeStart: { value: GRASS_CONFIG.midDist },
    uFadeEnd: { value: GRASS_CONFIG.fadeEnd },
    uWidenBlades: { value: isMid ? 1.15 : 1.0 }
  };

  material.userData.grassUniforms = uniforms;

  material.onBeforeCompile = shader => {
    shader.uniforms.uTime = uniforms.uTime;
    shader.uniforms.uWindSpeed = uniforms.uWindSpeed;
    shader.uniforms.uWindStrength = uniforms.uWindStrength;
    shader.uniforms.uWindDir = uniforms.uWindDir;
    shader.uniforms.uCameraPos = uniforms.uCameraPos;
    shader.uniforms.uFadeStart = uniforms.uFadeStart;
    shader.uniforms.uFadeEnd = uniforms.uFadeEnd;
    shader.uniforms.uWidenBlades = uniforms.uWidenBlades;
    material.userData.shader = shader;

    // Header vertex shader disisipkan ke dalam <common> agar berada SETELAH #version 300 es
    shader.vertexShader = shader.vertexShader.replace(
      '#include <common>',
      `#include <common>
      attribute vec2 _ANGIN;
      uniform float uTime;
      uniform float uWindSpeed;
      uniform float uWindStrength;
      uniform vec2 uWindDir;
      uniform vec3 uCameraPos;
      uniform float uFadeStart;
      uniform float uFadeEnd;
      uniform float uWidenBlades;

      // Pengecekan Zona Bebas Rumput (Jalan, Bangunan, Bedeng, Kandang, Sumur)
      bool checkInExclusion(vec2 p) {
        // Rumah Petani
        if (p.x >= -23.5 && p.x <= -12.5 && p.y >= -16.5 && p.y <= -6.5) return true;
        // Kandang Ayam
        if (p.x >= -15.8 && p.x <= -7.8 && p.y >= -6.2 && p.y <= 2.8) return true;
        // Kandang Sapi
        if (p.x >= -16.2 && p.x <= -9.5 && p.y >= 4.5 && p.y <= 12.0) return true;
        // Lahan Tanam (10 Plot Kebun di Samping Kanan Rumah)
        if (p.x >= 3.6 && p.x <= 13.0 && p.y >= -2.45 && p.y <= 1.90) return true;
        // Sumur 3D
        if (distance(p, vec2(7.0, 5.0)) < 2.5) return true;
        // Jalan Setapak Utama, Kandang Ayam, Kandang Sapi & Toko (tepat selebar badan jalan 2.08 unit agar rumput tepi menyatu rata)
        if (p.x >= -1.06 && p.x <= 1.06 && p.y >= -3.06 && p.y <= 16.06) return true;
        if (p.x >= -13.5 && p.x <= 1.06 && p.y >= -3.06 && p.y <= -0.94) return true;
        if (p.x >= -10.4 && p.x <= 1.06 && p.y >= 6.14 && p.y <= 8.26) return true;
        if (p.x >= -15.1 && p.x <= 15.1 && p.y >= 13.94 && p.y <= 20.8) return true;
        return false;
      }`
    );

    // Modifikasi geometri & posisi di awal kalkulasi vertex
    shader.vertexShader = shader.vertexShader.replace(
      '#include <begin_vertex>',
      `#include <begin_vertex>

      // Sedikit perlebar helai untuk tingkat menengah agar tetap tampak lebat
      if (uWidenBlades > 1.01) {
        transformed.xz *= uWidenBlades;
      }

      // Hitung koordinat dunia titik ini menggunakan instanceMatrix (InstancedMesh berada di origin 0,0,0)
      #ifdef USE_INSTANCING
        vec4 grassWorld = instanceMatrix * vec4(transformed, 1.0);
      #else
        vec4 grassWorld = vec4(transformed, 1.0);
      #endif

      // Sembunyikan helai yang berada di dalam zona bebas
      if (checkInExclusion(grassWorld.xz)) {
        transformed.y = -50.0;
      } else {
        // Efek Memudar Halus Berdasarkan Jarak (Mengecil mulus ke tanah di batas LOD)
        float dCam = length(grassWorld.xyz - uCameraPos);
        float fade = clamp((uFadeEnd - dCam) / max(0.1, uFadeEnd - uFadeStart), 0.0, 1.0);
        transformed.y *= fade;

        // Animasi Angin Bergoyang Berdasarkan Atribut _ANGIN & Posisi Dunia
        float swayWeight = _ANGIN.x; // 0 di pangkal, 1 di ujung helai
        float bladePhase = _ANGIN.y; // Fase unik per helai

        if (swayWeight > 0.02 && uWindStrength > 0.001) {
          float wave = uTime * uWindSpeed + dot(grassWorld.xz, uWindDir) * 0.22 + bladePhase * 2.5;
          float sway = (sin(wave) * 0.75 + sin(wave * 2.3 + 1.2) * 0.25) * uWindStrength * swayWeight;
          transformed.x += uWindDir.x * sway;
          transformed.z += uWindDir.y * sway;
          transformed.y -= abs(sway) * 0.25 * swayWeight;
        }
      }`
    );

    // Sedikit cerahkan warna rumput agar terlihat segar di siang hari
    shader.fragmentShader = shader.fragmentShader.replace(
      '#include <color_fragment>',
      `#include <color_fragment>
      diffuseColor.rgb *= 1.12;`
    );
  };
}

// 4. Struktur Data Grid & Instanced Meshes
let instancedNearGrass = null;
let instancedMidGrass = null;
const allGrassPatches = [];
const _patchMat = new THREE.Matrix4();
const _patchPos = new THREE.Vector3();
const _patchQuat = new THREE.Quaternion();
const _patchScale = new THREE.Vector3();
const _patchEuler = new THREE.Euler();
const _frustum = new THREE.Frustum();
const _frustumMatrix = new THREE.Matrix4();

// Bangun susunan petak 8x8 unit menutupi seluruh lahan (-40 hingga +40)
function buildGrassGrid() {
  allGrassPatches.length = 0;
  const pSize = GRASS_CONFIG.patchSize; // 8.0
  const extent = GRASS_CONFIG.mapExtent; // 40.0
  const countAxis = Math.round((extent * 2) / pSize); // 10 petak per sumbu = 100 petak

  for (let ix = 0; ix < countAxis; ix++) {
    const px = -extent + pSize * 0.5 + ix * pSize;
    for (let iz = 0; iz < countAxis; iz++) {
      const pz = -extent + pSize * 0.5 + iz * pSize;

      // Variasi rotasi 0, 90, 180, 270 derajat dan sedikit variasi tinggi agar alami
      const rotIdx = (Math.abs(Math.round(px * 3.7 + pz * 7.1)) % 4);
      const rotY = rotIdx * (Math.PI / 2);
      const scaleH = 0.94 + 0.12 * ((Math.sin(px * 1.5 + pz * 2.3) + 1.0) * 0.5);

      _patchPos.set(px, 0.0, pz);
      _patchEuler.set(0, rotY, 0);
      _patchQuat.setFromEuler(_patchEuler);
      _patchScale.set(1.0, scaleH, 1.0);
      _patchMat.compose(_patchPos, _patchQuat, _patchScale);

      const sphereCenter = new THREE.Vector3(px, 0.45 * scaleH, pz);
      allGrassPatches.push({
        x: px,
        z: pz,
        sphereCenter: sphereCenter,
        sphere: new THREE.Sphere(sphereCenter, 5.8),
        matrix: _patchMat.clone()
      });
    }
  }
}
buildGrassGrid();

loadGLBWithFallback(
  PETAK_RUMPUT_GLB_B64,
  './petak_rumput_hidup.glb',
  gltf => {
    let helaiMesh = null;
    gltf.scene.traverse(child => {
      if (child.name === 'Tanah_Dasar') {
        child.visible = false; // Sembunyikan tanah petak agar tidak tumpang tindih
      } else if (child.isMesh && child.name.includes('Helai') && !helaiMesh) {
        helaiMesh = child;
      }
    });

    if (!helaiMesh) {
      gltf.scene.traverse(child => {
        if (child.isMesh && child.name !== 'Tanah_Dasar' && !helaiMesh) helaiMesh = child;
      });
    }

    if (helaiMesh) {
      const fullGeo = helaiMesh.geometry;
      const midGeo = createMidGrassGeometry(fullGeo);

      const nearMat = helaiMesh.material.clone();
      applyGrassShader(nearMat, false);

      const midMat = helaiMesh.material.clone();
      applyGrassShader(midMat, true);

      const maxInstances = allGrassPatches.length; // 100
      instancedNearGrass = new THREE.InstancedMesh(fullGeo, nearMat, maxInstances);
      instancedNearGrass.name = 'InstancedNearGrass';
      instancedNearGrass.castShadow = false;
      instancedNearGrass.receiveShadow = true;
      instancedNearGrass.frustumCulled = false;
      instancedNearGrass.count = 0;
      scene.add(instancedNearGrass);

      instancedMidGrass = new THREE.InstancedMesh(midGeo, midMat, maxInstances);
      instancedMidGrass.name = 'InstancedMidGrass';
      instancedMidGrass.castShadow = false;
      instancedMidGrass.receiveShadow = true;
      instancedMidGrass.frustumCulled = false;
      instancedMidGrass.count = 0;
      scene.add(instancedMidGrass);
    }
  },
  err => console.warn('Info load petak rumput:', err)
);

// 5. Update Runtime Tiap Frame (Frustum Culling + LOD Jarak + Animasi Angin)
function updateLivingGrass(time, dt, cam) {
  if (!instancedNearGrass || !instancedMidGrass) return;

  // Jika sedang di dalam rumah atau kualitas Mati, matikan render rumput 100%
  if (state.isInsideHouse || GRASS_CONFIG.quality === 'off') {
    if (instancedNearGrass.count !== 0) {
      instancedNearGrass.count = 0;
      instancedNearGrass.instanceMatrix.needsUpdate = true;
    }
    if (instancedMidGrass.count !== 0) {
      instancedMidGrass.count = 0;
      instancedMidGrass.instanceMatrix.needsUpdate = true;
    }
    return;
  }

  // Update uniform angin & kamera
  const nearUniforms = instancedNearGrass.material.userData.grassUniforms;
  const midUniforms = instancedMidGrass.material.userData.grassUniforms;
  if (nearUniforms) {
    nearUniforms.uTime.value = time;
    nearUniforms.uCameraPos.value.copy(cam.position);
    nearUniforms.uWindStrength.value = GRASS_CONFIG.quality === 'low' ? 0.0 : GRASS_CONFIG.windStrength;
  }
  if (midUniforms) {
    midUniforms.uTime.value = time;
    midUniforms.uCameraPos.value.copy(cam.position);
    midUniforms.uWindStrength.value = GRASS_CONFIG.quality === 'low' ? 0.0 : GRASS_CONFIG.windStrength * 0.4;
  }

  // Siapkan bidang frustum kamera untuk culling per petak
  _frustumMatrix.multiplyMatrices(cam.projectionMatrix, cam.matrixWorldInverse);
  _frustum.setFromProjectionMatrix(_frustumMatrix);

  // Aturan jarak berdasarkan kualitas
  let nearDist = GRASS_CONFIG.nearDist; // 24.0
  let midDist = GRASS_CONFIG.midDist;   // 52.0
  let allowMid = true;

  if (GRASS_CONFIG.quality === 'low') {
    nearDist = 20.0;
    allowMid = false; // Kualitas rendah hanya menggambar petak dekat tanpa angin
  } else if (GRASS_CONFIG.quality === 'high') {
    nearDist = 32.0;
    midDist = 64.0;
  }

  let nearCount = 0;
  let midCount = 0;
  const camPos = cam.position;

  for (let i = 0; i < allGrassPatches.length; i++) {
    const patch = allGrassPatches[i];

    // Frustum culling: abaikan petak yang berada di luar sudut pandang kamera
    if (!_frustum.intersectsSphere(patch.sphere)) continue;

    const dist = patch.sphereCenter.distanceTo(camPos);

    if (dist <= nearDist) {
      // Tingkat Dekat: Petak penuh
      instancedNearGrass.setMatrixAt(nearCount++, patch.matrix);
    } else if (allowMid && dist <= midDist) {
      // Tingkat Menengah: Separuh helai lebih lebar
      instancedMidGrass.setMatrixAt(midCount++, patch.matrix);
    }
  }

  instancedNearGrass.count = nearCount;
  instancedNearGrass.instanceMatrix.needsUpdate = true;

  instancedMidGrass.count = midCount;
  instancedMidGrass.instanceMatrix.needsUpdate = true;
}

