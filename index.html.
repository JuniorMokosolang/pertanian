    }
    if (!any) {
      contentEl.innerHTML = emptyMsg('Belum ada Hasil Panen di inventaris.<br>Tanam bibit, siram dengan Ember, lalu panen dengan Cangkul!');
    }
  } else if (active === 'ternak') {
    let any = false;
    const livestockItems = [
      { id: 'telur', name: 'Telur', icon: '🥚', count: state.inventory.ternak.telur || 0, sub: 'Hasil Kandang Ayam' },
      { id: 'susu',  name: 'Susu',  icon: '🥛', count: state.inventory.ternak.susu || 0,  sub: 'Hasil Kandang Sapi' }
    ];
    for (const item of livestockItems) {
      if (item.count > 0) {
        any = true;
        const isHeld = Boolean(state.activeItem && state.activeItem.type === 'livestock' && state.activeItem.id === item.id);
        const el = document.createElement('div');
        el.className = 'inv-item' + (isHeld ? ' equipped' : '');
