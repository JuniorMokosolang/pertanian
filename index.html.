}

function emitMutationBatu(pos) {
  const colors = [0x8D6E63, 0x5D4037, 0x757575, 0x424242];
  for (let i = 0; i < 45; i++) {
    const ang = Math.random() * Math.PI * 2;
    const spd = 1.0 + Math.random() * 2.0;
    const c = colors[i % colors.length];
    spawnParticle(
      pos.x, pos.y + 0.3, pos.z,
      Math.cos(ang) * spd,
      3.2 + Math.random() * 2.8,
