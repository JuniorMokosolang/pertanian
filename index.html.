function syncPlotVisualState(plot) {
  if (!plot) return;
  if (plot.state === 'planted' && plot.crop && CONFIG.crops[plot.crop]) {
    plot.mesh.material = plot.watered ? PLOT_SOIL_WET_MAT : PLOT_SOIL_DRY_MAT;
    if (plot.cropMeshes) {
      for (const cm of Object.values(plot.cropMeshes)) {
        cm.visible = false;
      }
    }
    const pg = plot.cropMeshes ? plot.cropMeshes[plot.crop] : null;
    if (pg) {
      const totalTime = CONFIG.crops[plot.crop].growTime;
      const progress = totalTime > 0 ? Math.min(1, plot.timer / totalTime) : 0;
      let s = 0.60;
      if (plot.mature || (plot.watered && progress >= 1.0)) {
        plot.mature = true;
        plot.growStage = 3;
        plot.timer = totalTime;
        s = 1.10;
      } else if (plot.watered) {
        if (progress < 0.45) {
          plot.growStage = 1;
          s = 0.60 + (progress / 0.45) * 0.25;
        } else {
          plot.growStage = 2;
          s = 0.85 + ((progress - 0.45) / 0.55) * 0.25;
        }
      } else {
        plot.growStage = 1;
        s = 0.60;
      }
      pg.visible = true;
      pg.position.set(0, 0.13, 0);
      pg.scale.set(s, s, s);
      plot.plantGroup = pg;
    }
  } else {
    plot.mesh.material = PLOT_SOIL_DRY_MAT;
    if (plot.cropMeshes) {
      for (const cm of Object.values(plot.cropMeshes)) {
        cm.visible = false;
      }
    }
    plot.plantGroup = null;
  }
}

function applyOfflineProgress(elapsedSeconds) {
  const dtOffline = Math.max(0, Number(elapsedSeconds) || 0);
  if (dtOffline <= 0) return;

  // a. Pertumbuhan Tanaman selama pemain offline
  for (const lp of state.plots) {
    if (lp && lp.state === 'planted' && lp.crop && CONFIG.crops[lp.crop]) {
      if (lp.watered && !lp.mature) {
        const totalTime = CONFIG.crops[lp.crop].growTime;
        lp.timer = Math.min(totalTime, (Number(lp.timer) || 0) + dtOffline);
        if (lp.timer >= totalTime) {
          lp.timer = totalTime;
          lp.mature = true;
          lp.growStage = 3;
        } else {
          const progress = totalTime > 0 ? lp.timer / totalTime : 0;
          lp.growStage = progress >= 0.45 ? 2 : 1;
        }
      }
      syncPlotVisualState(lp);
    }
  }

  // b. Produksi Telur Ayam & Susu Sapi selama pemain offline
  for (const liveA of state.animals) {
    if (liveA && liveA.producing) {
      liveA.productTimer = Math.max(0, (Number(liveA.productTimer) || 0) - dtOffline);
      if (liveA.productTimer <= 0) {
        const bKey = liveA.type === 'ayam' ? 'telur' : 'susu';
        if ((state.boxStorage[bKey] || 0) < MAX_BOX_CAPACITY) {
          state.boxStorage[bKey] = Math.min(MAX_BOX_CAPACITY, (state.boxStorage[bKey] || 0) + 1);
          liveA.producing = false;
          liveA.productReady = false;
          liveA.productTimer = 0;
        } else {
          liveA.productTimer = 0;
        }
      }
    }
  }

  if (typeof updateAllProductBoxes === 'function') {
    updateAllProductBoxes();
  }
}

function completeAllProgressOnSleep() {
  // a. Seluruh tanaman yang sudah ditanam & disiram otomatis tumbuh 100% (siap panen)
  for (const plot of state.plots) {
    if (plot && plot.state === 'planted' && plot.watered && plot.crop && CONFIG.crops[plot.crop]) {
      const totalTime = CONFIG.crops[plot.crop].growTime;
      plot.timer = totalTime;
      plot.mature = true;
      plot.growStage = 3;
      syncPlotVisualState(plot);
    }
  }

  // b. Seluruh hewan ternak (ayam & sapi) yang sudah diberi makan otomatis selesai memproduksi telur/susu
  for (const animal of state.animals) {
    if (animal && animal.producing) {
      animal.productTimer = 0;
      const bKey = animal.type === 'ayam' ? 'telur' : 'susu';
      if ((state.boxStorage[bKey] || 0) < MAX_BOX_CAPACITY) {
        state.boxStorage[bKey] = Math.min(MAX_BOX_CAPACITY, (state.boxStorage[bKey] || 0) + 1);
        animal.producing = false;
        animal.productReady = false;
      }
    }
  }

  if (typeof updateAllProductBoxes === 'function') {
    updateAllProductBoxes();
  }
  if (typeof refreshHUD === 'function') refreshHUD();
  if (typeof refreshHotbar === 'function') refreshHotbar();
  if (typeof refreshInventory === 'function') refreshInventory();
  if (typeof updateContextualUI === 'function') updateContextualUI();
  saveGame();
}

function saveGame() {
  try {
    const saveData = {
      lastSavedTime: Date.now(),
      coins: state.coins,
      level: state.level,
      xp: state.xp,
      bucket: state.bucket,
      bucketSkin: state.bucketSkin,
      inventory: state.inventory,
      boxStorage: state.boxStorage,
      plotUpgradeLevel: state.plotUpgradeLevel,
      gameTime: state.gameTime,
      gameDay: state.gameDay,
      clockFormat24h: true,
      plots: state.plots.map(p => ({
        state: p.state,
        crop: p.crop,
        timer: p.timer,
        growStage: p.growStage,
        watered: p.watered,
        mature: p.mature,
        luck: p.luck
      })),
      animalCount: state.animals.length,
      animals: state.animals.map(a => ({
        type: a.type,
        producing: a.producing,
        productReady: false,
        productTimer: a.productTimer
      }))
    };
    localStorage.setItem('plant_it_save', JSON.stringify(saveData));
  } catch (e) {
    // ignore
  }
}

function loadGame() {
  try {
    const raw = localStorage.getItem('plant_it_save');
    if (!raw) return;
    const d = JSON.parse(raw);
    const lastSavedTime = Number(d.lastSavedTime) || 0;
    const elapsedSeconds = lastSavedTime > 0 ? Math.max(0, (Date.now() - lastSavedTime) / 1000) : 0;

    if (d.coins !== undefined) state.coins = d.coins;
    if (d.level !== undefined) state.level = d.level;
    if (d.xp !== undefined) state.xp = d.xp;
    if (d.bucket) state.bucket = d.bucket;
    if (d.bucketSkin !== undefined) state.bucketSkin = d.bucketSkin;
    if (typeof d.gameTime === 'number' && !isNaN(d.gameTime) && d.gameTime >= 0) {
      if (d.clockFormat24h) {
        state.gameTime = d.gameTime;
      } else {
        // Migrasi save lama (agar angka waktu yang sebelumnya > 60 seperti 157:55 otomatis masuk ke rentang 24 jam 00:00 - 23:59)
        state.gameTime = ((Math.floor(d.gameTime) % 1440) + 1440) % 1440;
      }
      state.gameDay = Math.floor(Math.max(0, state.gameTime) / 1440) + 1;
    }
    if (d.inventory) {
      if (d.inventory.bibit) state.inventory.bibit = { ...state.inventory.bibit, ...d.inventory.bibit };
      if (d.inventory.panen) state.inventory.panen = { ...state.inventory.panen, ...d.inventory.panen };
      if (d.inventory.ternak) state.inventory.ternak = { ...state.inventory.ternak, ...d.inventory.ternak };
      if (d.inventory.skins) state.inventory.skins = { ...state.inventory.skins, ...d.inventory.skins };
    }
    if (d.boxStorage) {
      state.boxStorage.telur = Math.min(MAX_BOX_CAPACITY, Math.max(0, Number(d.boxStorage.telur) || 0));
      state.boxStorage.susu = Math.min(MAX_BOX_CAPACITY, Math.max(0, Number(d.boxStorage.susu) || 0));
    }
    if (d.plotUpgradeLevel !== undefined) {
      const targetLevel = d.plotUpgradeLevel;
      for (let i = state.plotUpgradeLevel; i < targetLevel; i++) {
        if (i === 0) {
          unlockPrebuiltPlot(4);
          unlockPrebuiltPlot(5);
        } else if (i === 1) {
          unlockPrebuiltPlot(6);
          unlockPrebuiltPlot(7);
        } else if (i === 2) {
          unlockPrebuiltPlot(8);
          unlockPrebuiltPlot(9);
        }
        state.plotUpgradeLevel = i + 1;
      }
    }
    if (Array.isArray(d.plots)) {
      for (let i = 0; i < Math.min(d.plots.length, state.plots.length); i++) {
        const sp = d.plots[i];
        const lp = state.plots[i];
        if (sp && sp.state === 'planted' && sp.crop && CONFIG.crops[sp.crop]) {
          lp.state = 'planted';
          lp.crop = sp.crop;
          lp.timer = Number(sp.timer) || 0;
          lp.growStage = Number(sp.growStage) || 1;
          lp.watered = Boolean(sp.watered);
          lp.mature = Boolean(sp.mature);
          lp.luck = Number(sp.luck) || 0;
          syncPlotVisualState(lp);
        }
      }
    }
    if (Array.isArray(d.animals) && d.animals.length > 0) {
      for (let i = 1; i < d.animals.length; i++) {
        const savedA = d.animals[i];
        if (savedA.type === 'ayam') {
          createChicken(CONFIG.chickenPenPos.x + (Math.random() - 0.5) * 2, CONFIG.chickenPenPos.z + (Math.random() - 0.5) * 2);
        } else if (savedA.type === 'sapi') {
          createCow(CONFIG.cowPenPos.x + (Math.random() - 0.5) * 2, CONFIG.cowPenPos.z + (Math.random() - 0.5) * 2);
        }
      }
      // Pulihkan status produksi hewan & migrasikan productReady lama ke kotak penampung baru
      for (let i = 0; i < Math.min(d.animals.length, state.animals.length); i++) {
        const savedA = d.animals[i];
        const liveA = state.animals[i];
        if (savedA && liveA) {
          if (savedA.productReady) {
            const bKey = liveA.type === 'ayam' ? 'telur' : 'susu';
            state.boxStorage[bKey] = Math.min(MAX_BOX_CAPACITY, (state.boxStorage[bKey] || 0) + 1);
            liveA.producing = false;
            liveA.productTimer = 0;
          } else if (savedA.producing) {
            liveA.producing = true;
            liveA.productTimer = typeof savedA.productTimer === 'number' ? savedA.productTimer : CONFIG.productionTime;
          }
        }
      }
    }
    // Terapkan progres offline (tanaman & produksi ternak) berdasarkan selisih waktu nyata sejak lastSavedTime
    if (elapsedSeconds > 0) {
      applyOfflineProgress(elapsedSeconds);
    }
    if (typeof updateAllProductBoxes === 'function') {
      updateAllProductBoxes();
    }
    saveGame();
  } catch (e) {
    console.error('Gagal memuat save game:', e);
  }
}

