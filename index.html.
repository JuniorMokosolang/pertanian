// Pre-alokasi material bawaan Mat_JalanSetapak_VertexColor secara sinkron saat startup agar ID material rendah & bebas bug invisible Three.js r160
const MAT_JALAN_SETAPAK_SYNC = new THREE.MeshStandardMaterial({
  name: 'Mat_JalanSetapak_VertexColor',
  color: 0xffffff,
  roughness: 0.76,
  metalness: 0.0,
