let lastNearestKiosk = null;

function updateContextualUI() {
  const p = playerGroup.position;
  const checks = [
    { btn:'cb-bibit', pos:CONFIG.shopPos.bibit, isShop:true, name:'Toko Bibit' },
    { btn:'cb-jualtan', pos:CONFIG.shopPos.jualTan, isShop:true, name:'Toko Jual Tanaman' },
    { btn:'cb-hewan', pos:CONFIG.shopPos.hewan, isShop:true, name:'Toko Hewan' },
    { btn:'cb-jualter', pos:CONFIG.shopPos.jualTer, isShop:true, name:'Toko Jual Hasil Ternak' },
    { btn:'cb-air', pos:CONFIG.wellPos, isShop:false, name:'Sumur' }
  ];

  let nearestKioskName = null;
  let minKioskDist = 999;

  for (const { btn, pos, isShop, name } of checks) {
    // Untuk keempat toko yang menghadap ke arah Rumah (-Z), titik meja kasir berada di sekitar z = pos.z - 1.0
    const dCenter = Math.sqrt((p.x - pos.x) ** 2 + (p.z - pos.z) ** 2);
    const dFront = isShop ? Math.sqrt((p.x - pos.x) ** 2 + (p.z - (pos.z - 1.0)) ** 2) : dCenter;
    const d = Math.min(dCenter, dFront);
    const el = document.getElementById(btn);
    if (d <= CONFIG.interactDistance) {
      el.classList.add('vis');
      if (d < minKioskDist) {
        minKioskDist = d;
        nearestKioskName = name;
      }
    } else {
      el.classList.remove('vis');
    }
  }

  if (nearestKioskName !== lastNearestKiosk) {
    lastNearestKiosk = nearestKioskName;
    if (nearestKioskName) {
      console.log('[Kios Terdekat]:', nearestKioskName);
    }
  }

  let closestAnimal = null;
  let minAnimalDist = 999;
  for (const a of state.animals) {
    const d = distXZ(p, a.mesh.position);
    if (d < minAnimalDist) {
      minAnimalDist = d;
      closestAnimal = a;
    }
  }

  const feedBtn = document.getElementById('cb-feed');
  if (minAnimalDist <= CONFIG.feedDistance && closestAnimal) {
    feedBtn.classList.add('vis');
    const targetBoxKey = closestAnimal.type === 'ayam' ? 'telur' : 'susu';
    const targetBoxName = closestAnimal.type === 'ayam' ? 'Kotak Telur' : 'Kotak Susu';
    const isBoxFull = (state.boxStorage?.[targetBoxKey] || 0) >= MAX_BOX_CAPACITY;
    if (isBoxFull) {
      feedBtn.textContent = `📦 ${targetBoxName} Penuh (${MAX_BOX_CAPACITY}/${MAX_BOX_CAPACITY})`;
      feedBtn.onclick = () => showNotif(`📦 ${targetBoxName} sudah penuh! Ambil isinya di luar kandang terlebih dahulu.`);
    } else if (closestAnimal.producing) {
      const s = Math.ceil(Math.max(1, closestAnimal.productTimer));
      feedBtn.textContent = `⏳ Sedang Produksi (${s}s)`;
      feedBtn.onclick = () => showNotif(`Hewan sedang memproduksi (${s} dtk lagi)...`);
    } else {
      const foodName = closestAnimal.type === 'ayam' ? 'Jagung' : 'Gandum';
      feedBtn.textContent = `🌾 Beri Makan ${closestAnimal.type === 'ayam' ? 'Ayam' : 'Sapi'} (1 ${foodName})`;
      feedBtn.onclick = () => feedAnimal(closestAnimal);
    }
  } else {
    feedBtn.classList.remove('vis');
  }

  // Tombol kontekstual & prompt saat player berada di dekat Kotak Telur / Kotak Susu
  const boxBtn = document.getElementById('cb-box');
  let closestBoxType = null;
  let minBoxDist = 999;
  for (const bKey of ['telur', 'susu']) {
    const bObj = productBoxes[bKey];
    if (bObj) {
      const d = distXZ(p, bObj.position);
      if (d < minBoxDist) {
        minBoxDist = d;
        closestBoxType = bKey;
      }
    }
  }

  const hintEl = document.getElementById('interact-hint');
  if (boxBtn && closestBoxType && minBoxDist <= BOX_INTERACT_DISTANCE) {
    const bCount = state.boxStorage?.[closestBoxType] || 0;
    const bTitle = closestBoxType === 'telur' ? 'Kotak Telur' : 'Kotak Susu';
    const bItem = closestBoxType === 'telur' ? 'Telur' : 'Susu';
    const bIcon = closestBoxType === 'telur' ? '🥚' : '🥛';
    boxBtn.classList.add('vis');
    boxBtn.textContent = bCount > 0
      ? `${bIcon} Ambil ${bItem} (${bCount}/${MAX_BOX_CAPACITY})`
      : `📦 ${bTitle} (${bCount}/${MAX_BOX_CAPACITY})`;
    boxBtn.onclick = () => collectFromBox(closestBoxType);

    if (!hoveredObj && hintEl) {
      hintEl.style.display = 'block';
      hintEl.textContent = bCount > 0
        ? `Tekan E / Klik untuk ambil (${bItem} ${bCount}/${MAX_BOX_CAPACITY})`
        : `${bTitle} kosong (0/${MAX_BOX_CAPACITY}) - Tekan E / Klik`;
    }
  } else if (boxBtn) {
    boxBtn.classList.remove('vis');
  }

  // Tombol kontekstual & petunjuk interaksi Pintu Masuk (luar), Pintu Keluar (dalam rumah) & Kasur Tidur (TempatTidur)
  const doorBtn = document.getElementById('cb-door');
  const sleepBtn = document.getElementById('cb-sleep');
  if (!state.isInsideHouse) {
    if (sleepBtn) sleepBtn.classList.remove('vis');
    const distOut = Math.hypot(p.x - ZONA_PINTU_LUAR.x, p.z - ZONA_PINTU_LUAR.z);
    if (distOut <= ZONA_PINTU_LUAR.radius) {
      if (doorBtn) {
        doorBtn.classList.add('vis');
        doorBtn.textContent = '🚪 Masuk Rumah (E)';
        doorBtn.onclick = () => TeleportDenganTransisi('masuk');
      }
      if (!hoveredObj && hintEl) {
        hintEl.style.display = 'block';
        hintEl.textContent = 'Tekan E untuk masuk';
      }
    } else if (doorBtn) {
      doorBtn.classList.remove('vis');
    }
  } else {
    const distIn = Math.hypot(p.x - ZONA_PINTU_DALAM.x, p.z - ZONA_PINTU_DALAM.z);
    if (distIn <= ZONA_PINTU_DALAM.radius && !state.isSleeping) {
      if (doorBtn) {
        doorBtn.classList.add('vis');
        doorBtn.textContent = '🚪 Keluar Rumah (E)';
        doorBtn.onclick = () => TeleportDenganTransisi('keluar');
      }
      if (!hoveredObj && hintEl) {
        hintEl.style.display = 'block';
        hintEl.textContent = 'Tekan E untuk keluar';
      }
    } else if (doorBtn) {
      doorBtn.classList.remove('vis');
    }

    // Interaksi Kasur (TempatTidur) saat di dalam rumah dan berada dekat kasur (<= 2.5 unit)
    const distBed = getDistToInteriorBed(p);
    if (distBed <= (CONFIG.bedInteractDistance || 2.5) && !state.isSleeping) {
      if (sleepBtn) {
        sleepBtn.classList.add('vis');
        sleepBtn.textContent = '🛏️ Tidur [Klik / E]';
        sleepBtn.onclick = startSleepSequence;
      }
      if (!hoveredObj && hintEl) {
        hintEl.style.display = 'block';
        hintEl.textContent = '🛏️ Tidur [Klik / E] (Skip +5 Menit)';
      }
    } else if (sleepBtn) {
      sleepBtn.classList.remove('vis');
    }
  }
}

