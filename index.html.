.upgrade-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.upgrade-title{font-size:14px;font-weight:bold;color:#3E2723}
.upgrade-desc{font-size:11px;color:#5D4037;line-height:1.4}
.upgrade-status{font-size:12px;font-weight:bold;margin-top:6px}
