function feedAnimal(a) {
  const boxKey = a.type === 'ayam' ? 'telur' : 'susu';
  const boxName = a.type === 'ayam' ? 'Kotak Telur' : 'Kotak Susu';
  if ((state.boxStorage[boxKey] || 0) >= MAX_BOX_CAPACITY) {
    showNotif(`📦 ${boxName} sudah penuh (${MAX_BOX_CAPACITY}/${MAX_BOX_CAPACITY})! Ambil isinya di luar kandang terlebih dahulu.`);
    return;
  }
  if (a.producing) {
    const sLeft = Math.ceil(Math.max(0, a.productTimer));
    if (sLeft <= 0) {
      showNotif(`📦 ${boxName} penuh! Ambil isinya terlebih dahulu agar produksi lanjut.`);
    } else {
      showNotif(`Hewan sedang memproduksi (${sLeft} dtk lagi)... Harap tunggu!`);
    }
    return;
  }
  const reqFood = a.type === 'ayam' ? 'Jagung' : 'Gandum';
  if ((state.inventory.panen[reqFood] || 0) <= 0) {
    showNotif(`❌ Butuh 1 ${reqFood} untuk memberi makan ${a.type === 'ayam' ? 'Ayam' : 'Sapi'}! Tanam dan panen ${reqFood} terlebih dahulu.`);
    return;
  }

  state.inventory.panen[reqFood]--;
  a.producing = true;
  a.productTimer = CONFIG.productionTime;
  playHoldAction('angkat_panen');
  showAnimalHeartEmoji(a);
  showNotif(`🥰 Memberi makan ${a.type === 'ayam' ? 'Ayam' : 'Sapi'} dengan 1 ${reqFood}! Produksi dimulai (2 menit).`);
  refreshHUD();
  refreshHotbar();
  updateHeldItem();
  refreshInventory();
  saveGame();
}

function storeAnimalProductInBox(a) {
  const boxKey = a.type === 'ayam' ? 'telur' : 'susu';
  const cur = state.boxStorage[boxKey] || 0;
  if (cur >= MAX_BOX_CAPACITY) return false;

  state.boxStorage[boxKey] = cur + 1;
  updateProductBoxVisuals(boxKey);

  if (boxKey === 'telur') {
    showNotif(`🥚 Ayam bertelur! Masuk ke Kotak Telur (${state.boxStorage.telur}/${MAX_BOX_CAPACITY}).`);
  } else {
    showNotif(`🥛 Sapi menghasilkan susu! Masuk ke Kotak Susu (${state.boxStorage.susu}/${MAX_BOX_CAPACITY}).`);
  }
  saveGame();
  return true;
}

function collectFromBox(boxType) {
  const count = state.boxStorage?.[boxType] || 0;
  const boxName = boxType === 'telur' ? 'Kotak Telur' : 'Kotak Susu';
  const itemName = boxType === 'telur' ? 'Telur' : 'Susu';
  const icon = boxType === 'telur' ? '🥚' : '🥛';

  if (count <= 0) {
    showNotif(`📦 ${boxName} masih kosong (0/${MAX_BOX_CAPACITY}). Beri makan ${boxType === 'telur' ? 'Ayam' : 'Sapi'} terlebih dahulu!`);
    return;
  }

  state.inventory.ternak[boxType] = (state.inventory.ternak[boxType] || 0) + count;
  state.boxStorage[boxType] = 0;
  updateProductBoxVisuals(boxType);
  playHoldAction('letakkan_telur');

  const boxObj = productBoxes[boxType];
  if (boxObj && boxObj.position) {
    emitWaterSplash(boxObj.position);
  }

  showNotif(`${icon} +${count} ${itemName} diambil dari ${boxName} dan masuk ke inventori!`);
  refreshHUD();
  refreshHotbar();
  updateHeldItem();
  refreshInventory();
  saveGame();
}

function updateAnimals(dt) {
  for (const a of state.animals) {
    if (a.producing) {
      const boxKey = a.type === 'ayam' ? 'telur' : 'susu';
      if ((state.boxStorage[boxKey] || 0) >= MAX_BOX_CAPACITY) {
        // Jika kotak penampung penuh, tahan timer sampai kotak dikosongkan
        if (a.productTimer > 0) {
          a.productTimer = Math.max(0, a.productTimer - dt);
        }
      } else {
        a.productTimer -= dt;
        if (a.productTimer <= 0) {
          a.producing = false;
          a.productReady = false;
          a.productTimer = 0;
          storeAnimalProductInBox(a);
        }
      }
    }

    if (a.happyTimer > 0) {
      a.happyTimer -= dt;
      if (a.emojiSprite) {
        a.emojiSprite.position.y = (a.type === 'sapi' ? 1.8 : 0.95) + Math.sin(performance.now() * 0.006) * 0.08;
        if (a.happyTimer <= 0) {
          a.emojiSprite.visible = false;
        }
      }
    }

    a.timer -= dt;
    const mx = a.mesh.position.x, mz = a.mesh.position.z;
    const dx = a.target.x - mx, dz = a.target.z - mz;
    const dist = Math.sqrt(dx * dx + dz * dz);
    let isWalking = false;
    if (a.timer <= 0 || dist < 0.3) {
      if (a.timer <= 0) {
        const ang = Math.random() * Math.PI * 2;
        const r = Math.random() * a.penRadius * 0.7;
        a.target.x = a.penCenter.x + Math.cos(ang) * r;
        a.target.z = a.penCenter.z + Math.sin(ang) * r;
        a.timer = 2 + Math.random() * 4;
      }
    } else {
      isWalking = true;
      const spd = a.speed * dt;
      a.mesh.position.x += (dx / dist) * spd;
      a.mesh.position.z += (dz / dist) * spd;
      const targetYaw = Math.atan2(dx, dz);
      a.mesh.rotation.y = lerpAngle(a.mesh.rotation.y, targetYaw, Math.min(1, dt * 8));
    }

    if (a.type === 'sapi') {
      updateCowProceduralAnimation(a, dt, isWalking);
    } else if (a.type === 'ayam') {
      updateChickenProceduralAnimation(a, dt, isWalking);
    }
  }
}

