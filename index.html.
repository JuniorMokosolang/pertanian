function sanitizeShopGLBScene(shopScene, shopType) {
  const matPool = SHOP_SYNC_MAT_POOL[shopType] || [];
  let poolIdx = 0;
  const assignedMatMap = new Map();
  let primaryShopMesh = null;

  shopScene.position.set(0, 0, 0);
  shopScene.rotation.set(0, 0, 0);
  shopScene.scale.set(1, 1, 1);
  shopScene.visible = true;

  shopScene.traverse(child => {
    child.visible = true;
    child.frustumCulled = false;

    if (child.isMesh) {
      child.castShadow = true;
      child.receiveShadow = true;

      // Pastikan atribut vertex color VEC4 (RGBA) dikonversi ke VEC3 (RGB) agar shader MeshStandardMaterial
      // tidak mengalikan alpha vertex atau memicu discard transparan di beberapa GPU
      if (child.geometry && child.geometry.attributes && child.geometry.attributes.color) {
        const colAttr = child.geometry.attributes.color;
        if (colAttr.itemSize === 4) {
          const count = colAttr.count;
          const rgbArr = new Float32Array(count * 3);
          for (let i = 0; i < count; i++) {
            rgbArr[i * 3]     = colAttr.getX(i);
            rgbArr[i * 3 + 1] = colAttr.getY(i);
            rgbArr[i * 3 + 2] = colAttr.getZ(i);
          }
          child.geometry.setAttribute('color', new THREE.BufferAttribute(rgbArr, 3));
        }
      }

      const hasVertexColors = Boolean(child.geometry && child.geometry.attributes && child.geometry.attributes.color);

      const convertOneMaterial = srcMat => {
        if (!srcMat) return srcMat;
        let targetMat = assignedMatMap.get(srcMat);
        if (!targetMat) {
          targetMat = poolIdx < matPool.length
            ? matPool[poolIdx++]
            : new THREE.MeshStandardMaterial();
          assignedMatMap.set(srcMat, targetMat);
        }

        targetMat.name = srcMat.name || '';
        if (srcMat.color) targetMat.color.copy(srcMat.color);
        else targetMat.color.setHex(0xffffff);

        if (typeof srcMat.roughness === 'number') targetMat.roughness = srcMat.roughness;
        if (typeof srcMat.metalness === 'number') targetMat.metalness = srcMat.metalness;
        if (srcMat.emissive) targetMat.emissive.copy(srcMat.emissive);
        if (typeof srcMat.emissiveIntensity === 'number') targetMat.emissiveIntensity = srcMat.emissiveIntensity;

        if (srcMat.map) {
          srcMat.map.colorSpace = THREE.SRGBColorSpace;
          srcMat.map.needsUpdate = true;
          targetMat.map = srcMat.map;
          // Untuk material bertekstur (papan nama, bungkus bibit, kemasan susu), gunakan warna murni tekstur
          targetMat.color.setHex(0xffffff);
          targetMat.vertexColors = false;
        } else {
          targetMat.map = null;
          targetMat.vertexColors = hasVertexColors;
        }

        // Paksa seluruh properti visibilitas material agar 100% terlihat jelas (tidak transparan / tersembunyi)
        targetMat.visible = true;
        targetMat.transparent = false;
        targetMat.opacity = 1.0;
        targetMat.alphaTest = 0;
        targetMat.colorWrite = true;
        targetMat.depthWrite = true;
        targetMat.depthTest = true;
        targetMat.side = THREE.DoubleSide;
        targetMat.needsUpdate = true;
        return targetMat;
      };

      if (Array.isArray(child.material)) {
        child.material = child.material.map(convertOneMaterial);
      } else if (child.material) {
        child.material = convertOneMaterial(child.material);
      }

      if (!primaryShopMesh || child.name === 'meja_kasir' || child.name === 'papan_nama') {
        if (child.name === 'meja_kasir' || !primaryShopMesh) {
          primaryShopMesh = child;
        }
      }
    }
  });

  return primaryShopMesh;
}

function buildShop(pos, name, awColor, shopType) {
  const g = new THREE.Group();
  g.name = 'ShopGroup_' + shopType;
  // Pastikan posisi vertikal grup induk berada tepat di permukaan tanah (y = 0) dan menghadap ke arah jalan/Rumah Petani (-Z)
  g.position.set(pos.x, 0, pos.z);
  g.rotation.set(0, Math.PI, 0);
  g.scale.set(1, 1, 1);
  g.visible = true;
  scene.add(g);

  // Titik interaksi di bagian depan meja kasir (z = pos.z - 1.0)
  const interactPos = new THREE.Vector3(pos.x, 0, pos.z - 1.0);
  const iaEntry = {
    mesh: g,
    type: 'shop',
    shopType,
    position: interactPos,
    buildingPos: new THREE.Vector3(pos.x, 0, pos.z),
    group: g,
    shopName: name
  };
  interactables.push(iaEntry);

  // Collider kotak akurat (outdoorBoxColliders) sesuai koordinat X & Z toko baru yang telah diperlebar
  outdoorBoxColliders.push({
    minX: pos.x - 2.38,
    maxX: pos.x + 2.38,
    minZ: pos.z - 1.52,
    maxZ: pos.z + 1.98
  });

  // Pijakan lantai kayu depan toko (y = 0.12) sesuai posisi X baru
  if (houseRefs && Array.isArray(houseRefs.stepAndPorchBoxes)) {
    houseRefs.stepAndPorchBoxes.push({
      id: 'lantai_toko_' + shopType,
      minX: pos.x - 2.58,
      maxX: pos.x + 2.58,
      minZ: pos.z - 2.00,
      maxZ: pos.z + 2.00,
      topY: 0.12
    });
  }

  const assetCfg = SHOP_GLB_ASSETS[shopType];
  if (assetCfg) {
    const loader = new GLTFLoader();
    let isLoaded = false;

    const attachShopScene = shopScene => {
      if (!shopScene || isLoaded) return;
      isLoaded = true;

      // Hapus objek lama di dalam grup g terlebih dahulu menggunakan g.remove(oldChild) sebelum menambahkan model GLB baru
      while (g.children.length > 0) {
        g.remove(g.children[0]);
      }

      const primaryShopMesh = sanitizeShopGLBScene(shopScene, shopType);
      g.add(shopScene);
      if (primaryShopMesh) {
        iaEntry.mesh = primaryShopMesh;
      }
    };

    const parseBufferWithFallback = buf => {
      // Gunakan parseGLBBufferDirect terlebih dahulu karena mendukung ekstraksi tekstur PNG ke CanvasTexture
      // tanpa terkendala blob: URL / ImageBitmap di file:// atau WebView, lalu fallback ke GLTFLoader.parse
      try {
        const directScene = parseGLBBufferDirect(buf);
        if (directScene && directScene.children && directScene.children.length > 0) {
          attachShopScene(directScene);
          return;
        }
      } catch (directErr) {
        console.warn(`Direct GLB parser fallback untuk ${shopType}:`, directErr);
      }
      loader.parse(
        buf,
        '',
        gltf => {
          if (gltf && gltf.scene) attachShopScene(gltf.scene);
        },
        err => console.error(`Gagal parse GLB ${shopType}:`, err)
      );
    };

    const loadFromFileFallback = () => {
      loader.load(
        assetCfg.file,
        gltf => {
          if (gltf && gltf.scene) attachShopScene(gltf.scene);
        },
        undefined,
        err => console.error(`Gagal memuat ${assetCfg.file}:`, err)
      );
    };

    if (assetCfg.gzB64 && !assetCfg.gzB64.startsWith('__') && typeof DecompressionStream !== 'undefined') {
      try {
        const binStr = atob(assetCfg.gzB64);
        const gzBytes = new Uint8Array(binStr.length);
        for (let i = 0; i < binStr.length; i++) gzBytes[i] = binStr.charCodeAt(i);
        new Response(new Blob([gzBytes]).stream().pipeThrough(new DecompressionStream('gzip')))
          .arrayBuffer()
          .then(buf => parseBufferWithFallback(buf))
          .catch(err => {
            console.warn(`Gagal dekompresi GZip GLB ${shopType}, mencoba ${assetCfg.file}:`, err);
            loadFromFileFallback();
          });
      } catch (e) {
        console.warn(`Fallback ke ${assetCfg.file}:`, e);
        loadFromFileFallback();
      }
    } else {
      loadFromFileFallback();
    }
  }

  return g;
}

