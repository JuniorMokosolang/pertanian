function buildCowBarn(cfg, label) {
  const S = 1.15;
  const barnRoot = new THREE.Group();
  barnRoot.position.set(cfg.x, 0, cfg.z);
  barnRoot.rotation.y = COW_BARN_ROT_Y;
  scene.add(barnRoot);

  // Offset -0.85 in local X so the main barn room & front doorway center align with (cfg.x, cfg.z)
  const barnModel = new THREE.Group();
  barnModel.scale.setScalar(S);
  barnModel.position.set(-0.85 * S, 0, 0);
  barnRoot.add(barnModel);

  // Interior floor (empty room floor + side shed ground + doorway threshold + front path)
  const roomFloor = new THREE.Mesh(
    new THREE.PlaneGeometry(3.92, 4.32),
    new THREE.MeshStandardMaterial({ color: 0x8B6B4A, roughness: 0.95 })
  );
  roomFloor.rotation.x = -Math.PI / 2;
  roomFloor.position.set(0.85, 0.015, 0);
