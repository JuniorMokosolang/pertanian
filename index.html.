let isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
const TAP_DRAG_THRESHOLD = 4.5;
const mobileInput = {
