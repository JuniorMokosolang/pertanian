const _animEuler = new THREE.Euler(0, 0, 0, 'XYZ');
const _animQuatDelta = new THREE.Quaternion();
const _animQuatTarget = new THREE.Quaternion();
const _animQuatIdle = new THREE.Quaternion();
const _animQuatLoco = new THREE.Quaternion();
