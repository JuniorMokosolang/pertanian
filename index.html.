    }
    treeGroup.visible = true;
    sanitizePohonModel(templateRoot);

    // Hitung batas bawah batang (min.y) agar pangkal batang menapak pas di permukaan tanah (position.y = 0)
    templateRoot.position.set(0, 0, 0);
    templateRoot.rotation.set(0, 0, 0);
    templateRoot.scale.set(1, 1, 1);
    templateRoot.updateMatrixWorld(true);
    const bbox = new THREE.Box3().setFromObject(templateRoot);
    const baseOffsetY = isFinite(bbox.min.y) ? -bbox.min.y : 0;

    for (let i = 0; i < treePlacements.length; i++) {
      const tp = treePlacements[i];
      const treeClone = templateRoot.clone(true);
      sanitizePohonModel(treeClone);
      treeClone.scale.set(tp.sc, tp.sc, tp.sc);
      treeClone.rotation.set(0, tp.rot, 0);
      treeClone.position.set(tp.x, baseOffsetY * tp.sc, tp.z);
      treeClone.updateMatrixWorld(true);
      treeGroup.add(treeClone);
    }
  }

  // Template sinkron sesuai hirarki node asli "pohon.glb":
  // root node "pohon" -> "batang" ("Mat_Batang_VertexColor") dan "kanopi" -> "daun_01" s/d "daun_38" ("Mat_Daun_DoubleSided_VertexColor")
  function createSyncPohonTemplate() {
    const root = new THREE.Group();
    root.name = 'pohon';

    function paintGeoColors(geo, rBase, gBase, bBase, variation) {
      const nonIndexed = geo.index ? geo.toNonIndexed() : geo;
      const pos = nonIndexed.attributes.position;
      const count = pos.count;
      const colors = new Float32Array(count * 3);
      for (let i = 0; i < count; i++) {
        const vx = pos.getX(i), vy = pos.getY(i), vz = pos.getZ(i);
        const n = Math.sin(vx * 5.3 + vy * 7.1 + vz * 6.7) * variation;
        const hBoost = vy > 2.5 ? 0.04 : -0.02;
        colors[i * 3]     = Math.min(1, Math.max(0, rBase + n + hBoost));
        colors[i * 3 + 1] = Math.min(1, Math.max(0, gBase + n * 1.1 + hBoost));
        colors[i * 3 + 2] = Math.min(1, Math.max(0, bBase + n * 0.8 + hBoost));
      }
      nonIndexed.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      nonIndexed.computeVertexNormals();
      return nonIndexed;
    }

    // Node "batang" (pangkal batang tepat di y = 0, tinggi ~3.4 unit dengan cabang utama)
    const trunkGeo = new THREE.CylinderGeometry(0.28, 0.48, 3.2, 9, 4);
    trunkGeo.translate(0, 1.6, 0);
    const batangMesh = new THREE.Mesh(paintGeoColors(trunkGeo, 0.44, 0.29, 0.17, 0.04), MAT_POHON_BATANG_SYNC);
    batangMesh.name = 'batang';
    root.add(batangMesh);

    // Node "kanopi" -> "daun_01" s/d "daun_38"
    const kanopiGroup = new THREE.Group();
    kanopiGroup.name = 'kanopi';
    const baseLeafGeo = new THREE.IcosahedronGeometry(1.05, 1);

    for (let i = 0; i < 38; i++) {
      const layer = i < 16 ? 0 : (i < 30 ? 1 : 2);
      const countInLayer = layer === 0 ? 16 : (layer === 1 ? 14 : 8);
      const idxInLayer = layer === 0 ? i : (layer === 1 ? i - 16 : i - 30);
      const angle = (idxInLayer / countInLayer) * Math.PI * 2 + layer * 0.45;
      const ringRadius = layer === 0 ? (1.85 + (i % 3) * 0.35) : (layer === 1 ? (1.25 + (i % 2) * 0.30) : (0.55 * (idxInLayer > 0 ? 1 : 0)));
      const ly = layer === 0 ? (3.1 + (i % 3) * 0.28) : (layer === 1 ? (4.15 + (i % 3) * 0.25) : (5.05 + (i % 2) * 0.25));
      const lx = Math.cos(angle) * ringRadius;
      const lz = Math.sin(angle) * ringRadius;

      const gShade = 0.36 + ((i * 19) % 15) * 0.012 + layer * 0.04;
      const rShade = 0.16 + ((i * 13) % 9) * 0.008 + layer * 0.02;
      const bShade = 0.11 + ((i * 7) % 7) * 0.006;

      const dGeo = paintGeoColors(baseLeafGeo.clone(), rShade, gShade, bShade, 0.035);
      const dMesh = new THREE.Mesh(dGeo, MAT_POHON_DAUN_SYNC);
      dMesh.name = 'daun_' + String(i + 1).padStart(2, '0');
      dMesh.position.set(lx, ly, lz);
      const sx = 0.95 + (i % 4) * 0.12;
      const sy = 0.78 + (i % 3) * 0.10;
      const sz = 0.95 + ((i + 2) % 4) * 0.12;
      dMesh.scale.set(sx, sy, sz);
      dMesh.rotation.set((i * 0.3) % 0.5, angle, (i * 0.2) % 0.5);
      kanopiGroup.add(dMesh);
    }
    root.add(kanopiGroup);
    return root;
  }

  // Tampilkan pohon sinkron terlebih dahulu agar tidak pernah kosong/hilang
  spawnAllTreesFromTemplate(createSyncPohonTemplate());

  // Muat file asli "pohon.glb" menggunakan GLTFLoader dan ganti seluruh pohon di dalam treeGroup saat selesai dimuat
  const gltfLoader = new GLTFLoader();
  gltfLoader.load(
    './pohon.glb',
    (gltf) => {
      const rootNode = (gltf && gltf.scene) ? (gltf.scene.getObjectByName('pohon') || gltf.scene) : null;
      if (rootNode) {
        rootNode.position.set(0, 0, 0);
        rootNode.rotation.set(0, 0, 0);
        rootNode.scale.set(1, 1, 1);
        spawnAllTreesFromTemplate(rootNode);
      }
    },
    undefined,
    (err) => {
      console.warn('Info: menggunakan template sinkron pohon karena pemuatan ./pohon.glb gagal:', err);
    }
  );
})();

