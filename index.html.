  }

  const btnCloseGfxX = document.getElementById('pnl-gfx-cl');
  if (btnCloseGfxX) {
    btnCloseGfxX.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      closeGraphicsSettingModal();
    });
  }

  if (pnlGraphicsSettingEl) {
    pnlGraphicsSettingEl.addEventListener('click', e => {
      if (e.target === pnlGraphicsSettingEl) {
        closeGraphicsSettingModal();
      }
    });
  }
}

initMainMenuAndSettings();

function gameLoop(time) {
  requestAnimationFrame(gameLoop);
  let dt = (time - lastTime) / 1000;
  lastTime = time;
  if (dt > 0.05) dt = 0.05;
  if (dt <= 0) return;

  updateTouchHUDVisibility();

  // 0a. Animasi Transisi Teleport (Zoom In -> Putih Penuh + Pindah Lokasi -> Zoom Out)
  updateTeleportTransition(dt);

  // 0b. Animasi Tidur & Bangun Tidur (Zoom In -> Gelap Penuh + Skip 3 Menit -> Zoom Out)
  updateSleepTransition(dt);

  // 0c. Sistem Waktu Game (In-Game Time) & Siklus Pencahayaan Siang-Sore-Malam Halus
  updateDayNightCycle(dt);

  // 1. Player movement & animation (terkunci selama di Main Menu, panel terbuka, transisi teleport, atau sedang tidur)
  if (!state.inLobby && !state.panelOpen && !teleportState.active && !state.isSleeping) {
    updatePlayer(dt);
  } else {
    currentMoveSpeed = 0;
    isRunningState = false;
    isMoving = false;
    if (!sleepState.lyingOnBed) {
      targetGroundY = state.isInsideHouse
        ? (INTERIOR_ORIGIN.y || 0)
        : getSurfaceHeight(playerGroup.position.x, playerGroup.position.z);
      currentGroundY += (targetGroundY - currentGroundY) * 0.3;
      if (Math.abs(targetGroundY - currentGroundY) < 0.0005) {
        currentGroundY = targetGroundY;
      }
      walkBobOffset = 0;
      playerGroup.position.y = currentGroundY;
      perbaruiAnimasiKarakter(dt, 0, false);
    }
  }

  // 2. Camera tracking: gunakan Kamera Panorama Sinematik saat di Main Menu, atau Kamera Gameplay saat bermain
  if (state.inLobby && mainMenuState.active) {
    updateCinematicMenuCamera(dt);
  } else {
    updateCamera(dt);
  }

  // 3. Directional shadow follow
  updateShadow();

  // 4. Farming growth loop & plot spawn animations
  updateFarming(dt);

  // 5. Skin particle visual rotation on held bucket
  if (heldBucket.visible) {
    updateSkinBucketVisual(time, dt);
  }

  // 6. Particles update
  updateParticles(dt);

  // 7. Animals (wandering, feeding, production timer)
  updateAnimals(dt);

  // 8. Hover highlight
  if (!state.inLobby && !state.panelOpen && !teleportState.active && !state.isSleeping) updateHover();

  // 9. Contextual UI
  if (!state.inLobby) {
    updateContextualUI();
  }

  // 10. Update Rumput Hidup (Frustum Culling + LOD + Wind Shader)
  if (typeof updateLivingGrass === 'function') {
    updateLivingGrass(time * 0.001, dt, camera);
  }

  // Render scene 3D utama
  try {
    renderer.render(scene, camera);
  } catch (renderErr) {
    console.error('Render error:', renderErr);
  }
}

// ==================== INIT ====================
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
  updateMainMenuResponsiveLayout();
});
window.addEventListener('orientationchange', () => {
  setTimeout(updateMainMenuResponsiveLayout, 80);
});

// Single event listener registrations for shop action buttons
const btnGrass = document.getElementById('btn-grass-quality');
if (btnGrass) btnGrass.onclick = toggleGrassQuality;

const btnBuyAnimal = document.getElementById('btn-buy-animal-action');
if (btnBuyAnimal) btnBuyAnimal.onclick = handleBuyAnimal;

const btnSellTernak = document.getElementById('btn-sell-ternak-action');
if (btnSellTernak) {
  btnSellTernak.onclick = () => {
    if (!selectedTernakProduct) {
      showNotif('Pilih produk terlebih dahulu!');
      return;
    }
    const price = selectedTernakProduct === 'telur' ? (CONFIG.eggSellPrice ?? 5) : (CONFIG.milkSellPrice ?? 10);
    handleSellTernak(selectedTernakProduct, price);
  };
}

loadGame();
updateDayNightCycle(0, true);
refreshHotbar();
updateHeldItem();
refreshHUD();
refreshInventory();

// Auto-save berkala & saat tab/browser ditutup atau disembunyikan untuk menjaga akurasi Offline Progress (lastSavedTime)
setInterval(() => {
  saveGame();
}, 5000);
window.addEventListener('beforeunload', () => {
  saveGame();
});
window.addEventListener('pagehide', () => {
  saveGame();
});
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'hidden') {
    saveGame();
  }
});

requestAnimationFrame(gameLoop);
</script>
