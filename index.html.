const holdState = {
  equippedKey: null,     // Kunci di ITEM_HOLD_DATA (misal 'cangkul', 'bibit_wortel', 'panen_jagung', atau null saat Unequip)
  activeCategory: null,  // Objek pose dari HOLD_POSE_CATEGORIES
  lastCategory: null,    // Kategori terakhir untuk blend keluar yang halus saat Unequip()
  holdBlend: 0.0,        // 0.0 = Idle bersedekap asli (IDLE_POSE_DEG), 1.0 = Pose pegang aktif
  actionName: null,      // Nama aksi aktif dari HOLD_ACTION_POSES
  actionTimer: 0.0,
  actionDuration: 0.48
};

// Fungsi konversi item hotbar/string menjadi key di ITEM_HOLD_DATA
function resolveHoldDataKey(itemOrKey) {
  if (!itemOrKey) return null;
  if (typeof itemOrKey === 'string') {
    if (ITEM_HOLD_DATA[itemOrKey]) return itemOrKey;
    return null;
  }
  if (itemOrKey.type === 'tool') return itemOrKey.id; // 'ember' | 'cangkul'
  if (itemOrKey.type === 'livestock') return itemOrKey.id; // 'telur' | 'susu'
  if (itemOrKey.type === 'seed') return 'bibit_' + itemOrKey.id;
  if (itemOrKey.type === 'crop') return 'panen_' + itemOrKey.id;
  return null;
}

// Fungsi Equip(item): memasang item ke socket HandGrip & mengaktifkan pose pegang sesuai kategori
function Equip(itemOrKey) {
  for (const entry of Object.values(ITEM_HOLD_DATA)) {
    if (entry.mesh) entry.mesh.visible = false;
  }

  const key = resolveHoldDataKey(itemOrKey);
  const data = key ? ITEM_HOLD_DATA[key] : null;
  if (!data) {
    Unequip();
    return;
  }

  holdState.equippedKey = key;
  holdState.activeCategory = HOLD_POSE_CATEGORIES[data.category] || HOLD_POSE_CATEGORIES.satu_tangan;
  holdState.lastCategory = holdState.activeCategory;

  // Terapkan offset posisi, rotasi (derajat -> radian), dan skala pada container di dalam HandGrip
  heldGroup.position.set(data.offset.x, data.offset.y, data.offset.z);
  heldGroup.rotation.set(
    data.rotation.x * (Math.PI / 180),
    data.rotation.y * (Math.PI / 180),
    data.rotation.z * (Math.PI / 180),
    'XYZ'
  );
  heldGroup.scale.setScalar(data.scale ?? 1.0);

  if (data.mesh) {
    data.mesh.visible = true;
  }
  if (key === 'ember') {
    updateHeldSkinVisual();
  }
}

// Fungsi Unequip(): menyembunyikan item dan mengembalikan karakter ke animasi IDLE lama (bersedekap) dengan transisi halus
function Unequip() {
  for (const entry of Object.values(ITEM_HOLD_DATA)) {
    if (entry.mesh) entry.mesh.visible = false;
  }
  holdState.equippedKey = null;
  holdState.activeCategory = null;
  holdState.actionName = null;
  holdState.actionTimer = 0;
}

// Fungsi memicu 1 animasi aksi sederhana sesuai kategori, lalu kembali ke pose pegang
function playHoldAction(customActionName) {
  const data = holdState.equippedKey ? ITEM_HOLD_DATA[holdState.equippedKey] : null;
  const actKey = customActionName || (data ? data.action : null);
  if (!actKey || !HOLD_ACTION_POSES[actKey]) return;
  holdState.actionName = actKey;
  holdState.actionDuration = HOLD_ACTION_POSES[actKey].duration || 0.48;
  holdState.actionTimer = holdState.actionDuration;
}

