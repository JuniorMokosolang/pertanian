function smoothstep01(x) {
  const t = x < 0 ? 0 : (x > 1 ? 1 : x);
  return t * t * (3 - 2 * t);
}

function setDeltaQuatFromDeg(outQuat, rxDeg, ryDeg, rzDeg) {
  _animEuler.set(rxDeg * DEG2RAD, ryDeg * DEG2RAD, rzDeg * DEG2RAD, 'XYZ');
  outQuat.setFromEuler(_animEuler);
  return outQuat;
}

function slerpNodeToDeltaDeg(nodeName, rxDeg, ryDeg, rzDeg, slerpFactor) {
  const node = petaniRig.nodes[nodeName];
  const restQ = petaniRig.restQuat[nodeName];
  if (!node || !restQ) return;
  setDeltaQuatFromDeg(_animQuatDelta, rxDeg, ryDeg, rzDeg);
  _animQuatTarget.copy(restQ).multiply(_animQuatDelta);
  node.quaternion.slerp(_animQuatTarget, slerpFactor);
}

function slerpNodeBlendedIdleLoco(nodeName, idleX, idleY, idleZ, locoX, locoY, locoZ, moveBlend, slerpFactor) {
  const node = petaniRig.nodes[nodeName];
  const restQ = petaniRig.restQuat[nodeName];
  if (!node || !restQ) return;
  setDeltaQuatFromDeg(_animQuatIdle, idleX, idleY, idleZ);
  setDeltaQuatFromDeg(_animQuatLoco, locoX, locoY, locoZ);
  _animQuatIdle.slerp(_animQuatLoco, moveBlend);
  _animQuatTarget.copy(restQ).multiply(_animQuatIdle);
  node.quaternion.slerp(_animQuatTarget, slerpFactor);
}

// Blend Quaternion antara pose tanpa item (Idle bersedekap <-> Jalan/Lari) dan pose pegang item (holdW: 0..1)
function slerpNodeWithHold(
  nodeName,
  idleX, idleY, idleZ,
  locoX, locoY, locoZ,
  holdX, holdY, holdZ,
  moveBlend, holdBlend, slerpFactor
) {
  const node = petaniRig.nodes[nodeName];
  const restQ = petaniRig.restQuat[nodeName];
  if (!node || !restQ) return;
  setDeltaQuatFromDeg(_animQuatIdle, idleX, idleY, idleZ);
  setDeltaQuatFromDeg(_animQuatLoco, locoX, locoY, locoZ);
  _animQuatIdle.slerp(_animQuatLoco, moveBlend);
  if (holdBlend > 0.0001) {
    setDeltaQuatFromDeg(_animQuatHold, holdX, holdY, holdZ);
    _animQuatIdle.slerp(_animQuatHold, holdBlend);
  }
  _animQuatTarget.copy(restQ).multiply(_animQuatIdle);
  node.quaternion.slerp(_animQuatTarget, slerpFactor);
}

function setupPetaniRigFromGLTF(gltf) {
  const root = gltf.scene;
  root.scale.setScalar(PLAYER_SCALE);

  const jointNames = [
    'karakter', 'pinggul', 'badan', 'ikat_pinggang', 'kantong_pinggang', 'sarung_tangan',
    'leher', 'kepala', 'topi',
    'bahu_kiri', 'lengan_atas_kiri', 'siku_kiri', 'lengan_bawah_kiri', 'tangan_kiri',
    'bahu_kanan', 'lengan_atas_kanan', 'siku_kanan', 'lengan_bawah_kanan', 'tangan_kanan',
    'paha_kiri', 'lutut_kiri', 'betis_kiri', 'sepatu_kiri',
    'paha_kanan', 'lutut_kanan', 'betis_kanan', 'sepatu_kanan'
  ];

  root.traverse(obj => {
    if (obj.isMesh) {
      obj.castShadow = true;
      obj.receiveShadow = true;
    }
    if (obj.name && jointNames.includes(obj.name)) {
      petaniRig.nodes[obj.name] = obj;
      petaniRig.restQuat[obj.name] = obj.quaternion.clone();
      petaniRig.restPos[obj.name] = obj.position.clone();
    }
  });

  // Hitung titik dasar lokal sepatu_kiri dan sepatu_kanan dari bounding box geometri sepatu
  for (const [sName, targetVec] of [['sepatu_kiri', petaniRig.shoeLeftBottomLocal], ['sepatu_kanan', petaniRig.shoeRightBottomLocal]]) {
    const sNode = petaniRig.nodes[sName];
    if (sNode) {
      let minY = -0.126;
      sNode.traverse(c => {
        if (c.isMesh && c.geometry) {
          c.geometry.computeBoundingBox();
          if (c.geometry.boundingBox && c.geometry.boundingBox.min.y < minY) {
            minY = c.geometry.boundingBox.min.y;
          }
        }
      });
      targetVec.set(0, minY, 0);
    }
  }

  // Pasang socket HandGrip ke tangan_kanan karakter petani
  if (petaniRig.nodes.tangan_kanan) {
    // bahu_kanan memiliki scale.x = -1; set scale (-1, 1, 1) pada HandGrip untuk menetralkan mirror
    handGripSocket.position.set(0.01, -0.08, 0.03);
    handGripSocket.scale.set(-1, 1, 1);
    petaniRig.nodes.tangan_kanan.add(handGripSocket);
  }

  fallbackPlayerGroup.visible = false;
  petaniRig.root = root;
  playerBodyGroup.add(root);
  petaniRig.loaded = true;

  // Sinkronkan item yang sedang dipegang di hotbar
  updateHeldItem();

  // Terapkan pose awal langsung agar tidak berkedip
  perbaruiAnimasiKarakter(0.016, 0, false);
}

function loadPetaniCharacter() {
  try {
    if (!PETANI_GLB_B64 || PETANI_GLB_B64.startsWith('__')) {
      throw new Error('Base64 petani.glb belum tersedia');
    }
    const binStr = atob(PETANI_GLB_B64);
    const len = binStr.length;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) {
      bytes[i] = binStr.charCodeAt(i);
    }
    const loader = new GLTFLoader();
    loader.parse(
      bytes.buffer,
      '',
      gltf => {
        setupPetaniRigFromGLTF(gltf);
      },
      err => {
        console.warn('Gagal memuat petani.glb dengan GLTFLoader.parse(), memakai karakter lama:', err);
        fallbackPlayerGroup.visible = true;
      }
    );
  } catch (err) {
    console.warn('Gagal memuat petani.glb, memakai karakter lama:', err);
    fallbackPlayerGroup.visible = true;
  }
}

function perbaruiAnimasiKarakter(dt, kecepatan, sedangLari) {
  if (!petaniRig.loaded) {
    // Fallback karakter lama jika petani.glb gagal dimuat
    const damp = 0.85;
    if (kecepatan > 0.05) {
      const sw = Math.sin(walkPhase) * 0.6;
      lArmPivot.rotation.x = sw; rArmPivot.rotation.x = -sw;
      lLegPivot.rotation.x = -sw; rLegPivot.rotation.x = sw;
    } else {
      lArmPivot.rotation.x *= damp; rArmPivot.rotation.x *= damp;
      lLegPivot.rotation.x *= damp; rLegPivot.rotation.x *= damp;
    }
    return;
  }

  // Penghalusan eksponensial sendi: 1 - exp(-dt * k), k sekitar 12
  const jointAlpha = 1 - Math.exp(-dt * ANIM_JOINT_SMOOTH_K);
  const transRate = 1 / Math.max(0.05, ANIM_TRANSITION_DURATION);

  // Transisi halus diam <-> jalan <-> lari (~0.2 - 0.3 detik) dengan kurva smoothstep
  const targetMove = kecepatan > 0.08 ? 1.0 : 0.0;
  if (petaniRig.moveBlend < targetMove) {
    petaniRig.moveBlend = Math.min(1.0, petaniRig.moveBlend + dt * transRate);
  } else if (petaniRig.moveBlend > targetMove) {
    petaniRig.moveBlend = Math.max(0.0, petaniRig.moveBlend - dt * transRate);
  }
  const moveW = smoothstep01(petaniRig.moveBlend);

  const targetRun = (sedangLari && kecepatan > CONFIG.playerSpeed + 0.5) ? 1.0 : 0.0;
  if (petaniRig.runBlend < targetRun) {
    petaniRig.runBlend = Math.min(1.0, petaniRig.runBlend + dt * transRate);
  } else if (petaniRig.runBlend > targetRun) {
    petaniRig.runBlend = Math.max(0.0, petaniRig.runBlend - dt * transRate);
  }
  const runW = smoothstep01(petaniRig.runBlend);

  // 1. UPDATE FASE NAPAS, PINDAH TUMPUAN, & TOLEHAN KEPALA (SAAT DIAM)
  const breathOmega = (Math.PI * 2 / IDLE_BREATH_PERIOD) * petaniRig.breathFreqMod;
  const prevBreathCycle = Math.floor(petaniRig.breathPhase / (Math.PI * 2));
  petaniRig.breathPhase += dt * breathOmega;
  if (Math.floor(petaniRig.breathPhase / (Math.PI * 2)) !== prevBreathCycle) {
    // Variasi kecil acak pada frekuensi napas tiap siklus
    petaniRig.breathFreqMod = 0.92 + Math.random() * 0.16;
  }
  const breathSin = Math.sin(petaniRig.breathPhase);

  // Pindah tumpuan berat tubuh tiap 4 - 7 detik (acak) selama 1.2 detik dengan smoothstep
  petaniRig.shiftTimer -= dt;
  if (petaniRig.shiftTimer <= 0) {
    petaniRig.shiftTimer = IDLE_SHIFT_INTERVAL_MIN + Math.random() * (IDLE_SHIFT_INTERVAL_MAX - IDLE_SHIFT_INTERVAL_MIN);
    petaniRig.shiftFrom = petaniRig.shiftCurrent;
    // Pilih sisi tumpuan baru (-1, 0, atau +1) yang berbeda dari posisi saat ini
    const choices = [-1, 0, 1].filter(v => Math.abs(v - petaniRig.shiftCurrent) > 0.4);
    petaniRig.shiftTo = choices[Math.floor(Math.random() * choices.length)];
    petaniRig.shiftProgress = 0;
  }
  if (petaniRig.shiftProgress < 1.0) {
    petaniRig.shiftProgress = Math.min(1.0, petaniRig.shiftProgress + dt / IDLE_SHIFT_DURATION);
    const st = smoothstep01(petaniRig.shiftProgress);
    petaniRig.shiftCurrent = petaniRig.shiftFrom + (petaniRig.shiftTo - petaniRig.shiftFrom) * st;
  }
  const shiftVal = petaniRig.shiftCurrent * (1 - moveW);

  // Kepala menoleh pelan ±15 derajat ke kiri/kanan tiap 3 - 6 detik lalu kembali
  petaniRig.lookTimer -= dt;
  if (petaniRig.lookTimer <= 0) {
    petaniRig.lookFrom = petaniRig.lookCurrentDeg;
    if (petaniRig.lookState === 'center') {
      petaniRig.lookState = 'turned';
      const dir = Math.random() < 0.5 ? -1 : 1;
      const amp = IDLE_LOOK_YAW_DEG * (0.65 + Math.random() * 0.35);
      petaniRig.lookTo = dir * amp;
      petaniRig.lookDuration = 0.9 + Math.random() * 0.4;
      petaniRig.lookTimer = 1.6 + Math.random() * 1.4; // Tahan sebentar sebelum kembali ke tengah
    } else {
      petaniRig.lookState = 'center';
      petaniRig.lookTo = 0;
      petaniRig.lookDuration = 0.9 + Math.random() * 0.4;
      petaniRig.lookTimer = IDLE_LOOK_INTERVAL_MIN + Math.random() * (IDLE_LOOK_INTERVAL_MAX - IDLE_LOOK_INTERVAL_MIN);
    }
    petaniRig.lookProgress = 0;
  }
  if (petaniRig.lookProgress < 1.0) {
    petaniRig.lookProgress = Math.min(1.0, petaniRig.lookProgress + dt / petaniRig.lookDuration);
    const lt = smoothstep01(petaniRig.lookProgress);
    petaniRig.lookCurrentDeg = petaniRig.lookFrom + (petaniRig.lookTo - petaniRig.lookFrom) * lt;
  }

  // 2. UPDATE FASE LANGKAH JALAN / LARI (Frekuensi sebanding kecepatan, fase tidak di-reset)
  if (kecepatan > 0.01) {
    const walkFreq = 1.0 / WALK_CYCLE_PERIOD;
    const runFreq = 1.0 / RUN_CYCLE_PERIOD;
    const baseSpeedRef = CONFIG.playerSpeed + (CONFIG.playerRunSpeed - CONFIG.playerSpeed) * runW;
    const targetFreq = (walkFreq + (runFreq - walkFreq) * runW) * (kecepatan / Math.max(0.1, baseSpeedRef));
    petaniRig.gaitPhase += dt * targetFreq * Math.PI * 2;
  }
  const phi = petaniRig.gaitPhase;
  const sinPhi = Math.sin(phi);
  const cosPhi = Math.cos(phi);

  // 3. HITUNG POSE IDLE (BERSEDEKAP + NAPAS + PINDAH TUMPUAN)
  const idleBodyX = breathSin * IDLE_BREATH_BODY_X_DEG;
  const idleHipZ = shiftVal * IDLE_SHIFT_HIP_Z_DEG;
  const idleArmSway = breathSin * IDLE_BREATH_ARM_DEG;

  const idleBahuKiriX = IDLE_POSE_DEG.bahu_kiri.x + idleArmSway;
  const idleBahuKiriY = IDLE_POSE_DEG.bahu_kiri.y;
  const idleBahuKiriZ = IDLE_POSE_DEG.bahu_kiri.z - Math.max(0, breathSin) * 0.8;

  const idleBahuKananX = IDLE_POSE_DEG.bahu_kanan.x + idleArmSway;
  const idleBahuKananY = IDLE_POSE_DEG.bahu_kanan.y;
  const idleBahuKananZ = IDLE_POSE_DEG.bahu_kanan.z + Math.max(0, breathSin) * 0.8;

  const idleSikuKiriX = IDLE_POSE_DEG.siku_kiri.x + idleArmSway * 0.6;
  const idleSikuKiriY = IDLE_POSE_DEG.siku_kiri.y;
  const idleSikuKiriZ = IDLE_POSE_DEG.siku_kiri.z;

  const idleSikuKananX = IDLE_POSE_DEG.siku_kanan.x + idleArmSway * 0.6;
  const idleSikuKananY = IDLE_POSE_DEG.siku_kanan.y;
  const idleSikuKananZ = IDLE_POSE_DEG.siku_kanan.z;

  // Kaki tumpuan sedikit menekuk saat pindah berat tubuh
  const idleKneeLeftX = Math.max(0, -shiftVal) * IDLE_SHIFT_KNEE_DEG;
  const idleKneeRightX = Math.max(0, shiftVal) * IDLE_SHIFT_KNEE_DEG;
  const idleThighLeftX = -idleKneeLeftX * 0.5;
  const idleThighRightX = -idleKneeRightX * 0.5;

  // 4. HITUNG POSE GERAK (JALAN <-> LARI)
  const thighAmp = WALK_THIGH_AMP_DEG + (RUN_THIGH_AMP_DEG - WALK_THIGH_AMP_DEG) * runW;
  const kneeBase = WALK_KNEE_BASE_DEG + (RUN_KNEE_BASE_DEG - WALK_KNEE_BASE_DEG) * runW;
  const kneeAmp = WALK_KNEE_AMP_DEG + (RUN_KNEE_AMP_DEG - WALK_KNEE_AMP_DEG) * runW;
  const shoulderXAmp = WALK_SHOULDER_X_AMP_DEG + (RUN_SHOULDER_X_AMP_DEG - WALK_SHOULDER_X_AMP_DEG) * runW;
  const shoulderZ = WALK_SHOULDER_Z_DEG + (RUN_SHOULDER_Z_DEG - WALK_SHOULDER_Z_DEG) * runW;
  const elbowBase = WALK_ELBOW_BASE_DEG + (RUN_ELBOW_BASE_DEG - WALK_ELBOW_BASE_DEG) * runW;
  const elbowAmp = WALK_ELBOW_AMP_DEG + (RUN_ELBOW_AMP_DEG - WALK_ELBOW_AMP_DEG) * runW;
  const elbowZ = WALK_ELBOW_Z_DEG + (RUN_ELBOW_Z_DEG - WALK_ELBOW_Z_DEG) * runW;
  const hipYawAmp = WALK_HIP_YAW_DEG + (RUN_HIP_YAW_DEG - WALK_HIP_YAW_DEG) * runW;
  const bodyYawAmp = WALK_BODY_YAW_DEG + (RUN_BODY_YAW_DEG - WALK_BODY_YAW_DEG) * runW;
  const bodyLeanX = WALK_BODY_LEAN_DEG + (RUN_BODY_LEAN_DEG - WALK_BODY_LEAN_DEG) * runW;

  // Paha & Lutut: ketika sin(φ) > 0, paha_kiri ke depan (-X) dan paha_kanan ke belakang (+X)
  const locoPahaKiriX = -thighAmp * sinPhi;
  const locoPahaKananX = +thighAmp * sinPhi;
  const locoLututKiriX = kneeBase + kneeAmp * Math.max(0, cosPhi);
  const locoLututKananX = kneeBase + kneeAmp * Math.max(0, -cosPhi);

  // Lengan berlawanan dengan kaki di sisi yang sama:
  // bahu_kiri.x = +shoulderXAmp * sin(φ), bahu_kanan.x = -shoulderXAmp * sin(φ)
  // bahu_kiri.z = -shoulderZ, bahu_kanan.z = +shoulderZ (dibalik tanda Z karena scale.x = -1 pada bahu_kanan)
  const locoBahuKiriX = +shoulderXAmp * sinPhi;
  const locoBahuKiriZ = -shoulderZ;
  const locoBahuKananX = -shoulderXAmp * sinPhi;
  const locoBahuKananZ = +shoulderZ;

  // Siku menekuk (X negatif) saat lengan mengayun ke depan; siku_*.z = -8° (kiri dan kanan sama)
  const locoSikuKiriX = -(elbowBase + elbowAmp * Math.max(0, -sinPhi));
  const locoSikuKananX = -(elbowBase + elbowAmp * Math.max(0, sinPhi));

  // Pinggul memutar sumbu Y searah langkah, badan memutar berlawanan, kepala mengompensasi agar stabil menghadap depan
  const locoHipY = hipYawAmp * sinPhi;
  const locoBodyY = -bodyYawAmp * sinPhi;

  // 5. GERAK SEKUNDER (OVERLAP / LOW-PASS LAG ~0.08 DETIK)
  const secAlpha = 1 - Math.exp(-dt / Math.max(0.01, ANIM_SECONDARY_LAG_TIME));
  const stepBounce = Math.sin(phi * 2) * moveW * (1.2 + runW * 1.5);
  petaniRig.secHeadPitch += ((idleBodyX * 0.4 + stepBounce) - petaniRig.secHeadPitch) * secAlpha;
  petaniRig.secHeadRoll += ((-idleHipZ * 0.4 + cosPhi * moveW * 1.0) - petaniRig.secHeadRoll) * secAlpha;
  petaniRig.secHatPitch += ((petaniRig.secHeadPitch * 1.25 + Math.cos(phi * 2) * moveW * (1.5 + runW * 2.0)) - petaniRig.secHatPitch) * secAlpha;
  petaniRig.secHatRoll += ((petaniRig.secHeadRoll * 1.2) - petaniRig.secHatRoll) * secAlpha;

  // Lengan bawah & tangan sedikit tertinggal dari perubahan arah lengan atas
  const curShoulderXL = idleBahuKiriX * (1 - moveW) + locoBahuKiriX * moveW;
  const curShoulderXR = idleBahuKananX * (1 - moveW) + locoBahuKananX * moveW;
  const velL = (curShoulderXL - petaniRig.lastShoulderXL) / Math.max(0.001, dt);
  const velR = (curShoulderXR - petaniRig.lastShoulderXR) / Math.max(0.001, dt);
  petaniRig.lastShoulderXL = curShoulderXL;
  petaniRig.lastShoulderXR = curShoulderXR;

  const targetLagL = THREE.MathUtils.clamp(-velL * 0.025, -6, 6) * moveW;
  const targetLagR = THREE.MathUtils.clamp(-velR * 0.025, -6, 6) * moveW;
  petaniRig.secForearmL += (targetLagL - petaniRig.secForearmL) * secAlpha;
  petaniRig.secForearmR += (targetLagR - petaniRig.secForearmR) * secAlpha;
  petaniRig.secHandL += (petaniRig.secForearmL * 0.85 - petaniRig.secHandL) * secAlpha;
  petaniRig.secHandR += (petaniRig.secForearmR * 0.85 - petaniRig.secHandR) * secAlpha;

  // 6. HITUNG BLEND POSE PEGANG ITEM (Equip <-> Unequip) & ANIMASI AKSI KATEGORI
  // PENTING: Saat Unequip() (holdState.activeCategory === null), holdW turun halus ke 0
  // dan seluruh sendi lengan kembali 100% ke animasi IDLE asli (IDLE_POSE_DEG bersedekap).
  const targetHold = holdState.activeCategory ? 1.0 : 0.0;
  if (holdState.holdBlend < targetHold) {
    holdState.holdBlend = Math.min(1.0, holdState.holdBlend + dt * transRate);
  } else if (holdState.holdBlend > targetHold) {
    holdState.holdBlend = Math.max(0.0, holdState.holdBlend - dt * transRate);
  }
  const holdW = smoothstep01(holdState.holdBlend);

  const catPose = holdState.activeCategory || holdState.lastCategory || HOLD_POSE_CATEGORIES.satu_tangan;
  const carryWalkBob = Math.sin(phi * 2) * (2.2 + runW * 2.5) * moveW;
  const holdBreathSway = idleArmSway * 0.45 * (1 - moveW);

  // Target lengan kanan saat memegang item
  let holdBahuKananX = catPose.bahu_kanan.x + holdBreathSway + carryWalkBob * 0.5;
  let holdBahuKananY = catPose.bahu_kanan.y;
  let holdBahuKananZ = catPose.bahu_kanan.z;
  let holdSikuKananX = catPose.siku_kanan.x + holdBreathSway * 0.6 - carryWalkBob * 0.8;
  let holdSikuKananY = catPose.siku_kanan.y;
  let holdSikuKananZ = catPose.siku_kanan.z;
  let holdTanganKananX = (catPose.tangan_kanan ? catPose.tangan_kanan.x : 0) + petaniRig.secHandR * 0.4;
  let holdTanganKananY = (catPose.tangan_kanan ? catPose.tangan_kanan.y : 0);
  let holdTanganKananZ = (catPose.tangan_kanan ? catPose.tangan_kanan.z : 0);

  // Target lengan kiri saat memegang item:
  // Jika freeLeftArm === true (tool, bibit, panen satu tangan), tangan kiri tergantung natural saat diam & mengayun saat jalan/lari.
  // Jika freeLeftArm === false (telur, susu, panen dua tangan), tangan kiri ikut menopang item di depan perut.
  let holdBahuKiriX, holdBahuKiriY, holdBahuKiriZ;
  let holdSikuKiriX, holdSikuKiriY, holdSikuKiriZ;
  let holdTanganKiriX, holdTanganKiriY, holdTanganKiriZ;

  if (catPose.freeLeftArm) {
    holdBahuKiriX = (catPose.bahu_kiri.x + holdBreathSway * 0.4) * (1 - moveW) + locoBahuKiriX * moveW;
    holdBahuKiriY = catPose.bahu_kiri.y * (1 - moveW);
    holdBahuKiriZ = catPose.bahu_kiri.z * (1 - moveW) + locoBahuKiriZ * moveW;
    holdSikuKiriX = (catPose.siku_kiri.x + holdBreathSway * 0.3) * (1 - moveW) + locoSikuKiriX * moveW;
    holdSikuKiriY = catPose.siku_kiri.y * (1 - moveW);
    holdSikuKiriZ = catPose.siku_kiri.z * (1 - moveW) + elbowZ * moveW;
    holdTanganKiriX = petaniRig.secHandL;
    holdTanganKiriY = 0;
    holdTanganKiriZ = 0;
  } else {
    holdBahuKiriX = catPose.bahu_kiri.x + holdBreathSway + carryWalkBob * 0.5;
    holdBahuKiriY = catPose.bahu_kiri.y;
    holdBahuKiriZ = catPose.bahu_kiri.z;
    holdSikuKiriX = catPose.siku_kiri.x + holdBreathSway * 0.6 - carryWalkBob * 0.8;
    holdSikuKiriY = catPose.siku_kiri.y;
    holdSikuKiriZ = catPose.siku_kiri.z;
    holdTanganKiriX = (catPose.tangan_kiri ? catPose.tangan_kiri.x : 0) + petaniRig.secHandL * 0.4;
    holdTanganKiriY = (catPose.tangan_kiri ? catPose.tangan_kiri.y : 0);
    holdTanganKiriZ = (catPose.tangan_kiri ? catPose.tangan_kiri.z : 0);
  }

  // Evaluasi animasi aksi per kategori (ayun_cangkul, isi_ember, letakkan_telur, tanam_bibit, angkat_panen)
  let actionBodyPitchExtra = 0;
  if (holdState.actionName && holdState.actionTimer > 0) {
    holdState.actionTimer = Math.max(0, holdState.actionTimer - dt);
    const actDef = HOLD_ACTION_POSES[holdState.actionName];
    if (actDef) {
      const p = 1.0 - (holdState.actionTimer / Math.max(0.05, holdState.actionDuration));
      if (holdState.actionName === 'ayun_cangkul' && actDef.windup && actDef.strike) {
        // Fase 3 tahap untuk ayunan cangkul: angkat (0..0.35) -> ayun tebas (0.35..0.72) -> kembali ke pose pegang (0.72..1.0)
        if (p < 0.35) {
          const w = smoothstep01(p / 0.35);
          actionBodyPitchExtra = actDef.windup.badanX * w;
          holdBahuKananX = THREE.MathUtils.lerp(holdBahuKananX, actDef.windup.bahu_kanan.x, w);
          holdBahuKananY = THREE.MathUtils.lerp(holdBahuKananY, actDef.windup.bahu_kanan.y, w);
          holdBahuKananZ = THREE.MathUtils.lerp(holdBahuKananZ, actDef.windup.bahu_kanan.z, w);
          holdSikuKananX = THREE.MathUtils.lerp(holdSikuKananX, actDef.windup.siku_kanan.x, w);
          holdSikuKananZ = THREE.MathUtils.lerp(holdSikuKananZ, actDef.windup.siku_kanan.z, w);
          holdTanganKananX = THREE.MathUtils.lerp(holdTanganKananX, actDef.windup.tangan_kanan.x, w);
        } else if (p < 0.72) {
          const w = smoothstep01((p - 0.35) / 0.37);
          actionBodyPitchExtra = THREE.MathUtils.lerp(actDef.windup.badanX, actDef.strike.badanX, w);
          holdBahuKananX = THREE.MathUtils.lerp(actDef.windup.bahu_kanan.x, actDef.strike.bahu_kanan.x, w);
          holdBahuKananY = THREE.MathUtils.lerp(actDef.windup.bahu_kanan.y, actDef.strike.bahu_kanan.y, w);
          holdBahuKananZ = THREE.MathUtils.lerp(actDef.windup.bahu_kanan.z, actDef.strike.bahu_kanan.z, w);
          holdSikuKananX = THREE.MathUtils.lerp(actDef.windup.siku_kanan.x, actDef.strike.siku_kanan.x, w);
          holdSikuKananZ = THREE.MathUtils.lerp(actDef.windup.siku_kanan.z, actDef.strike.siku_kanan.z, w);
          holdTanganKananX = THREE.MathUtils.lerp(actDef.windup.tangan_kanan.x, actDef.strike.tangan_kanan.x, w);
        } else {
          const w = smoothstep01((p - 0.72) / 0.28);
          actionBodyPitchExtra = THREE.MathUtils.lerp(actDef.strike.badanX, 0, w);
          holdBahuKananX = THREE.MathUtils.lerp(actDef.strike.bahu_kanan.x, holdBahuKananX, w);
          holdBahuKananY = THREE.MathUtils.lerp(actDef.strike.bahu_kanan.y, holdBahuKananY, w);
          holdBahuKananZ = THREE.MathUtils.lerp(actDef.strike.bahu_kanan.z, holdBahuKananZ, w);
          holdSikuKananX = THREE.MathUtils.lerp(actDef.strike.siku_kanan.x, holdSikuKananX, w);
          holdSikuKananZ = THREE.MathUtils.lerp(actDef.strike.siku_kanan.z, holdSikuKananZ, w);
          holdTanganKananX = THREE.MathUtils.lerp(actDef.strike.tangan_kanan.x, holdTanganKananX, w);
        }
      } else if (actDef.peak) {
        // Kurva lonceng halus (0 -> 1 -> 0) untuk isi_ember, letakkan_telur, tanam_bibit, angkat_panen
        const w = Math.sin(p * Math.PI);
        actionBodyPitchExtra = (actDef.peak.badanX || 0) * w;
        if (actDef.peak.bahu_kanan) {
          holdBahuKananX = THREE.MathUtils.lerp(holdBahuKananX, actDef.peak.bahu_kanan.x, w);
          holdBahuKananY = THREE.MathUtils.lerp(holdBahuKananY, actDef.peak.bahu_kanan.y, w);
          holdBahuKananZ = THREE.MathUtils.lerp(holdBahuKananZ, actDef.peak.bahu_kanan.z, w);
        }
        if (actDef.peak.siku_kanan) {
          holdSikuKananX = THREE.MathUtils.lerp(holdSikuKananX, actDef.peak.siku_kanan.x, w);
          holdSikuKananY = THREE.MathUtils.lerp(holdSikuKananY, actDef.peak.siku_kanan.y, w);
          holdSikuKananZ = THREE.MathUtils.lerp(holdSikuKananZ, actDef.peak.siku_kanan.z, w);
        }
        if (actDef.peak.tangan_kanan) {
          holdTanganKananX = THREE.MathUtils.lerp(holdTanganKananX, actDef.peak.tangan_kanan.x, w);
          holdTanganKananY = THREE.MathUtils.lerp(holdTanganKananY, actDef.peak.tangan_kanan.y, w);
          holdTanganKananZ = THREE.MathUtils.lerp(holdTanganKananZ, actDef.peak.tangan_kanan.z, w);
        }
        // Jika item dipegang dua tangan, gerakkan juga tangan kiri mengikuti aksi
        if (!catPose.freeLeftArm) {
          if (actDef.peak.bahu_kiri) {
            holdBahuKiriX = THREE.MathUtils.lerp(holdBahuKiriX, actDef.peak.bahu_kiri.x, w);
            holdBahuKiriY = THREE.MathUtils.lerp(holdBahuKiriY, actDef.peak.bahu_kiri.y, w);
            holdBahuKiriZ = THREE.MathUtils.lerp(holdBahuKiriZ, actDef.peak.bahu_kiri.z, w);
          }
          if (actDef.peak.siku_kiri) {
            holdSikuKiriX = THREE.MathUtils.lerp(holdSikuKiriX, actDef.peak.siku_kiri.x, w);
            holdSikuKiriY = THREE.MathUtils.lerp(holdSikuKiriY, actDef.peak.siku_kiri.y, w);
            holdSikuKiriZ = THREE.MathUtils.lerp(holdSikuKiriZ, actDef.peak.siku_kiri.z, w);
          }
          if (actDef.peak.tangan_kiri) {
            holdTanganKiriX = THREE.MathUtils.lerp(holdTanganKiriX, actDef.peak.tangan_kiri.x, w);
            holdTanganKiriY = THREE.MathUtils.lerp(holdTanganKiriY, actDef.peak.tangan_kiri.y, w);
            holdTanganKiriZ = THREE.MathUtils.lerp(holdTanganKiriZ, actDef.peak.tangan_kiri.z, w);
          }
        }
      }
    }
    if (holdState.actionTimer <= 0) {
      holdState.actionName = null;
    }
  }

  // 7. TERAPKAN SLERP QUATERNION KE SETIAP SENDI
  // Pinggul & Badan
  slerpNodeBlendedIdleLoco('pinggul', 0, 0, idleHipZ, 0, locoHipY, 0, moveW, jointAlpha);
  slerpNodeBlendedIdleLoco(
    'badan',
    idleBodyX + actionBodyPitchExtra * holdW, 0, -idleHipZ * 0.6,
    bodyLeanX + actionBodyPitchExtra * holdW, locoBodyY, 0,
    moveW,
    jointAlpha
  );

  // Leher, Kepala, & Topi (kepala tetap stabil menghadap depan saat jalan/lari, dan menoleh halus saat diam)
  const headIdleYaw = petaniRig.lookCurrentDeg * (1 - moveW);
  const headLocoYawComp = -(locoHipY + locoBodyY) * 0.85;
  const headLocoPitchComp = -bodyLeanX * 0.65;
  slerpNodeBlendedIdleLoco('leher', 0, headIdleYaw * 0.35, 0, headLocoPitchComp * 0.4, headLocoYawComp * 0.4, 0, moveW, jointAlpha);
  slerpNodeBlendedIdleLoco(
    'kepala',
    petaniRig.secHeadPitch, headIdleYaw * 0.65, petaniRig.secHeadRoll,
    headLocoPitchComp * 0.6 + petaniRig.secHeadPitch, headLocoYawComp * 0.6, petaniRig.secHeadRoll,
    moveW,
    jointAlpha
  );
  slerpNodeToDeltaDeg('topi', petaniRig.secHatPitch, 0, petaniRig.secHatRoll, jointAlpha);

  // Bahu, Siku, Lengan Bawah, & Tangan (blend mulus antara Idle bersedekap lama <-> Pose Pegang Item)
  slerpNodeWithHold(
    'bahu_kiri',
    idleBahuKiriX, idleBahuKiriY, idleBahuKiriZ,
    locoBahuKiriX, 0, locoBahuKiriZ,
    holdBahuKiriX, holdBahuKiriY, holdBahuKiriZ,
    moveW, holdW, jointAlpha
  );
  slerpNodeWithHold(
    'bahu_kanan',
    idleBahuKananX, idleBahuKananY, idleBahuKananZ,
    locoBahuKananX, 0, locoBahuKananZ,
    holdBahuKananX, holdBahuKananY, holdBahuKananZ,
    moveW, holdW, jointAlpha
  );

  // Pada bahu_kiri/kanan terdapat node lengan_atas_kiri/kanan yang ikut sedikit bernapas saat idle
  const shoulderBreathRaise = Math.max(0, breathSin) * 0.6 * (1 - moveW);
  slerpNodeToDeltaDeg('lengan_atas_kiri', 0, 0, shoulderBreathRaise, jointAlpha);
  slerpNodeToDeltaDeg('lengan_atas_kanan', 0, 0, -shoulderBreathRaise, jointAlpha);

  slerpNodeWithHold(
    'siku_kiri',
    idleSikuKiriX, idleSikuKiriY, idleSikuKiriZ,
    locoSikuKiriX, 0, elbowZ,
    holdSikuKiriX, holdSikuKiriY, holdSikuKiriZ,
    moveW, holdW, jointAlpha
  );
  slerpNodeWithHold(
    'siku_kanan',
    idleSikuKananX, idleSikuKananY, idleSikuKananZ,
    locoSikuKananX, 0, elbowZ,
    holdSikuKananX, holdSikuKananY, holdSikuKananZ,
    moveW, holdW, jointAlpha
  );

  slerpNodeToDeltaDeg('lengan_bawah_kiri', petaniRig.secForearmL * (1 - holdW * 0.5), 0, 0, jointAlpha);
  slerpNodeToDeltaDeg('lengan_bawah_kanan', petaniRig.secForearmR * (1 - holdW * 0.5), 0, 0, jointAlpha);
  slerpNodeWithHold(
    'tangan_kiri',
    petaniRig.secHandL, 0, 0,
    petaniRig.secHandL, 0, 0,
    holdTanganKiriX, holdTanganKiriY, holdTanganKiriZ,
    moveW, holdW, jointAlpha
  );
  slerpNodeWithHold(
    'tangan_kanan',
    petaniRig.secHandR, 0, 0,
    petaniRig.secHandR, 0, 0,
    holdTanganKananX, holdTanganKananY, holdTanganKananZ,
    moveW, holdW, jointAlpha
  );

  // Paha, Lutut, & Sepatu
  const idleHipCounterZ = shiftVal * IDLE_SHIFT_HIP_Z_DEG;
  slerpNodeBlendedIdleLoco('paha_kiri', idleThighLeftX, 0, -idleHipCounterZ, locoPahaKiriX, 0, 0, moveW, jointAlpha);
  // paha_kanan memiliki scale.x = -1, sehingga tanda Z dibalik terhadap sisi kiri
  slerpNodeBlendedIdleLoco('paha_kanan', idleThighRightX, 0, -idleHipCounterZ, locoPahaKananX, 0, 0, moveW, jointAlpha);

  slerpNodeBlendedIdleLoco('lutut_kiri', idleKneeLeftX, 0, 0, locoLututKiriX, 0, 0, moveW, jointAlpha);
  slerpNodeBlendedIdleLoco('lutut_kanan', idleKneeRightX, 0, 0, locoLututKananX, 0, 0, moveW, jointAlpha);

  // Kompensasi ringan pergelangan sepatu agar telapak tetap rata dengan tanah
  const shoePitchL = (-locoPahaKiriX - locoLututKiriX * 0.65) * 0.25 * moveW;
  const shoePitchR = (-locoPahaKananX - locoLututKananX * 0.65) * 0.25 * moveW;
  slerpNodeToDeltaDeg('sepatu_kiri', shoePitchL, 0, 0, jointAlpha);
  slerpNodeToDeltaDeg('sepatu_kanan', shoePitchR, 0, 0, jointAlpha);

  // 7. GROUND CONTACT (KAKI MENYENTUH TANAH TEPAT DI Y = 0 RELATIF TERHADAP PLAYER)
  const hipNode = petaniRig.nodes.pinggul;
  const hipRestPos = petaniRig.restPos.pinggul;
  const shoeL = petaniRig.nodes.sepatu_kiri;
  const shoeR = petaniRig.nodes.sepatu_kanan;

  if (hipNode && hipRestPos && shoeL && shoeR) {
    // Geseran X pinggul saat pindah tumpuan + ayunan naik-turun napas saat diam
    hipNode.position.x = hipRestPos.x + shiftVal * IDLE_SHIFT_HIP_X;
    hipNode.position.z = hipRestPos.z;
    hipNode.position.y = hipRestPos.y;

    // Pastikan matriks dunia playerGroup & seluruh sendi diperbarui sebelum menghitung posisi sol sepatu
    playerGroup.updateMatrixWorld(true);

    // Cek titik tumit, tengah, dan ujung jari pada dasar sol kedua sepatu agar telapak sepatu menapak rata di atas kayu/tangga
    const minLocalYL = petaniRig.shoeLeftBottomLocal.y;
    const minLocalYR = petaniRig.shoeRightBottomLocal.y;
    let minShoeWorldY = Infinity;
    const soleZOffsets = [-0.065, 0.0, 0.155];
    for (let i = 0; i < soleZOffsets.length; i++) {
      const sz = soleZOffsets[i];
      _shoeWorldL.set(0, minLocalYL, sz).applyMatrix4(shoeL.matrixWorld);
      _shoeWorldR.set(0, minLocalYR, sz).applyMatrix4(shoeR.matrixWorld);
      if (_shoeWorldL.y < minShoeWorldY) minShoeWorldY = _shoeWorldL.y;
      if (_shoeWorldR.y < minShoeWorldY) minShoeWorldY = _shoeWorldR.y;
    }

    const groundBaseY = playerGroup.position.y;
    const yCorrection = (groundBaseY - minShoeWorldY) / PLAYER_SCALE;
    const breathOffsetY = Math.max(0, breathSin) * IDLE_BREATH_HIP_Y * (1 - moveW);

    hipNode.position.y = hipRestPos.y + yCorrection + breathOffsetY;
    playerGroup.updateMatrixWorld(true);
  }
}

