// Konversi state.gameTime (total menit in-game kumulatif) -> jam 24 jam (00:00 - 23:59) + nomor hari
function getClockInfo() {
  const totalMinutes = Math.max(0, Math.floor(state.gameTime));
  const dayNum = Math.floor(totalMinutes / 1440) + 1;
  const minuteOfDay = totalMinutes % 1440;
  const hh = Math.floor(minuteOfDay / 60);
  const mm = minuteOfDay % 60;
  const hourFloat = ((Math.max(0, state.gameTime) % 1440) / 60);
  return { dayNum, minuteOfDay, hh, mm, hourFloat };
}

function getTimePhaseInfo(hourFloat) {
  if (hourFloat >= 6 && hourFloat < 11) return { phase: 'pagi',  label: 'PAGI',  icon: '☀️' };
  if (hourFloat >= 11 && hourFloat < 15) return { phase: 'siang', label: 'SIANG', icon: '☀️' };
  if (hourFloat >= 15 && hourFloat < 18) return { phase: 'sore',  label: 'SORE',  icon: '🌅' };
  return { phase: 'malam', label: 'MALAM', icon: '🌙' };
}

function updateTimeUI() {
  const c = getClockInfo();
  state.gameDay = c.dayNum;
  const clockStr = `${String(c.hh).padStart(2, '0')}:${String(c.mm).padStart(2, '0')}`;
  if (clockStr !== lastTimeUiText && timeClockLabelEl) {
    lastTimeUiText = clockStr;
    timeClockLabelEl.textContent = clockStr;
  }

  const dayStr = `Hari ke-${c.dayNum}`;
  if (dayStr !== lastDayText && timeDayLabelEl) {
    lastDayText = dayStr;
    timeDayLabelEl.textContent = dayStr;
  }

  const info = getTimePhaseInfo(c.hourFloat);
  if (info.label !== lastPhaseText && timePhaseLabelEl) {
    lastPhaseText = info.label;
    timePhaseLabelEl.textContent = info.label;
    if (timeIconCircleEl) timeIconCircleEl.textContent = info.icon;
  }
  const phaseClass = 'phase-' + info.phase;
  if (phaseClass !== lastPhaseClass && timeHudEl) {
    if (lastPhaseClass) timeHudEl.classList.remove(lastPhaseClass);
    timeHudEl.classList.remove('phase-pagi', 'phase-siang', 'phase-sore', 'phase-malam');
    timeHudEl.classList.add(phaseClass);
    lastPhaseClass = phaseClass;
  }
}

function updateDayNightCycle(dt, forceInstant = false) {
  if (!state.inLobby && !state.isSleeping && dt > 0) {
    // 1 menit in-game = 0.5 detik nyata (timeSpeedMultiplier = 2 menit in-game per 1 detik nyata)
    state.gameTime += dt * (CONFIG.timeSpeedMultiplier || 2.0);
  }

  // Selama di Main Menu (state.inLobby === true), gunakan pencahayaan pagi/siang yang cerah dan hangat (jam 10:30)
  const hourFloat = state.inLobby ? 10.5 : getClockInfo().hourFloat;
  // Posisi siklus untuk benda langit: 0 = 06:00 (matahari terbit)
  const cyclePos = (((hourFloat - 6) / 24) % 1 + 1) % 1;

  let targetDirInt = 1.8;
  let targetHemiInt = 0.62;
  let targetAmbInt = 0.22;
  let nightLampFactor = 0.0;

  if (hourFloat >= 6 && hourFloat < 11) {
    // PAGI (06:00 - 10:59): transisi singkat dari fajar menuju pagi cerah
    const t = smoothstep01(Math.min(1, (hourFloat - 6) / 1.0));
    targetSkyColor.copy(SKY_DUSK_START_COLOR).lerp(SKY_DAY_COLOR, t);
    targetFogColor.copy(targetSkyColor);
    targetDirLightColor.setHex(0xFFF4D6);
    targetHemiSkyColor.setHex(0x87CEEB);
    targetHemiGroundColor.setHex(0x556B2F);
    targetAmbientColor.setHex(0xFFF3E0);
    targetDirInt = THREE.MathUtils.lerp(0.9, 1.65, t);
    targetHemiInt = THREE.MathUtils.lerp(0.45, 0.6, t);
    targetAmbInt = 0.22;
    nightLampFactor = 1.0 - t;
  } else if (hourFloat >= 11 && hourFloat < 15) {
    // SIANG (11:00 - 14:59): matahari terang
    targetSkyColor.copy(SKY_DAY_COLOR);
    targetFogColor.copy(SKY_DAY_COLOR);
    targetDirLightColor.setHex(0xFFFDF0);
    targetHemiSkyColor.setHex(0x87CEEB);
    targetHemiGroundColor.setHex(0x556B2F);
    targetAmbientColor.setHex(0xFFFFFF);
    targetDirInt = 1.85;
    targetHemiInt = 0.62;
    targetAmbInt = 0.22;
    nightLampFactor = 0.0;
  } else if (hourFloat >= 15 && hourFloat < 18) {
    // SORE (15:00 - 17:59): cahaya senja jingga -> ungu senja
    const t = (hourFloat - 15) / 3;
    if (t < 0.5) {
      const k = smoothstep01(t * 2);
      targetSkyColor.copy(SKY_DAY_COLOR).lerp(SKY_DUSK_START_COLOR, k);
      targetDirLightColor.setHex(0xFFFDF0).lerp(LIGHT_DUSK_COLOR, k);
    } else {
      const k = smoothstep01((t - 0.5) * 2);
      targetSkyColor.copy(SKY_DUSK_START_COLOR).lerp(SKY_DUSK_END_COLOR, k);
      targetDirLightColor.copy(LIGHT_DUSK_COLOR);
    }
    targetFogColor.copy(targetSkyColor);
    targetHemiSkyColor.copy(targetSkyColor);
    targetHemiGroundColor.setHex(0x3E3524);
    targetAmbientColor.setHex(0xFFD0B0);
    targetDirInt = THREE.MathUtils.lerp(1.7, 0.6, t);
    targetHemiInt = THREE.MathUtils.lerp(0.6, 0.38, t);
    targetAmbInt = THREE.MathUtils.lerp(0.22, 0.26, t);
    nightLampFactor = smoothstep01(t) * 0.5;
  } else {
    // MALAM (18:00 - 05:59): langit gelap, cahaya bulan lembut & lampu luar menyala
    const sinceDusk = hourFloat >= 18 ? hourFloat - 18 : hourFloat + 6;
    const k = smoothstep01(Math.min(1, sinceDusk / 0.75));
    targetSkyColor.copy(SKY_DUSK_END_COLOR).lerp(SKY_NIGHT_COLOR, k);
    targetFogColor.copy(targetSkyColor);
    targetDirLightColor.copy(LIGHT_NIGHT_COLOR);
    targetHemiSkyColor.setHex(0x28385E);
    targetHemiGroundColor.setHex(0x1B2432);
    targetAmbientColor.setHex(0x90A8D8);
    targetDirInt = THREE.MathUtils.lerp(0.6, 0.42, k);
    targetHemiInt = 0.34;
    targetAmbInt = 0.28;
    nightLampFactor = 1.0;
  }

  const lerpAlpha = forceInstant ? 1.0 : Math.min(1.0, dt * 3.5);
  currentSkyColor.lerp(targetSkyColor, lerpAlpha);
  currentFogColor.lerp(targetFogColor, lerpAlpha);
  dirLight.color.lerp(targetDirLightColor, lerpAlpha);
  dirLight.intensity = THREE.MathUtils.lerp(dirLight.intensity, targetDirInt, lerpAlpha);
  hemiLight.color.lerp(targetHemiSkyColor, lerpAlpha);
  hemiLight.groundColor.lerp(targetHemiGroundColor, lerpAlpha);
  hemiLight.intensity = THREE.MathUtils.lerp(hemiLight.intensity, targetHemiInt, lerpAlpha);
  ambientLight.color.lerp(targetAmbientColor, lerpAlpha);
  ambientLight.intensity = THREE.MathUtils.lerp(ambientLight.intensity, targetAmbInt, lerpAlpha);

  // Perbarui warna & posisi benda langit (Matahari saat siang/sore, Bulan lembut saat malam)
  const sunAngle = cyclePos * Math.PI * 2;
  sunMesh.position.set(Math.cos(sunAngle) * 45, Math.max(8, Math.sin(sunAngle) * 50 + 18), -40);
  if (hourFloat >= 18 || hourFloat < 6) {
    sunMesh.material.color.setHex(0xD6E4FF);
  } else if (hourFloat >= 15 && hourFloat < 18) {
    sunMesh.material.color.setHex(0xFF9E64);
  } else {
    sunMesh.material.color.setHex(0xFFF9C4);
  }

  // Nyalakan / redupkan PointLight malam di sekitar rumah, kandang & toko
  for (const pl of outdoorNightLights) {
    const targetLampInt = (pl.userData.maxNightIntensity || 2.0) * nightLampFactor;
    pl.intensity = THREE.MathUtils.lerp(pl.intensity, targetLampInt, lerpAlpha);
  }

  // Terapkan warna langit & kabut jika player sedang berada di dunia luar
  if (!state.isInsideHouse) {
    scene.background = currentSkyColor;
    if (!scene.fog) {
      scene.fog = new THREE.FogExp2(currentFogColor.getHex(), 0.011);
    } else {
      scene.fog.color.copy(currentFogColor);
    }
  }

  updateTimeUI();
}

