// 2. Fungsi Pengecekan Zona Terlarang Khusus Pohon ("pohon.glb") dengan Radius Aman >= 7.5 - 8.5 Unit
//    (mengingat lebar kanopi pohon sekitar 7 unit, tidak boleh ada pohon di dalam / dekat area aktivitas utama)
function distToSegment2D(px, pz, x1, z1, x2, z2) {
  const vx = x2 - x1;
  const vz = z2 - z1;
  const lenSq = vx * vx + vz * vz;
  if (lenSq < 1e-6) return Math.hypot(px - x1, pz - z1);
  const t = Math.max(0, Math.min(1, ((px - x1) * vx + (pz - z1) * vz) / lenSq));
  return Math.hypot(px - (x1 + t * vx), pz - (z1 + t * vz));
}

function isTreeSpawnAllowed(x, z) {
  // Batas luar map agar kanopi tidak keluar dari tanah dasar
  if (Math.abs(x) > 37.5 || Math.abs(z) > 37.5) return false;

  // Zona tengah aktivitas utama (mencakup Rumah, Kandang Ayam, Kandang Sapi, 10 Plot, Sumur, 4 Toko, & Jalan Setapak + margin 8 unit)
  if (x >= -24.5 && x <= 23.5 && z >= -18.5 && z <= 28.5) return false;

  // a. Area Rumah Petani (termasuk teras, tangga depan, halaman belakang & samping rumah) - radius aman >= 9.5 unit
  if (Math.hypot(x - CONFIG.housePos.x, z - CONFIG.housePos.z) < 9.5) return false;
  if (x >= -9.5 && x <= 9.5 && z >= -16.5 && z <= 3.5) return false;

  // b. Area Kandang Ayam dan halaman depannya - radius aman >= 9.5 unit
  if (Math.hypot(x - CONFIG.chickenPenPos.x, z - CONFIG.chickenPenPos.z) < 9.5) return false;
  if (x >= -23.5 && x <= -1.0 && z >= -12.5 && z <= 8.5) return false;

  // c. Area Kandang Sapi dan halaman depannya - radius aman >= 9.5 unit
  if (Math.hypot(x - CONFIG.cowPenPos.x, z - CONFIG.cowPenPos.z) < 9.5) return false;
  if (x >= -24.0 && x <= -1.0 && z >= -3.0 && z <= 18.0) return false;

  // d. Area seluruh 10 Plot Tanaman di samping kanan rumah (x: 4.5..12.1, z: -1.55..1.0) - radius aman >= 8.0 unit
  if (x >= -3.5 && x <= 20.5 && z >= -9.8 && z <= 9.2) return false;

  // e. Area Sumur (7, 5) dan sekitarnya - radius aman >= 8.5 unit
  if (Math.hypot(x - CONFIG.wellPos.x, z - CONFIG.wellPos.z) < 8.5) return false;

  // f. Area keempat Toko (Toko Bibit, Toko Jual Tanaman, Toko Hewan, Toko Jual Hasil Ternak) beserta halaman depan & belakangnya
  const shopKeys = ['bibit', 'jualTan', 'hewan', 'jualTer'];
  for (let i = 0; i < shopKeys.length; i++) {
    const sp = CONFIG.shopPos[shopKeys[i]];
    if (Math.hypot(x - sp.x, z - sp.z) < 9.0) return false;
    if (Math.hypot(x - sp.x, z - 15.0) < 8.5) return false;
  }
  if (x >= -22.5 && x <= 22.5 && z >= 7.0 && z <= 28.0) return false;

  // g. Seluruh jalur Jalan Setapak (jarak aman minimal 8.0 unit dari garis tengah setiap jalur)
  if (distToSegment2D(x, z, 0.0, -2.9, 0.0, 16.0) < 8.0) return false;
  if (distToSegment2D(x, z, -7.6, -2.0, 1.04, -2.0) < 8.0) return false;
  if (distToSegment2D(x, z, -10.3, 7.2, -1.04, 7.2) < 8.0) return false;
  if (distToSegment2D(x, z, -15.0, 15.0, 15.0, 15.0) < 8.0) return false;

  return true;
}

