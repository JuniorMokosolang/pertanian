      updateTouchHUDVisibility();
    }
    if (state.panelOpen || teleportState.active || state.isSleeping) return;
    if (mobileInput.joyTouchId !== null) return;
    const t = e.changedTouches[0];
    if (!t) return;
    mobileInput.joyTouchId = t.identifier;
    const rect = joyBaseEl.getBoundingClientRect();
    mobileInput.joyCenterX = rect.left + rect.width / 2;
    mobileInput.joyCenterY = rect.top + rect.height / 2;
    mobileInput.joyMaxRadius = Math.max(26, rect.width * 0.42);
    mobileAutoTarget = null;
    updateMobileJoystickFromPoint(t.clientX, t.clientY);
  }, { passive: false });

  joyZoneEl.addEventListener('touchmove', e => {
    e.preventDefault();
    e.stopPropagation();
    if (mobileInput.joyTouchId === null) return;
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      if (t.identifier === mobileInput.joyTouchId) {
        updateMobileJoystickFromPoint(t.clientX, t.clientY);
        break;
      }
    }
  }, { passive: false });

  const onJoyTouchEnd = e => {
    if (mobileInput.joyTouchId === null) return;
    for (let i = 0; i < e.changedTouches.length; i++) {
      const t = e.changedTouches[i];
      if (t.identifier === mobileInput.joyTouchId) {
        e.preventDefault();
        e.stopPropagation();
        lastTouchEndTime = Date.now();
        resetMobileJoystick();
        break;
