function buildFence(cx, cz, fw, fd, fh) {
  const g = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({ color: 0x8B4513 });
  const pGeo = new THREE.BoxGeometry(0.12, fh, 0.12);
  const hw = fw / 2, hd = fd / 2;

  function side(sx, sz, ex, ez) {
    const dx = ex - sx, dz = ez - sz;
    const len = Math.sqrt(dx * dx + dz * dz);
    if (len < 0.01) return;
    const n = Math.max(2, Math.ceil(len / 1.5));
    const ang = Math.atan2(dx, dz);
    for (let i = 0; i <= n; i++) {
      const t = i / n;
      const post = new THREE.Mesh(pGeo, mat);
      post.position.set(sx + dx * t, fh / 2, sz + dz * t);
      post.castShadow = true; g.add(post);
    }
    for (const ry of [fh * 0.33, fh * 0.66]) {
      const rail = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, len), mat);
      rail.position.set((sx + ex) / 2, ry, (sz + ez) / 2);
      rail.rotation.y = ang; rail.castShadow = true; g.add(rail);
    }
  }

  side(cx - hw, cz - hd, cx + hw, cz - hd);
  side(cx + hw, cz - hd, cx + hw, cz + hd);
  side(cx + hw, cz + hd, cx - hw, cz + hd);
  side(cx - hw, cz + hd, cx - hw, cz - hd);
  scene.add(g);
  return g;
}

function buildPen(cfg, label) {
