function parseHarvestItem(name) {
  for (const [key, crop] of Object.entries(CONFIG.crops)) {
    if (name.startsWith(crop.name)) {
      if (name.includes('Rainbow')) return { key, crop, type: 'rainbow', price: crop.sell.rainbow };
      if (name.includes('Petir')) return { key, crop, type: 'petir', price: crop.sell.petir };
      if (name.includes('Batu')) return { key, crop, type: 'batu', price: crop.sell.batu };
      return { key, crop, type: 'biasa', price: crop.sell.biasa };
    }
  }
  return null;
}

