    }

    if (nDef.mesh !== undefined && gltf.meshes && gltf.meshes[nDef.mesh]) {
      const mDef = gltf.meshes[nDef.mesh];
      const prims = mDef.primitives || [];

      prims.forEach((prim, pIdx) => {
        const mat = (prim.material !== undefined && materials[prim.material])
          ? materials[prim.material]
          : defaultMat;

        // Pemisahan khusus node "Ruangan" pada interior rumah petani:
        // Primitive 0 = Lantai, Primitive 1 = 3 Dinding Luar (108 indeks = 3x36), Primitive 2 = BalokPlafon
        if (splitInteriorWalls && (mDef.name === 'Ruangan' || nDef.name === 'Ruangan')) {
          if (pIdx === 0) {
            const floorGeo = createPrimGeometry(prim);
            const floorMesh = new THREE.Mesh(floorGeo, mat);
            floorMesh.name = 'LantaiRuangan';
            floorMesh.receiveShadow = true;
            floorMesh.castShadow = false;
            obj.add(floorMesh);
            return;
          }
          if (pIdx === 1 && prim.indices !== undefined) {
            const allIdx = getAccessorArray(prim.indices);
            if (allIdx && allIdx.length >= 108) {
              const wallSlices = [
                { name: 'DindingBelakang', start: 0, end: 36 },
                { name: 'DindingKiri',     start: 36, end: 72 },
                { name: 'DindingKanan',    start: 72, end: 108 }
              ];
              for (const wPart of wallSlices) {
                const subIdx = allIdx.slice(wPart.start, wPart.end);
                const wGeo = createPrimGeometry(prim, subIdx);
                const wMesh = new THREE.Mesh(wGeo, mat);
                wMesh.name = wPart.name;
                wMesh.castShadow = false;
                wMesh.receiveShadow = true;
                obj.add(wMesh);
              }
              return;
            }
          }
          if (pIdx === 2) {
            const beamGeo = createPrimGeometry(prim);
            const beamMesh = new THREE.Mesh(beamGeo, mat);
            beamMesh.name = 'BalokPlafon';
            beamMesh.castShadow = false;
            beamMesh.receiveShadow = true;
            obj.add(beamMesh);
            return;
          }
        }

        const geo = createPrimGeometry(prim);
        const mesh = new THREE.Mesh(geo, mat);
        mesh.name = prims.length === 1 ? (nDef.name || mDef.name || `mesh_${pIdx}`) : `${nDef.name || mDef.name || 'mesh'}_${pIdx}`;
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        obj.add(mesh);
      });
    }

    if (nDef.children && nDef.children.length > 0) {
      for (const cIdx of nDef.children) {
        obj.add(buildNode(cIdx));
      }
    }
    return obj;
  }

  const rootGroup = new THREE.Group();
  rootGroup.name = 'GLBDirectScene';
  const sceneIdx = gltf.scene !== undefined ? gltf.scene : 0;
  const sceneDef = (gltf.scenes && gltf.scenes[sceneIdx]) ? gltf.scenes[sceneIdx] : { nodes: [0] };
  for (const nIdx of (sceneDef.nodes || [])) {
    rootGroup.add(buildNode(nIdx));
  }

  return { scene: rootGroup, scenes: [rootGroup] };
}

function loadGLBWithFallback(b64Data, urlPath, onSuccess, onError) {
  const isInteriorGLB = Boolean(urlPath && urlPath.includes('interior-rumah-petani'));
  if (b64Data && !b64Data.startsWith('__')) {
    try {
      const buf = decodeBase64ToArrayBuffer(b64Data);
      // Gunakan parser biner sinkron langsung untuk INTERIOR_GLB_B64 agar tekstur tertanam tidak gagal di file:// / WebView
      if (isInteriorGLB) {
        const parsedInterior = parseGLBBufferDirect(buf, true);
        onSuccess(parsedInterior);
        return;
      }
      const loader = new GLTFLoader();
      loader.parse(buf, '', gltf => onSuccess(gltf), err => {
        console.warn(`GLTFLoader.parse gagal (${urlPath}), menggunakan parseGLBBufferDirect fallback:`, err);
        try {
          onSuccess(parseGLBBufferDirect(buf, false));
        } catch (directErr) {
          loader.load(urlPath, onSuccess, undefined, onError);
        }
      });
      return;
    } catch (e) {
      console.warn(`Fallback ke loader.load(${urlPath}):`, e);
    }
  }
  const loader = new GLTFLoader();
  loader.load(urlPath, onSuccess, undefined, onError);
}

function buildHouseAndInterior() {
  // 1. PASANG RUMAH LUAR (rumah.glb)
  const extGroup = houseRefs.exteriorGroup;
  extGroup.name = 'RumahPetaniLuar';
  extGroup.position.set(HOUSE_EXTERIOR_POS.x, HOUSE_EXTERIOR_POS.y, HOUSE_EXTERIOR_POS.z);
  scene.add(extGroup);

  // Collider kotak rumah luar: memblokir dinding utama & dekorasi di atas teras (peti kayu kiri, kaleng susu & jerami kanan),
  // namun membiarkan jalur anak tangga depan dan lantai kayu teras di depan pintu luar tetap leluasa dilalui.
  const S = HOUSE_EXTERIOR_SCALE;
  const hx = HOUSE_EXTERIOR_POS.x;
  const hz = HOUSE_EXTERIOR_POS.z;
  outdoorBoxColliders.push(
    // 1. Badan utama dinding rumah luar
    { minX: hx - 2.55 * S, maxX: hx + 2.55 * S, minZ: hz - 2.53 * S, maxZ: hz + 1.46 * S },
    // 2. Peti kayu dekorasi di samping kiri pintu di atas teras (node 'peti')
    { minX: hx - 2.04 * S, maxX: hx - 1.26 * S, minZ: hz + 1.46 * S, maxZ: hz + 2.22 * S },
    // 3. Pagar & tiang tepi kiri teras
    { minX: hx - 2.22 * S, maxX: hx - 1.96 * S, minZ: hz + 1.45 * S, maxZ: hz + 2.86 * S },
    // 4. Tepi depan-kiri teras di sebelah kiri anak tangga
    { minX: hx - 2.22 * S, maxX: hx - 0.84 * S, minZ: hz + 2.74 * S, maxZ: hz + 2.88 * S },
    // 5. Kaleng susu dekorasi di samping kanan pintu di atas teras (node 'kaleng_susu')
    { minX: hx + 0.20 * S, maxX: hx + 0.88 * S, minZ: hz + 1.46 * S, maxZ: hz + 2.34 * S },
    // 6. Tiang sudut kanan-depan teras (di sebelah kanan anak tangga, membiarkan seluruh lebar tangga terbuka)
    { minX: hx + 0.54 * S, maxX: hx + 0.90 * S, minZ: hz + 2.34 * S, maxZ: hz + 2.88 * S },
    // 7. Tumpukan jerami di samping kanan luar teras (node 'jerami')
    { minX: hx + 0.88 * S, maxX: hx + 2.05 * S, minZ: hz + 1.46 * S, maxZ: hz + 2.48 * S }
  );

  // Zona klik tak terlihat (hitbox) di pintu luar agar mudah diklik dari depan teras
  const extDoorHitbox = new THREE.Mesh(
    new THREE.BoxGeometry(1.35 * S, 2.5 * S, 0.9 * S),
    new THREE.MeshBasicMaterial({ visible: false })
  );
  extDoorHitbox.position.set(hx - 0.65 * S, 1.35 * S, hz + 1.85 * S);
  scene.add(extDoorHitbox);
  const extDoorInteractable = {
    mesh: extDoorHitbox,
    type: 'houseDoorOut',
    position: new THREE.Vector3(ZONA_PINTU_LUAR.x, ZONA_PINTU_LUAR.y, ZONA_PINTU_LUAR.z),
    group: null
  };
  interactables.push(extDoorInteractable);

  loadGLBWithFallback(
    RUMAH_GLB_B64,
    './rumah.glb',
    gltf => {
      const root = gltf.scene;
      root.scale.setScalar(HOUSE_EXTERIOR_SCALE);
      root.traverse(obj => {
        if (obj.isMesh) {
          obj.castShadow = true;
          obj.receiveShadow = true;
          if (obj.material) {
            obj.material.roughness = Math.max(0.55, obj.material.roughness ?? 0.8);
          }
        }
        if (obj.name === 'pintu') {
          houseRefs.exteriorDoorNode = obj;
          extDoorInteractable.group = obj;
        } else if (obj.name === 'teras') {
          houseRefs.porchNode = obj;
        } else if (obj.name === 'tangga') {
          houseRefs.stairsNode = obj;
        }
      });
      extGroup.add(root);
      extGroup.updateMatrixWorld(true);

      // Ekstrak mesh lantai kayu teras ('teras') & anak tangga kecil ('tangga') beserta THREE.Box3 akuratnya
      houseRefs.walkableSurfaceMeshes.length = 0;
      const dynamicStepBoxes = [];

      if (houseRefs.stairsNode) {
        const stairMeshes = [];
        houseRefs.stairsNode.traverse(m => { if (m.isMesh) stairMeshes.push(m); });
        for (const m of stairMeshes) {
          houseRefs.walkableSurfaceMeshes.push(m);
          const b = new THREE.Box3().setFromObject(m);
          const heightSpan = b.max.y - b.min.y;
          // Ambil primitive papan anak tangga horizontal (bukan rangka miring bawah yang min.y ~ 0)
          if (b.min.y > HOUSE_EXTERIOR_POS.y + 0.08 * HOUSE_EXTERIOR_SCALE && heightSpan < 0.18 * HOUSE_EXTERIOR_SCALE) {
            dynamicStepBoxes.push({
              id: b.max.y > HOUSE_EXTERIOR_POS.y + 0.30 * HOUSE_EXTERIOR_SCALE ? 'tangga_2' : 'tangga_1',
              minX: b.min.x,
              maxX: b.max.x,
              minZ: b.min.z,
              maxZ: b.max.z,
              topY: b.max.y
            });
          }
        }
      }

      if (houseRefs.porchNode) {
        const porchMeshes = [];
        houseRefs.porchNode.traverse(m => { if (m.isMesh) porchMeshes.push(m); });
        let porchBox = null;
        for (const m of porchMeshes) {
          houseRefs.walkableSurfaceMeshes.push(m);
          const b = new THREE.Box3().setFromObject(m);
          // Ambil primitive papan lantai atas teras (min.y > 0.35 * S)
          if (b.min.y > HOUSE_EXTERIOR_POS.y + 0.35 * HOUSE_EXTERIOR_SCALE) {
            if (!porchBox) porchBox = b.clone();
            else porchBox.union(b);
          }
        }
        if (porchBox) {
          dynamicStepBoxes.push({
            id: 'teras',
            minX: porchBox.min.x,
            maxX: porchBox.max.x,
            minZ: porchBox.min.z,
            maxZ: porchBox.max.z,
            topY: porchBox.max.y
          });
        }
      }

      if (dynamicStepBoxes.length >= 3) {
        houseRefs.stepAndPorchBoxes = dynamicStepBoxes;
      }
    },
    err => console.error('Gagal memuat rumah.glb:', err)
  );

  // 2. PASANG INTERIOR RUMAH PETANI (interior-rumah-petani-bertekstur.glb)
  const intGroup = houseRefs.interiorGroup;
  intGroup.name = 'InteriorRumahPetaniGroup';
  intGroup.position.set(INTERIOR_ORIGIN.x, INTERIOR_ORIGIN.y, INTERIOR_ORIGIN.z);
  scene.add(intGroup);

  // Collider kotak (AABB) untuk perabot besar di dalam interior (relatif terhadap INTERIOR_ORIGIN):
  // Karpet lantai pada MejaMakan tidak diberi collider agar karakter bebas berjalan di atas karpet.
  const ix = INTERIOR_ORIGIN.x;
  const iz = INTERIOR_ORIGIN.z;
  const IS = INTERIOR_SCALE;
  interiorBoxColliders.push(
    // 1. Tempat Tidur (sudut kiri-belakang)
    { name: 'TempatTidur', minX: ix - 4.02 * IS, maxX: ix - 1.50 * IS, minZ: iz - 2.88 * IS, maxZ: iz - 1.32 * IS },
    // 2. Meja Nakas di samping Tempat Tidur
    { name: 'NakasTidur',  minX: ix - 3.98 * IS, maxX: ix - 3.32 * IS, minZ: iz - 1.22 * IS, maxZ: iz - 0.58 * IS },
    // 3. Meja Dapur & Kompor (dinding belakang-kanan)
    { name: 'Dapur',       minX: ix + 0.48 * IS, maxX: ix + 3.85 * IS, minZ: iz - 3.05 * IS, maxZ: iz - 2.12 * IS },
    // 4. Meja Makan & Kursi (tengah ruangan, tanpa menghitung karpet lantai)
    { name: 'MejaMakan',   minX: ix - 0.72 * IS, maxX: ix + 1.32 * IS, minZ: iz - 0.88 * IS, maxZ: iz + 1.82 * IS },
    // 5. Tumpukan Karung & Peti Hasil Panen (sisi kiri-depan)
    { name: 'KarungPanen', minX: ix - 3.78 * IS, maxX: ix - 2.18 * IS, minZ: iz + 0.52 * IS, maxZ: iz + 1.58 * IS },
    { name: 'PetiPanen',   minX: ix - 3.75 * IS, maxX: ix - 0.52 * IS, minZ: iz + 1.88 * IS, maxZ: iz + 2.88 * IS }
  );

  // Pencahayaan Interior yang Hangat & Nyaman
  // a) Lampu titik utama di bawah LampuGantung (tengah ruangan)
  const mainLampLight = new THREE.PointLight(0xFFE0B2, 2.4, 18, 1.2);
  mainLampLight.position.set(0.30 * IS, 2.05 * IS, 0.50 * IS);
  mainLampLight.castShadow = true;
  mainLampLight.shadow.bias = -0.002;
  intGroup.add(mainLampLight);

  // b) Lampu hangat di dekat lampu meja tidur (TempatTidur) & area dapur
  const bedLampLight = new THREE.PointLight(0xFFB74D, 1.35, 10, 1.3);
  bedLampLight.position.set(-3.45 * IS, 1.25 * IS, -0.90 * IS);
  intGroup.add(bedLampLight);

  // c) Cahaya lembut dari arah Jendela & pengisi ruangan agar tidak ada sudut yang terlalu gelap
  const windowFillLight = new THREE.PointLight(0xFFF8E1, 1.25, 15, 1.2);
  windowFillLight.position.set(-1.50 * IS, 2.10 * IS, -1.80 * IS);
  intGroup.add(windowFillLight);

  const doorFillLight = new THREE.PointLight(0xFFE8C2, 1.1, 12, 1.3);
  doorFillLight.position.set(2.60 * IS, 2.10 * IS, 1.20 * IS);
  intGroup.add(doorFillLight);

  houseRefs.interiorLights.push(mainLampLight, bedLampLight, windowFillLight, doorFillLight);

  // Hitbox interaksi di sekitar node "Pintu" dalam rumah
  const intDoorHitbox = new THREE.Mesh(
    new THREE.BoxGeometry(0.65 * IS, 2.35 * IS, 1.45 * IS),
    new THREE.MeshBasicMaterial({ visible: false })
  );
  intDoorHitbox.position.set(ix + 3.82 * IS, 1.15 * IS, iz + 1.20 * IS);
  scene.add(intDoorHitbox);
  const intDoorInteractable = {
    mesh: intDoorHitbox,
    type: 'houseDoorIn',
    position: new THREE.Vector3(ZONA_PINTU_DALAM.x, ZONA_PINTU_DALAM.y, ZONA_PINTU_DALAM.z),
    group: null
  };
  interactables.push(intDoorInteractable);

  // Hitbox interaksi pada objek TempatTidur yang sudah ada di dalam interior rumah (tidak menambah mesh kasur baru)
  const bedHitbox = new THREE.Mesh(
    new THREE.BoxGeometry(2.50 * IS, 1.10 * IS, 1.55 * IS),
    new THREE.MeshBasicMaterial({ visible: false })
  );
  bedHitbox.position.set(ZONA_TEMPAT_TIDUR.x, 0.55 * IS, ZONA_TEMPAT_TIDUR.z);
  scene.add(bedHitbox);
  const bedInteractable = {
    mesh: bedHitbox,
    type: 'bed',
    position: new THREE.Vector3(ZONA_TEMPAT_TIDUR.x, ZONA_TEMPAT_TIDUR.y, ZONA_TEMPAT_TIDUR.z),
    group: null
  };
  interactables.push(bedInteractable);

  loadGLBWithFallback(
    INTERIOR_GLB_B64,
    './interior-rumah-petani-bertekstur.glb',
    gltf => {
      const root = gltf.scene;
      root.scale.setScalar(INTERIOR_SCALE);

      root.traverse(obj => {
        if (obj.isMesh) {
          obj.frustumCulled = false;
          obj.receiveShadow = true;
          const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
          for (const m of mats) {
            if (!m) continue;
            if (m.map) {
              m.map.colorSpace = THREE.SRGBColorSpace;
              m.map.wrapS = THREE.RepeatWrapping;
              m.map.wrapT = THREE.RepeatWrapping;
              m.map.needsUpdate = true;
            }
            if (m.name && m.name.includes('emisif')) {
              m.emissiveIntensity = 1.6;
            }
          }
        }
        if (obj.name === 'Pintu') {
          houseRefs.interiorDoorNode = obj;
          intDoorInteractable.group = obj;
        } else if (obj.name === 'TempatTidur') {
          houseRefs.bedNode = obj;
          bedInteractable.group = obj;
        } else if (obj.name === 'DindingDepan') {
          houseRefs.dindingDepanNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        } else if (obj.name === 'DindingBelakang') {
          houseRefs.dindingBelakangNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        } else if (obj.name === 'DindingKiri') {
          houseRefs.dindingKiriNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        } else if (obj.name === 'DindingKanan') {
          houseRefs.dindingKananNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        } else if (obj.name === 'Jendela') {
          houseRefs.jendelaNode = obj;
        } else if (obj.name === 'Lukisan') {
          houseRefs.lukisanNode = obj;
        } else if (obj.name === 'Plafon') {
          houseRefs.plafonNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        } else if (obj.name === 'BalokPlafon') {
          houseRefs.balokPlafonNode = obj;
          obj.traverse(c => { if (c.isMesh) c.castShadow = false; });
        }
      });

      intGroup.add(root);
      updateInteriorWallAndCeilingVisibility();
    },
    err => console.error('Gagal memuat interior-rumah-petani-bertekstur.glb:', err)
  );
}

// Sembunyikan dinding & plafon secara dinamis (cutaway 360 derajat) saat player di dalam rumah agar pandangan kamera tidak terhalang
function updateInteriorWallAndCeilingVisibility() {
  if (!state.isInsideHouse) {
    if (houseRefs.dindingDepanNode) houseRefs.dindingDepanNode.visible = true;
    if (houseRefs.dindingBelakangNode) houseRefs.dindingBelakangNode.visible = true;
    if (houseRefs.dindingKiriNode) houseRefs.dindingKiriNode.visible = true;
    if (houseRefs.dindingKananNode) houseRefs.dindingKananNode.visible = true;
    if (houseRefs.jendelaNode) houseRefs.jendelaNode.visible = true;
    if (houseRefs.lukisanNode) houseRefs.lukisanNode.visible = true;
    if (houseRefs.plafonNode) houseRefs.plafonNode.visible = true;
    if (houseRefs.balokPlafonNode) houseRefs.balokPlafonNode.visible = true;
    return;
  }

  // 1. Plafon & BalokPlafon disembunyikan jika kamera melihat dari atas (cam.pitch > 0.02)
  const showCeiling = (cam.pitch <= 0.02);
  if (houseRefs.plafonNode) houseRefs.plafonNode.visible = showCeiling;
  if (houseRefs.balokPlafonNode) houseRefs.balokPlafonNode.visible = showCeiling;

  const cosPitch = Math.cos(cam.pitch);
  const camOffsetX = Math.sin(cam.yaw) * cosPitch * cam.dist;
  const camOffsetZ = Math.cos(cam.yaw) * cosPitch * cam.dist;
  const camLocalX = (playerGroup.position.x - INTERIOR_ORIGIN.x) + camOffsetX;
  const camLocalZ = (playerGroup.position.z - INTERIOR_ORIGIN.z) + camOffsetZ;

  // 2. DindingDepan (+Z) disembunyikan jika kamera berada di sisi depan
  if (houseRefs.dindingDepanNode) {
    houseRefs.dindingDepanNode.visible = !(camLocalZ > 1.8 || Math.cos(cam.yaw) > 0.25);
  }

  // 3. DindingBelakang (-Z) beserta Jendela & Lukisan disembunyikan jika kamera berputar ke belakang dinding belakang
  const hideBackWall = (camLocalZ < -2.2 || Math.cos(cam.yaw) < -0.45);
  if (houseRefs.dindingBelakangNode) houseRefs.dindingBelakangNode.visible = !hideBackWall;
  if (houseRefs.jendelaNode) houseRefs.jendelaNode.visible = !hideBackWall;
  if (houseRefs.lukisanNode) houseRefs.lukisanNode.visible = !hideBackWall;

  // 4. DindingKanan (+X) disembunyikan jika kamera berputar ke sisi kanan luar, tetapi Pintu tetap terlihat
  if (houseRefs.dindingKananNode) {
    houseRefs.dindingKananNode.visible = !(camLocalX > 3.65 || Math.sin(cam.yaw) > 0.48);
  }
  if (houseRefs.interiorDoorNode) {
    houseRefs.interiorDoorNode.visible = true;
  }

  // 5. DindingKiri (-X) disembunyikan jika kamera berputar ke sisi kiri luar
  if (houseRefs.dindingKiriNode) {
    houseRefs.dindingKiriNode.visible = !(camLocalX < -3.4 || Math.sin(cam.yaw) < -0.48);
  }
}

// ==================== SISTEM ANIMASI TRANSISI TELEPORT (MASUK & KELUAR RUMAH) ====================
const teleportOverlayEl = document.getElementById('teleport-overlay');
const teleportCanvasEl  = document.getElementById('teleport-canvas');
const teleportCtx       = teleportCanvasEl ? teleportCanvasEl.getContext('2d') : null;

const teleportState = {
  active: false,          // Mengunci kontrol & mencegah pemicuan ganda selama transisi
  targetLocation: null,   // 'masuk' | 'keluar'
  elapsed: 0,
  duration: TELEPORT_CONFIG.duration,
  switchedAtPeak: false,  // Apakah player sudah dipindahkan pada puncak putih penuh (50%)
  baseFov: 55,
  particles: []
};

function initTeleportParticles() {
  if (!teleportCanvasEl) return;
  teleportCanvasEl.width = window.innerWidth;
  teleportCanvasEl.height = window.innerHeight;
  const cx = teleportCanvasEl.width / 2;
  const cy = teleportCanvasEl.height / 2;
  const maxR = Math.hypot(cx, cy) * 0.95;

  teleportState.particles.length = 0;
  const colors = ['#FFFFFF', '#FFF8E1', '#FFECB3', '#FFFDE7'];
  for (let i = 0; i < TELEPORT_CONFIG.particleCount; i++) {
    const angle = (i / TELEPORT_CONFIG.particleCount) * Math.PI * 2 + (Math.random() - 0.5) * 0.25;
    const distRatio = 0.2 + Math.random() * 0.8;
    teleportState.particles.push({
      angle,
      startDist: distRatio * maxR,
      speedMult: 0.75 + Math.random() * 0.65,
      size: 3.5 + Math.random() * 5.5,
      color: colors[i % colors.length],
      twinklePhase: Math.random() * Math.PI * 2
    });
  }
}

// Satu fungsi terpadu untuk Masuk ('masuk') dan Keluar ('keluar') rumah
function TeleportDenganTransisi(lokasiTujuan) {
  if (teleportState.active || state.isSleeping) return; // Cegah pemicuan dua kali selama transisi berjalan
  if (lokasiTujuan !== 'masuk' && lokasiTujuan !== 'keluar') return;

  closeAllPanels();
  teleportState.active = true;
  state.isTeleporting = true;
  teleportState.targetLocation = lokasiTujuan;
  teleportState.elapsed = 0;
  teleportState.duration = TELEPORT_CONFIG.duration;
  teleportState.switchedAtPeak = false;
  teleportState.baseFov = 60;

  // Hentikan langkah kaki sementara selama transisi
  currentMoveSpeed = 0;
  isRunningState = false;
  isMoving = false;

  initTeleportParticles();
  if (teleportOverlayEl) {
    teleportOverlayEl.style.background = 'radial-gradient(circle at center,#ffffff 0%,#fffdf5 65%,#fff8e1 100%)';
    teleportOverlayEl.style.display = 'block';
    teleportOverlayEl.style.opacity = '0';
  }
  if (teleportCanvasEl) {
    teleportCanvasEl.style.display = 'block';
  }
}
window.TeleportDenganTransisi = TeleportDenganTransisi;

function applyTeleportDestination(lokasiTujuan) {
  if (lokasiTujuan === 'masuk') {
    state.isInsideHouse = true;
    currentGroundY = TITIK_SPAWN_MASUK.y;
    targetGroundY = TITIK_SPAWN_MASUK.y;
    walkBobOffset = 0;
    playerGroup.position.set(TITIK_SPAWN_MASUK.x, TITIK_SPAWN_MASUK.y, TITIK_SPAWN_MASUK.z);
    _turnEuler.set(0, TITIK_SPAWN_MASUK.rotY, 0, 'XYZ');
    playerBodyGroup.quaternion.setFromEuler(_turnEuler);
    perbaruiAnimasiKarakter(0.016, 0, false);

    // Atur kamera menghadap ke arah dalam ruangan
    cam.yaw = cam.tYaw = TITIK_SPAWN_MASUK.camYaw;
    cam.pitch = cam.tPitch = TITIK_SPAWN_MASUK.camPitch;
    cam.dist = cam.tDist = TITIK_SPAWN_MASUK.camDist;

    // Suasana pencahayaan interior hangat (matikan kabut langit luar sementara)
    scene.background = new THREE.Color(0x1E140F);
    scene.fog = null;
    updateInteriorWallAndCeilingVisibility();
  } else {
    state.isInsideHouse = false;
    const exitGroundY = getSurfaceHeight(TITIK_SPAWN_KELUAR.x, TITIK_SPAWN_KELUAR.z);
    currentGroundY = exitGroundY;
    targetGroundY = exitGroundY;
    walkBobOffset = 0;
    playerGroup.position.set(TITIK_SPAWN_KELUAR.x, exitGroundY, TITIK_SPAWN_KELUAR.z);
    _turnEuler.set(0, TITIK_SPAWN_KELUAR.rotY, 0, 'XYZ');
    playerBodyGroup.quaternion.setFromEuler(_turnEuler);
    perbaruiAnimasiKarakter(0.016, 0, false);

    // Atur kamera menghadap ke halaman depan menjauh dari pintu luar
    cam.yaw = cam.tYaw = TITIK_SPAWN_KELUAR.camYaw;
    cam.pitch = cam.tPitch = TITIK_SPAWN_KELUAR.camPitch;
    cam.dist = cam.tDist = TITIK_SPAWN_KELUAR.camDist;

    // Kembalikan warna langit & kabut dunia luar sesuai waktu game saat ini
    updateDayNightCycle(0, true);
    updateInteriorWallAndCeilingVisibility();
  }

  // Pastikan item yang sedang dipegang di HandGrip tetap terbawa
  updateHeldItem();
}

function updateTeleportTransition(dt) {
  if (!teleportState.active) return;

  teleportState.elapsed += dt;
  const progress = Math.min(1.0, teleportState.elapsed / Math.max(0.1, teleportState.duration));
  const cx = teleportCanvasEl ? teleportCanvasEl.width / 2 : window.innerWidth / 2;
  const cy = teleportCanvasEl ? teleportCanvasEl.height / 2 : window.innerHeight / 2;
  const maxR = Math.hypot(cx, cy) * 0.95;

  if (progress < 0.5) {
    // TAHAP 1 (0% -> 50%): ZOOM IN & LAYAR MEMUTIH + PARTIKEL BERGERAK KE TENGAH
    const tIn = progress / 0.5;
    const easeIn = smoothstep01(tIn);
    if (teleportOverlayEl) {
      teleportOverlayEl.style.opacity = easeIn.toFixed(3);
    }
    camera.fov = teleportState.baseFov - TELEPORT_CONFIG.zoomFovDelta * easeIn;
    camera.updateProjectionMatrix();

    if (teleportCtx) {
      teleportCtx.clearRect(0, 0, teleportCanvasEl.width, teleportCanvasEl.height);
      for (const p of teleportState.particles) {
        // Partikel bergerak masuk menuju titik tengah layar
        const curDist = Math.max(0, p.startDist * (1 - easeIn * p.speedMult));
        const px = cx + Math.cos(p.angle) * curDist;
        const py = cy + Math.sin(p.angle) * curDist;
        const alpha = Math.sin(tIn * Math.PI) * 0.95;

        teleportCtx.save();
        teleportCtx.globalAlpha = alpha;
        teleportCtx.fillStyle = p.color;
        teleportCtx.shadowColor = '#FFF8E1';
        teleportCtx.shadowBlur = 14;
        teleportCtx.beginPath();
        teleportCtx.arc(px, py, p.size * (0.7 + 0.5 * easeIn), 0, Math.PI * 2);
        teleportCtx.fill();
        teleportCtx.restore();
      }
    }
  } else {
    // PUNCAK PUTIH PENUH (50%): Pindahkan lokasi player & kamera tepat saat layar putih penuh
    if (!teleportState.switchedAtPeak) {
      teleportState.switchedAtPeak = true;
      applyTeleportDestination(teleportState.targetLocation);
    }

    // TAHAP 2 (50% -> 100%): ZOOM OUT & LAYAR KEMBALI NORMAL + PARTIKEL MENYEBAR KELUAR
    const tOut = (progress - 0.5) / 0.5;
    const easeOut = smoothstep01(tOut);
    if (teleportOverlayEl) {
      teleportOverlayEl.style.opacity = (1.0 - easeOut).toFixed(3);
    }
    camera.fov = (teleportState.baseFov - TELEPORT_CONFIG.zoomFovDelta) + TELEPORT_CONFIG.zoomFovDelta * easeOut;
    camera.updateProjectionMatrix();

    if (teleportCtx) {
      teleportCtx.clearRect(0, 0, teleportCanvasEl.width, teleportCanvasEl.height);
      for (const p of teleportState.particles) {
        // Partikel menyebar keluar dari tengah layar
        const curDist = easeOut * maxR * p.speedMult;
        const px = cx + Math.cos(p.angle) * curDist;
        const py = cy + Math.sin(p.angle) * curDist;
        const alpha = (1 - easeOut) * 0.95;

        teleportCtx.save();
        teleportCtx.globalAlpha = alpha;
        teleportCtx.fillStyle = p.color;
        teleportCtx.shadowColor = '#FFF8E1';
        teleportCtx.shadowBlur = 14;
        teleportCtx.beginPath();
        teleportCtx.arc(px, py, p.size * (1.2 - 0.5 * easeOut), 0, Math.PI * 2);
        teleportCtx.fill();
        teleportCtx.restore();
      }
    }
  }

  if (progress >= 1.0) {
    // Transisi selesai: kembalikan FOV normal & buka kunci kontrol player
    teleportState.active = false;
    state.isTeleporting = false;
    camera.fov = teleportState.baseFov;
    camera.updateProjectionMatrix();
    if (teleportOverlayEl) {
      teleportOverlayEl.style.opacity = '0';
      teleportOverlayEl.style.display = 'none';
    }
    if (teleportCanvasEl) {
      teleportCtx.clearRect(0, 0, teleportCanvasEl.width, teleportCanvasEl.height);
      teleportCanvasEl.style.display = 'none';
    }
  }
}

// ==================== SISTEM TIDUR & ANIMASI BANGUN TIDUR 3 TAHAP (#teleport-overlay & #teleport-canvas) ====================
function easeInOutCubic(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

const sleepState = {
  active: false,
  stage1Duration: 1.2,   // Tahap 1: Layar Hitam Zoom In (1.2 detik)
  stage2Duration: 0.4,   // Tahap 2: Jeda saat Layar 100% Full Hitam Pekat (0.4 detik) + Skip 3 Menit & Pindah Posisi
  stage3Duration: 1.2,   // Tahap 3: Layar Hitam Zoom Out (1.2 detik)
  skippedAtPeak: false,  // Apakah skip waktu 3 menit & pindah ke samping kasur sudah dijalankan saat layar full hitam
  snapCameraNow: false,  // Snap posisi kamera tepat saat player dipindahkan ke samping tempat tidur
  lyingOnBed: false,
  baseFov: 60,
  targetZoomFov: 32,
  startDist: 4.2,
  zoomTargetDist: 2.1,
  rafId: null,
  startTimeMs: 0
};

// Gambar transisi iris/lingkaran hitam menutup (Zoom In) atau membuka (Zoom Out) pada #teleport-canvas & #teleport-overlay
function drawSleepBlackIris(holeRadius, maxR, overlayOpacity) {
  if (teleportOverlayEl) {
    teleportOverlayEl.style.opacity = Math.max(0, Math.min(1, overlayOpacity)).toFixed(3);
  }
  if (!teleportCanvasEl || !teleportCtx) return;

  if (teleportCanvasEl.width !== window.innerWidth || teleportCanvasEl.height !== window.innerHeight) {
    teleportCanvasEl.width = window.innerWidth;
    teleportCanvasEl.height = window.innerHeight;
  }

  const w = teleportCanvasEl.width;
  const h = teleportCanvasEl.height;
  const cx = w / 2;
  const cy = h / 2;

  teleportCtx.clearRect(0, 0, w, h);

  if (holeRadius <= 1.5) {
    // 100% FULL HITAM PEKAT
    teleportCtx.fillStyle = '#000000';
    teleportCtx.fillRect(0, 0, w, h);
    return;
  }

  // Iris lingkaran hitam menutup ke arah tengah layar / membuka dari tengah layar
  const innerR = Math.max(0, holeRadius * 0.72);
  const outerR = Math.max(innerR + 1, holeRadius);
  const grad = teleportCtx.createRadialGradient(cx, cy, innerR, cx, cy, outerR);
  const centerDarkAlpha = Math.max(0, Math.min(1, 1 - (holeRadius / Math.max(1, maxR))));
  grad.addColorStop(0, `rgba(0, 0, 0, ${(centerDarkAlpha * 0.78).toFixed(3)})`);
  grad.addColorStop(0.65, `rgba(0, 0, 0, ${(0.45 + centerDarkAlpha * 0.55).toFixed(3)})`);
  grad.addColorStop(1, 'rgba(0, 0, 0, 1)');

  teleportCtx.fillStyle = grad;
  teleportCtx.fillRect(0, 0, w, h);
}

function stepSleepAnimation(nowMs) {
  if (!sleepState.active) return;

  const elapsedSec = Math.max(0, (nowMs - sleepState.startTimeMs) / 1000);
  const d1 = sleepState.stage1Duration; // 1.2s
  const d2 = sleepState.stage2Duration; // 0.4s
  const d3 = sleepState.stage3Duration; // 1.2s
  const totalDur = d1 + d2 + d3;        // 2.8s

  const w = teleportCanvasEl ? teleportCanvasEl.width : window.innerWidth;
  const h = teleportCanvasEl ? teleportCanvasEl.height : window.innerHeight;
  const maxR = Math.hypot(w / 2, h / 2) * 1.08;

  if (elapsedSec < d1) {
    // ==================== TAHAP 1: ANIMASI TIDUR — LAYAR HITAM ZOOM IN (1.2 detik) ====================
    const t = Math.max(0, Math.min(1, elapsedSec / d1));
    const eased = easeInOutCubic(t);

    // Iris lingkaran hitam mengecil ke tengah layar + fade hitam hingga t = 1 tertutup 100% FULL HITAM PEKAT
    const holeRadius = maxR * (1 - eased);
    drawSleepBlackIris(holeRadius, maxR, eased);

    // Zoom In Kamera: kecilkan camera.fov dari 60 -> 32 dan kurangi jarak kamera mendekat ke tempat tidur
    camera.fov = THREE.MathUtils.lerp(sleepState.baseFov, sleepState.targetZoomFov, eased);
    camera.updateProjectionMatrix();
    const curDist = THREE.MathUtils.lerp(sleepState.startDist, sleepState.zoomTargetDist, eased);
    cam.tDist = curDist;
    cam.dist = curDist;

    sleepState.rafId = requestAnimationFrame(stepSleepAnimation);
  } else if (elapsedSec < d1 + d2) {
    // ==================== TAHAP 2: SAAT LAYAR 100% FULL HITAM (Jeda 0.4 detik) ====================
    drawSleepBlackIris(0, maxR, 1.0);
    camera.fov = sleepState.targetZoomFov;
    camera.updateProjectionMatrix();
    cam.tDist = sleepState.zoomTargetDist;
    cam.dist = sleepState.zoomTargetDist;

    if (!sleepState.skippedAtPeak) {
      sleepState.skippedAtPeak = true;

      // 1) Skip waktu 5 menit in-game (otomatis lewat 23:59 -> 00:00 & Hari +1 jika perlu) & perbarui langit/pencahayaan
      const skipMinutes = CONFIG.sleepSkipMinutes || 5;
      state.gameTime += skipMinutes;
      updateDayNightCycle(0, true);
      updateTimeUI();

      // 2) Selesaikan otomatis progres seluruh tanaman yang ditanam/disiram & seluruh ternak yang diberi makan
      completeAllProgressOnSleep();

      // 3) Pindahkan posisi karakter player ke samping tempat tidur di dalam interior rumah (berdiri di lantai, tidak nyangkut di collider kasur)
      playerGroup.position.set(TITIK_BANGUN_TIDUR.x, TITIK_BANGUN_TIDUR.y, TITIK_BANGUN_TIDUR.z);
      _turnEuler.set(0, TITIK_BANGUN_TIDUR.rotY, 0, 'XYZ');
      playerBodyGroup.quaternion.setFromEuler(_turnEuler);
      perbaruiAnimasiKarakter(0.016, 0, false);

      // Snap posisi kamera ke samping tempat tidur saat layar masih 100% full hitam
      sleepState.snapCameraNow = true;
    }

    sleepState.rafId = requestAnimationFrame(stepSleepAnimation);
  } else if (elapsedSec < totalDur) {
    // ==================== TAHAP 3: ANIMASI TERBANGUN — LAYAR HITAM ZOOM OUT (1.2 detik) ====================
    if (!sleepState.skippedAtPeak) {
      sleepState.skippedAtPeak = true;
      state.gameTime += (CONFIG.sleepSkipMinutes || 5);
      updateDayNightCycle(0, true);
      updateTimeUI();
      completeAllProgressOnSleep();
      playerGroup.position.set(TITIK_BANGUN_TIDUR.x, TITIK_BANGUN_TIDUR.y, TITIK_BANGUN_TIDUR.z);
      _turnEuler.set(0, TITIK_BANGUN_TIDUR.rotY, 0, 'XYZ');
      playerBodyGroup.quaternion.setFromEuler(_turnEuler);
      perbaruiAnimasiKarakter(0.016, 0, false);
      sleepState.snapCameraNow = true;
    }

    const t = Math.max(0, Math.min(1, (elapsedSec - (d1 + d2)) / d3));
    const eased = easeInOutCubic(t);

    // Iris lingkaran hitam membesar membuka pandangan dari full hitam sehingga player terlihat berdiri di samping tempat tidur
    const holeRadius = maxR * eased;
    drawSleepBlackIris(holeRadius, maxR, 1 - eased);

    // Zoom Out Kamera: kembalikan camera.fov dari 32 -> 60 dan kembalikan jarak kamera (camDist) ke nilai semula
    camera.fov = THREE.MathUtils.lerp(sleepState.targetZoomFov, sleepState.baseFov, eased);
    camera.updateProjectionMatrix();
    const curDist = THREE.MathUtils.lerp(sleepState.zoomTargetDist, sleepState.startDist, eased);
    cam.tDist = curDist;
    cam.dist = curDist;

    sleepState.rafId = requestAnimationFrame(stepSleepAnimation);
  } else {
    // ==================== SELESAI TAHAP 3 (t = 1): KEMBALIKAN NORMAL & BUKA KONTROL ====================
    sleepState.active = false;
    sleepState.lyingOnBed = false;
    sleepState.rafId = null;
    state.isSleeping = false;
    state.isTeleporting = false;

    camera.fov = sleepState.baseFov;
    camera.updateProjectionMatrix();
    cam.tDist = sleepState.startDist;
    cam.dist = sleepState.startDist;

    if (teleportOverlayEl) {
      teleportOverlayEl.style.opacity = '0';
      teleportOverlayEl.style.display = 'none';
      teleportOverlayEl.style.background = 'radial-gradient(circle at center,#ffffff 0%,#fffdf5 65%,#fff8e1 100%)';
    }
    if (teleportCanvasEl && teleportCtx) {
      teleportCtx.clearRect(0, 0, teleportCanvasEl.width, teleportCanvasEl.height);
      teleportCanvasEl.style.display = 'none';
    }

    completeAllProgressOnSleep();
    updateTimeUI();
    saveGame();
    showNotif(`💤 Kamu bangun tidur! Waktu maju +${CONFIG.sleepSkipMinutes || 5} menit (${timeClockLabelEl ? timeClockLabelEl.textContent : ''} • Hari ke-${state.gameDay}). Tanaman siap panen & produksi ternak selesai.`);
  }
}

function startSleepSequence() {
  if (!state.isInsideHouse || state.isSleeping || sleepState.active || teleportState.active) return;

  const dBed = getDistToInteriorBed(playerGroup.position);
  if (dBed > (CONFIG.bedInteractDistance || 2.5)) {
    showNotif('🛏️ Dekati kasur terlebih dahulu untuk tidur!');
    return;
  }

  closeAllPanels();
  if (sleepState.rafId) {
    cancelAnimationFrame(sleepState.rafId);
    sleepState.rafId = null;
  }

  // Kunci pergerakan player selama animasi 3 tahap berlangsung
  state.isSleeping = true;
  state.isTeleporting = true;
  sleepState.active = true;
  sleepState.skippedAtPeak = false;
  sleepState.snapCameraNow = false;
  sleepState.lyingOnBed = false;
  sleepState.baseFov = 60;
  sleepState.startDist = THREE.MathUtils.clamp(cam.dist || 4.2, 3.2, 4.8);
  sleepState.startTimeMs = performance.now();

  currentMoveSpeed = 0;
  isRunningState = false;
  isMoving = false;

  // Sembunyikan tombol kontekstual & hint selama animasi tidur berlangsung
  const sleepBtn = document.getElementById('cb-sleep');
  if (sleepBtn) sleepBtn.classList.remove('vis');
  const hintEl = document.getElementById('interact-hint');
  if (hintEl) hintEl.style.display = 'none';

  // Siapkan #teleport-overlay (hitam pekat) & #teleport-canvas di atas seluruh UI
  if (teleportOverlayEl) {
    teleportOverlayEl.style.background = '#000000';
    teleportOverlayEl.style.display = 'block';
    teleportOverlayEl.style.opacity = '0';
  }
  if (teleportCanvasEl) {
    teleportCanvasEl.width = window.innerWidth;
    teleportCanvasEl.height = window.innerHeight;
    teleportCanvasEl.style.display = 'block';
  }

  // Mulai animasi bertahap menggunakan requestAnimationFrame (Tahap 1 -> Tahap 2 -> Tahap 3)
  sleepState.rafId = requestAnimationFrame(stepSleepAnimation);
}

