// ==================== MODEL 3D AYAM (ayam.glb) & ANIMASI SENDI ====================
const AYAM_GLB_GZIP_B64 = '';
const CHICKEN_MODEL_SCALE = 1.15;
let chickenModelTemplate = null;

function extractChickenRig(modelRoot) {
  const badan = modelRoot.getObjectByName('badan');
  const leher = modelRoot.getObjectByName('leher');
  const kepala = modelRoot.getObjectByName('kepala');
  const sayap_kiri = modelRoot.getObjectByName('sayap_kiri');
  const sayap_kanan = modelRoot.getObjectByName('sayap_kanan');
  const ekor = modelRoot.getObjectByName('ekor');
  const paha_kiri = modelRoot.getObjectByName('paha_kiri');
  const betis_kiri = modelRoot.getObjectByName('betis_kiri');
  const kaki_kiri = modelRoot.getObjectByName('kaki_kiri');
  const paha_kanan = modelRoot.getObjectByName('paha_kanan');
  const betis_kanan = modelRoot.getObjectByName('betis_kanan');
  const kaki_kanan = modelRoot.getObjectByName('kaki_kanan');

  return {
    badan,
    leher,
    kepala,
    sayap_kiri,
    sayap_kanan,
    ekor,
    paha_kiri,
    betis_kiri,
    kaki_kiri,
    paha_kanan,
    betis_kanan,
    kaki_kanan,
    baseBadanY: badan ? badan.position.y : 0.21,
    baseLeherRotX: leher ? leher.rotation.x : 0,
    baseKepalaRotX: kepala ? kepala.rotation.x : 0,
    baseKepalaRotY: kepala ? kepala.rotation.y : 0,
    baseSayapKiriRotZ: sayap_kiri ? sayap_kiri.rotation.z : 0,
    baseSayapKananRotZ: sayap_kanan ? sayap_kanan.rotation.z : 0,
    baseEkorRotX: ekor ? ekor.rotation.x : 0,
    baseEkorRotY: ekor ? ekor.rotation.y : 0,
    baseEkorRotZ: ekor ? ekor.rotation.z : 0
  };
}

function attachChickenModelToAnimal(aData) {
  if (!aData || aData.type !== 'ayam' || !aData.mesh || !chickenModelTemplate) return;
  const g = aData.mesh;

  // Hapus mesh ayam lama / placeholder di dalam grup induk ayam (kecuali sprite emoji hati)
  const toRemove = [];
  for (const child of g.children) {
    if (child !== aData.emojiSprite) {
      toRemove.push(child);
    }
  }
  for (const child of toRemove) {
    g.remove(child);
  }

  const cloneScene = chickenModelTemplate.clone(true);
  cloneScene.position.set(0, 0, 0);
  cloneScene.rotation.set(0, 0, 0);
  cloneScene.scale.setScalar(CHICKEN_MODEL_SCALE);

  let primaryBodyMesh = null;
  cloneScene.traverse(child => {
    if (child.isMesh) {
      child.castShadow = true;
      child.receiveShadow = true;
      child.frustumCulled = false;
      if (child.material) {
        child.material = Array.isArray(child.material)
          ? child.material.map(m => m.clone())
          : child.material.clone();
        if (child.geometry && child.geometry.attributes && child.geometry.attributes.color) {
          if (Array.isArray(child.material)) {
            child.material.forEach(m => { m.vertexColors = true; m.needsUpdate = true; });
          } else {
            child.material.vertexColors = true;
            child.material.needsUpdate = true;
          }
        }
      }
      if (!primaryBodyMesh || child.name === 'mesh_badan') {
        primaryBodyMesh = child;
      }
    }
  });

  g.add(cloneScene);
  aData.modelRoot = cloneScene;
  aData.chickenRig = extractChickenRig(cloneScene);

  // Perbarui referensi mesh utama pada daftar interactables
  for (const ia of interactables) {
    if (ia.data === aData) {
      if (primaryBodyMesh) ia.mesh = primaryBodyMesh;
      ia.group = g;
      break;
    }
  }
}

function onChickenGLBLoaded(gltf) {
  if (!gltf || !gltf.scene) return;
  chickenModelTemplate = gltf.scene;
  chickenModelTemplate.position.set(0, 0, 0);
  chickenModelTemplate.rotation.set(0, 0, 0);
  chickenModelTemplate.scale.set(1, 1, 1);

  // Pasang model ayam.glb ke seluruh objek ayam yang sudah ada di Kandang Ayam (termasuk ayam awal & hasil loadGame)
  if (Array.isArray(state.animals)) {
    for (const a of state.animals) {
      if (a && a.type === 'ayam') {
        attachChickenModelToAnimal(a);
      }
    }
  }
}

function initChickenGLBModel() {
  const loader = new GLTFLoader();
  const loadFromFileFallback = () => {
    loader.load(
      './ayam.glb',
      onChickenGLBLoaded,
      undefined,
      err => console.error('Gagal memuat ./ayam.glb:', err)
    );
  };

  if (AYAM_GLB_GZIP_B64 && !AYAM_GLB_GZIP_B64.startsWith('__') && typeof DecompressionStream !== 'undefined') {
    try {
      const binStr = atob(AYAM_GLB_GZIP_B64);
      const gzBytes = new Uint8Array(binStr.length);
      for (let i = 0; i < binStr.length; i++) gzBytes[i] = binStr.charCodeAt(i);
      new Response(new Blob([gzBytes]).stream().pipeThrough(new DecompressionStream('gzip')))
        .arrayBuffer()
        .then(buf => {
          loader.parse(buf, '', onChickenGLBLoaded, err => {
            console.warn('Gagal parse AYAM_GLB_GZIP_B64, mencoba ./ayam.glb:', err);
            loadFromFileFallback();
          });
        })
        .catch(err => {
          console.warn('Gagal dekompresi AYAM_GLB_GZIP_B64, mencoba ./ayam.glb:', err);
          loadFromFileFallback();
        });
      return;
    } catch (e) {
      console.warn('Fallback ke ./ayam.glb:', e);
    }
  }
  loadFromFileFallback();
}

function updateChickenProceduralAnimation(a, dt, isWalking) {
  const rig = a.chickenRig;
  if (!rig) return;

  a.animPhase = (a.animPhase || Math.random() * 10) + dt;
  const t = a.animPhase;
  const blend = Math.min(1, dt * 12);

  if (isWalking) {
    a.walkTime = (a.walkTime || 0) + dt * 11.5;
    const wt = a.walkTime;
    const legSwing = Math.sin(wt) * 0.45;

    // a. Ayunan paha kiri & kanan maju-mundur bergantian pada rotation.x
    if (rig.paha_kiri) rig.paha_kiri.rotation.x = THREE.MathUtils.lerp(rig.paha_kiri.rotation.x, legSwing, blend);
    if (rig.paha_kanan) rig.paha_kanan.rotation.x = THREE.MathUtils.lerp(rig.paha_kanan.rotation.x, -legSwing, blend);

    // Tekukan betis & telapak kaki mengikuti langkah
    const kneeL = Math.max(0, -Math.cos(wt)) * 0.38;
    const kneeR = Math.max(0, Math.cos(wt)) * 0.38;
    if (rig.betis_kiri) rig.betis_kiri.rotation.x = THREE.MathUtils.lerp(rig.betis_kiri.rotation.x, kneeL, blend);
    if (rig.betis_kanan) rig.betis_kanan.rotation.x = THREE.MathUtils.lerp(rig.betis_kanan.rotation.x, kneeR, blend);
    if (rig.kaki_kiri) rig.kaki_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_kiri.rotation.x, -kneeL * 0.45, blend);
    if (rig.kaki_kanan) rig.kaki_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_kanan.rotation.x, -kneeR * 0.45, blend);

    // Anggukan maju-mundur ritmis khas ayam berjalan pada leher & kepala + bobbing pada badan
    if (rig.badan) {
      const bobY = rig.baseBadanY + Math.abs(Math.sin(wt)) * 0.016;
      rig.badan.position.y = THREE.MathUtils.lerp(rig.badan.position.y, bobY, blend);
    }
    const nod = Math.sin(wt * 2) * 0.14;
    if (rig.leher) {
      rig.leher.rotation.x = THREE.MathUtils.lerp(rig.leher.rotation.x, rig.baseLeherRotX + nod, blend);
    }
    if (rig.kepala) {
      rig.kepala.rotation.x = THREE.MathUtils.lerp(rig.kepala.rotation.x, rig.baseKepalaRotX - nod * 0.65, blend);
      rig.kepala.rotation.y = THREE.MathUtils.lerp(rig.kepala.rotation.y, rig.baseKepalaRotY + Math.sin(wt) * 0.05, blend);
    }

    // Kepakan/getaran kecil simetris pada sayap kiri dan kanan saat berjalan
    const wingFlutter = Math.abs(Math.sin(wt * 1.5)) * 0.12;
    if (rig.sayap_kiri) {
      rig.sayap_kiri.rotation.z = THREE.MathUtils.lerp(rig.sayap_kiri.rotation.z, rig.baseSayapKiriRotZ - wingFlutter, blend);
    }
    if (rig.sayap_kanan) {
      rig.sayap_kanan.rotation.z = THREE.MathUtils.lerp(rig.sayap_kanan.rotation.z, rig.baseSayapKananRotZ + wingFlutter, blend);
    }
  } else {
    // b. Saat Ayam Berdiri Diam (Idle): kembalikan rotasi kedua kaki secara halus (lerp) ke 0
    const idleLerp = Math.min(1, dt * 8.5);
    if (rig.paha_kiri) rig.paha_kiri.rotation.x = THREE.MathUtils.lerp(rig.paha_kiri.rotation.x, 0, idleLerp);
    if (rig.paha_kanan) rig.paha_kanan.rotation.x = THREE.MathUtils.lerp(rig.paha_kanan.rotation.x, 0, idleLerp);
    if (rig.betis_kiri) rig.betis_kiri.rotation.x = THREE.MathUtils.lerp(rig.betis_kiri.rotation.x, 0, idleLerp);
    if (rig.betis_kanan) rig.betis_kanan.rotation.x = THREE.MathUtils.lerp(rig.betis_kanan.rotation.x, 0, idleLerp);
    if (rig.kaki_kiri) rig.kaki_kiri.rotation.x = THREE.MathUtils.lerp(rig.kaki_kiri.rotation.x, 0, idleLerp);
    if (rig.kaki_kanan) rig.kaki_kanan.rotation.x = THREE.MathUtils.lerp(rig.kaki_kanan.rotation.x, 0, idleLerp);

    if (rig.badan) {
      rig.badan.position.y = THREE.MathUtils.lerp(rig.badan.position.y, rig.baseBadanY + Math.sin(t * 2.4) * 0.004, idleLerp);
    }

    // Animasi idle alami: menengok kiri-kanan halus pada kepala & gerakan mematuk ringan sesekali pada leher
    const peckWave = Math.max(0, Math.sin(t * 2.1) - 0.55) * 0.55;
    const lookYaw = Math.sin(t * 1.4) * 0.22;
    if (rig.leher) {
      rig.leher.rotation.x = THREE.MathUtils.lerp(rig.leher.rotation.x, rig.baseLeherRotX + peckWave, idleLerp);
    }
    if (rig.kepala) {
      rig.kepala.rotation.x = THREE.MathUtils.lerp(rig.kepala.rotation.x, rig.baseKepalaRotX + peckWave * 0.6, idleLerp);
      rig.kepala.rotation.y = THREE.MathUtils.lerp(rig.kepala.rotation.y, rig.baseKepalaRotY + lookYaw, idleLerp);
    }

    // Kembalikan sayap dengan getaran napas tipis saat diam
    const idleWing = Math.sin(t * 2.4) * 0.02;
    if (rig.sayap_kiri) {
      rig.sayap_kiri.rotation.z = THREE.MathUtils.lerp(rig.sayap_kiri.rotation.z, rig.baseSayapKiriRotZ - idleWing, idleLerp);
    }
    if (rig.sayap_kanan) {
      rig.sayap_kanan.rotation.z = THREE.MathUtils.lerp(rig.sayap_kanan.rotation.z, rig.baseSayapKananRotZ + idleWing, idleLerp);
    }
  }

  // c. Animasi Ekor (Jalan & Idle): bergoyang lembut ke kiri-kanan (rotation.y / rotation.z) dan sedikit naik-turun (rotation.x)
  if (rig.ekor) {
    const tailFreq = isWalking ? 6.0 : 2.8;
    const tailAmp = isWalking ? 0.14 : 0.07;
    rig.ekor.rotation.y = rig.baseEkorRotY + Math.sin(t * tailFreq) * tailAmp;
    rig.ekor.rotation.z = rig.baseEkorRotZ + Math.cos(t * tailFreq) * (tailAmp * 0.6);
    rig.ekor.rotation.x = rig.baseEkorRotX + Math.sin(t * (tailFreq * 0.5)) * 0.06;
  }
}

