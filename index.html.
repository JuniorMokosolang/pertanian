function equipInventoryItem(itemObj) {
  if (!itemObj) {
    clearHeldItem();
    return;
  }
  state.hotbarSelected = -1;
  state.activeItem = { ...itemObj };
  Equip(state.activeItem);
  refreshHotbar();
}

function updateHeldItem() {
  const items = getHotbarItems();
  if (state.hotbarSelected >= 0 && state.hotbarSelected < items.length) {
    const toolItem = items[state.hotbarSelected];
    state.activeItem = toolItem;
    Equip(toolItem);
    return;
  }

  if (state.activeItem && state.activeItem.type !== 'tool') {
    const ai = state.activeItem;
    let remaining = 0;
    if (ai.type === 'seed') {
      remaining = state.inventory.bibit[ai.id] || 0;
    } else if (ai.type === 'crop') {
      remaining = state.inventory.panen[ai.rawName || ai.name] || 0;
    } else if (ai.type === 'livestock') {
      remaining = state.inventory.ternak[ai.id] || 0;
    }
    if (remaining <= 0) {
      state.activeItem = null;
      Unequip();
      refreshHotbar();
      return;
    }
    ai.count = remaining;
    Equip(ai);
    refreshHotbar();
    return;
  }

  state.activeItem = null;
  Unequip();
}

