const cam = {
  yaw: 0, pitch: 0.6, dist: CONFIG.cameraDefaultDist,
  tYaw: 0, tPitch: 0.6, tDist: CONFIG.cameraDefaultDist
};

let screenShakeTimer = 0;
let screenShakeIntensity = 0;

function triggerScreenShake(duration = 0.7, intensity = 0.25) {
  screenShakeTimer = duration;
  screenShakeIntensity = intensity;
}

const camTouches = new Map();
const touchCamInertia = {
  velYaw: 0,
  velPitch: 0,
  lastMoveTime: 0
};

function updateCamera(dt) {
  if (camTouches.size === 0 && !teleportState.active && !state.isSleeping && !state.panelOpen) {
    if (Math.abs(touchCamInertia.velYaw) > 0.001 || Math.abs(touchCamInertia.velPitch) > 0.001) {
      cam.tYaw += touchCamInertia.velYaw * dt;
      cam.tPitch = THREE.MathUtils.clamp(cam.tPitch + touchCamInertia.velPitch * dt, CONFIG.cameraPitchMin, CONFIG.cameraPitchMax);
      const decay = Math.exp(-9.5 * dt);
      touchCamInertia.velYaw *= decay;
      touchCamInertia.velPitch *= decay;
      if (Math.hypot(touchCamInertia.velYaw, touchCamInertia.velPitch) < 0.015) {
        touchCamInertia.velYaw = 0;
        touchCamInertia.velPitch = 0;
      }
    }
  }

  const s = 1 - Math.exp(-CONFIG.cameraSmoothSpeed * dt);
  cam.yaw += (cam.tYaw - cam.yaw) * s;
  cam.pitch += (cam.tPitch - cam.pitch) * s;

  // Jangan menimpa jarak kamera (cam.dist / cam.tDist) saat animasi tidur sedang melakukan Zoom In / Zoom Out
  if (!sleepState.active) {
    const maxDistAllowed = state.isInsideHouse ? 4.8 : CONFIG.cameraMaxDist;
    cam.tDist = THREE.MathUtils.clamp(cam.tDist, CONFIG.cameraMinDist, maxDistAllowed);
    cam.dist += (cam.tDist - cam.dist) * s;
  }

  if (state.isInsideHouse) {
    updateInteriorWallAndCeilingVisibility();
  }

  const oX = Math.sin(cam.yaw) * Math.cos(cam.pitch) * cam.dist;
  const oY = Math.sin(cam.pitch) * cam.dist;
  const oZ = Math.cos(cam.yaw) * Math.cos(cam.pitch) * cam.dist;

  const pp = playerGroup.position;
  _v3a.set(pp.x + oX, pp.y + 1.3 + oY, pp.z + oZ);

  if (screenShakeTimer > 0) {
    screenShakeTimer -= dt;
    const shakeF = screenShakeTimer * screenShakeIntensity;
    _v3a.x += (Math.random() - 0.5) * shakeF;
    _v3a.y += (Math.random() - 0.5) * shakeF;
    _v3a.z += (Math.random() - 0.5) * shakeF;
  }

  if (_v3a.y < 0.4) _v3a.y = 0.4;

  if ((teleportState.active && teleportState.switchedAtPeak) || sleepState.active) {
    // Saat transisi tidur / berpindah tempat, posisikan kamera mengikuti cam.dist & FOV tanpa tertahan jeda lerp
    camera.position.copy(_v3a);
    sleepState.snapCameraNow = false;
  } else {
    camera.position.lerp(_v3a, Math.min(s * 1.35, 1));
  }
  const lookOffsetY = sleepState.lyingOnBed ? 0.35 : 1.2;
  _v3b.set(pp.x, pp.y + lookOffsetY, pp.z);
  camera.lookAt(_v3b);
}

