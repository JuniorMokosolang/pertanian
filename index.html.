  // dengan toleransi radius telapak sepatu (footPad) agar pijakan naik/turun tangga mulus dan sepatu tidak tenggelam di tepi papan kayu.
  const footPad = 0.14;
  const boxes = houseRefs.stepAndPorchBoxes;
  for (let i = 0; i < boxes.length; i++) {
    const b = boxes[i];
    if (
      x >= b.minX - footPad &&
      x <= b.maxX + footPad &&
      z >= b.minZ - footPad &&
      z <= b.maxZ + footPad
